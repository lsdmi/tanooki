<%# locals: slide:, frame_class: %>
<% frame_class = local_assigns.fetch(:frame_class, 'h-[19rem] max-w-lg') %>
<% art_melt = '[mask-image:linear-gradient(to_bottom,#000_55%,transparent)] [-webkit-mask-image:linear-gradient(to_bottom,#000_55%,transparent)]' %>
<div class="relative -mb-8 overflow-hidden <%= frame_class %> w-full bg-main">
  <div class="absolute inset-0 <%= art_melt %>" aria-hidden="true">
    <%= image_tag 'banner/banner_desktop_orv_1.webp',
                  alt: '',
                  aria: { hidden: true },
                  class: 'absolute inset-0 z-0 size-full object-cover object-center' %>
    <div class="absolute inset-0 z-[1] bg-black/22 dark:hidden"></div>
    <div class="absolute inset-0 z-[1] bg-linear-to-b from-main/72 via-main/84 to-main/96 dark:from-main/55 dark:via-main/75 dark:to-main/95"></div>
  </div>
  <%= render slide %>
  <div class="absolute inset-x-0 bottom-10 z-30 flex justify-center gap-2 md:bottom-14" aria-hidden="true">
    <span class="h-1 w-6 rounded-full bg-fg dark:bg-white"></span>
    <span class="h-1 w-1.5 rounded-full bg-fg/35 dark:bg-white/45"></span>
    <span class="h-1 w-1.5 rounded-full bg-fg/35 dark:bg-white/45"></span>
  </div>
</div>
