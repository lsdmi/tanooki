<%# locals: mobile_slide:, full_slide: %>
<div class="space-y-8">
  <div>
    <h2 class="mb-1 text-lg font-semibold text-gray-900">Mikai-style showcase overlay</h2>
    <p class="mb-6 max-w-3xl text-sm text-gray-600">
      Full page-color veil over the banner, centered type — readable because the art is washed with page color, not because the type is inked black.
    </p>
  </div>

  <div class="grid gap-8 lg:grid-cols-2">
    <section>
      <p class="mb-3 text-sm font-medium text-cyan-700">Mobile</p>
      <%= render 'fictions/showcase_slide_overlay_component_preview/slide_frame', slide: mobile_slide %>
    </section>

    <section>
      <p class="mb-3 text-sm font-medium text-gray-500">Desktop</p>
      <%= render 'fictions/showcase_slide_overlay_component_preview/slide_frame',
                 slide: full_slide,
                 frame_class: 'h-[24rem]' %>
    </section>
  </div>
</div>
