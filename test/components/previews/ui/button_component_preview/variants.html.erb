<% variants = Ui::ButtonComponent::VARIANTS %>
<% sizes = %i[sm md lg] %>
<% icon = capture do %>
  <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" />
  </svg>
<% end %>

<div class="space-y-10">
  <% [['Light', ''], ['Dark', 'dark']].each do |theme, theme_class| %>
    <section class="<%= theme_class %>">
      <div class="space-y-8 rounded-xl border border-line bg-main p-8">
        <p class="text-sm font-medium text-fg-muted"><%= theme %> · hover and focus with the mouse and Tab</p>

        <% sizes.each do |size| %>
          <div>
            <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-fg-secondary"><%= size %></h2>
            <div class="grid grid-cols-[6rem_repeat(3,max-content)] items-center gap-x-4 gap-y-3">
              <span></span>
              <% %w[default disabled loading].each do |state| %>
                <span class="text-xs text-fg-subtle"><%= state %></span>
              <% end %>
              <% variants.each do |variant| %>
                <span class="text-sm text-fg"><%= variant %></span>
                <%= render Ui::ButtonComponent.new(variant:, size:) do %><%= icon %>Кнопка<% end %>
                <%= render Ui::ButtonComponent.new(variant:, size:, disabled: true) do %><%= icon %>Кнопка<% end %>
                <%= render Ui::ButtonComponent.new(label: 'Кнопка', variant:, size:, loading: true) %>
              <% end %>
            </div>
          </div>
        <% end %>

        <div>
          <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-fg-secondary">Icon only</h2>
          <div class="space-y-3">
            <% variants.each do |variant| %>
              <div class="flex items-center gap-3">
                <span class="w-24 text-sm text-fg"><%= variant %></span>
                <% sizes.each do |size| %>
                  <%= render Ui::ButtonComponent.new(label: "#{variant} #{size}", variant:, size:, icon_only: true) do %><%= icon %><% end %>
                <% end %>
                <%= render Ui::ButtonComponent.new(label: 'loading', variant:, size: :md, icon_only: true, loading: true) do %><%= icon %><% end %>
              </div>
            <% end %>
          </div>
        </div>

        <div>
          <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-fg-secondary">Legacy sizes, link, full width</h2>
          <div class="flex flex-wrap items-center gap-3">
            <%= render Ui::ButtonComponent.new(label: 'xs', size: :xs) %>
            <%= render Ui::ButtonComponent.new(label: 'responsive', size: :responsive) %>
            <%= render Ui::ButtonComponent.new(label: 'responsive_banner', size: :responsive_banner) %>
            <%= render Ui::ButtonComponent.new(label: 'Посилання', as: :link, href: '#') %>
            <%= render Ui::ButtonComponent.new(label: 'Вимкнене посилання', as: :link, href: '#', variant: :outline, disabled: true) %>
            <%= render Ui::ButtonComponent.new(label: 'Чат', size: :fab) do %><%= icon %><% end %>
          </div>
          <div class="mt-3 max-w-xs">
            <%= render Ui::ButtonComponent.new(label: 'На всю ширину', full_width: true) %>
          </div>
        </div>
      </div>
    </section>
  <% end %>
</div>
