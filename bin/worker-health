#!/usr/bin/env ruby
# frozen_string_literal: true

# Solid Queue worker numbers for the monthly health check: memory and restarts of tanooki2 from the DigitalOcean
# monitoring API, then runs, failures, run time and queue wait per job class from job_stats (Analytics::JobStats).
#
#   bin/worker-health        # last 30 days
#   bin/worker-health 7      # last 7 days
#
# Reads the API token from the doctl config (or DIGITALOCEAN_ACCESS_TOKEN) and never prints it. The job numbers come
# through bin/prod-db, so they need its .env.production.local.

require 'json'
require 'net/http'
require 'uri'
require 'yaml'

APP_ID = '81cc743f-5405-4a05-99e5-84dd8aa694b1'
COMPONENT = 'tanooki2'
DOCTL_CONFIGS = [
  '~/Library/Application Support/doctl/config.yaml',
  '~/.config/doctl/config.yaml'
].freeze

def token
  ENV['DIGITALOCEAN_ACCESS_TOKEN'] || begin
    path = DOCTL_CONFIGS.map { |config| File.expand_path(config) }.find { |config| File.exist?(config) }
    abort 'No DigitalOcean token: sign in with doctl or set DIGITALOCEAN_ACCESS_TOKEN.' unless path
    YAML.safe_load_file(path)['access-token']
  end
end

def fetch_metric(name, start_time, end_time)
  uri = URI("https://api.digitalocean.com/v2/monitoring/metrics/apps/#{name}")
  uri.query = URI.encode_www_form(app_id: APP_ID, app_component: COMPONENT, start: start_time, end: end_time)
  response = Net::HTTP.get_response(uri, 'Authorization' => "Bearer #{token}")
  abort "#{name}: HTTP #{response.code}" unless response.is_a?(Net::HTTPSuccess)

  JSON.parse(response.body).dig('data', 'result')
end

# Every sample of every instance (a deploy starts a new one), grouped by UTC day.
def daily(name, days)
  end_time = Time.now.to_i
  samples = fetch_metric(name, end_time - (days * 86_400), end_time).flat_map { |series| series['values'] }
  samples.group_by { |time, _| Time.at(time).utc.strftime('%Y-%m-%d') }
         .transform_values { |day| day.map { |_, value| value.to_f } }
end

def day_row(day, memory, restarts)
  [day, memory.max.round(1), (memory.sum / memory.size).round(1), restarts.count(&:positive?)].join("\t")
end

# restart_count is a rate (about 1.3 per restart); deploys do not count. A nonzero sample is about one restart.
def print_memory_and_restarts(days)
  memory = daily('memory_percentage', days)
  restarts = daily('restart_count', days)

  puts "#{COMPONENT} memory % and restarts per day (UTC)"
  puts %w[day max avg restarts].join("\t")
  memory.sort.each { |day, values| puts day_row(day, values, restarts.fetch(day, [])) }
end

JOBS_SQL = [
  'SELECT job_class, SUM(jobs) AS jobs, SUM(failures) AS failures,',
  'ROUND(SUM(jobs) / %<hours>d, 1) AS per_hour, MAX(jobs) AS peak_hour,',
  'ROUND(SUM(duration_ms_sum) / SUM(jobs) / 1000, 1) AS avg_s, ROUND(MAX(duration_ms_max) / 1000, 1) AS max_s,',
  'ROUND(SUM(wait_ms_sum) / SUM(jobs) / 1000, 1) AS avg_wait_s, ROUND(MAX(wait_ms_max) / 1000, 1) AS max_wait_s',
  'FROM job_stats WHERE period_start >= UTC_TIMESTAMP() - INTERVAL %<days>d DAY',
  'GROUP BY job_class ORDER BY jobs DESC'
].join(' ')

def print_jobs(days)
  puts "\nJobs per class, last #{days} days (job_stats)"
  sql = format(JOBS_SQL, days:, hours: days * 24)
  system(File.expand_path('prod-db', __dir__), '--batch', '-e', sql) || abort('bin/prod-db failed')
end

days = Integer(ARGV.fetch(0, 30))
print_memory_and_restarts(days)
print_jobs(days)
