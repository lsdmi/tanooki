<% if table_row? %>
  <tr class="hover:bg-brand-subtle transition-colors duration-200">
    <th scope="row" class="whitespace-nowrap p-4 text-sm font-medium text-fg">
      <div class="flex items-center space-x-3">
        <div class="<%= Readings::ChapterRowComponentStyles::ICON_WRAPPER_CLASSES %>">
          <svg class="<%= Readings::ChapterRowComponentStyles::ICON_CLASSES %>" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div>
          <%= render 'readings/chapter_row_component/caption', chapter:, published_at_label: do %>
            <%= link_to_if title_url, chapter.display_title, title_url, title_link_html(TABLE_TITLE_CLASSES) %>
          <% end %>
        </div>
      </div>
    </th>
    <td class="p-4 text-sm text-fg-muted">
      <%= render 'shared/stat_pill_group' do %>
        <%= render 'shared/stat_chip', value: chapter.views, label: 'переглядів' do %>
          <svg class="<%= Readings::ChapterRowComponentStyles::STAT_ICON_CLASSES %>" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M2.25 12s3.75-7.5 9.75-7.5 9.75 7.5 9.75 7.5-3.75 7.5-9.75 7.5S2.25 12 2.25 12z" />
            <circle cx="12" cy="12" r="3" stroke-width="1.75" />
          </svg>
        <% end %>
        <%= render 'shared/stat_chip', value: chapter.comments_count, label: 'коментарів' do %>
          <svg class="<%= Readings::ChapterRowComponentStyles::STAT_ICON_CLASSES %>" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.2-3.8 7.5-8.5 7.5a9.3 9.3 0 01-4-.9L3 20l1.2-3.3A7.6 7.6 0 013 12c0-4.2 3.8-7.5 9-7.5s9 3.3 9 7.5z" />
          </svg>
        <% end %>
        <%= render 'shared/stat_chip', value: chapter.thanks_count, label: t('chapters.thanks.studio_label') do %>
          <%= stroke_icon(:heart, "#{Readings::ChapterRowComponentStyles::STAT_ICON_CLASSES} fill-current opacity-70") %>
        <% end %>
        <% if open_report_count? %>
          <%= render 'shared/stat_chip',
                     value: open_report_count,
                     label: open_report_label,
                     tone: :warning do %>
            <svg class="<%= Readings::ChapterRowComponentStyles::STAT_ICON_CLASSES %>" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 9v3.5m0 3.25h.01M10.3 4.2 2.7 17.1c-.7 1.2.2 2.7 1.6 2.7h15.4c1.4 0 2.3-1.5 1.6-2.7L13.7 4.2c-.7-1.2-2.5-1.2-3.4 0z" />
            </svg>
          <% end %>
        <% end %>
      <% end %>
    </td>
    <td class="p-4 text-right">
      <%= render_actions %>
    </td>
  </tr>
<% else %>
  <div class="bg-card rounded-lg border border-line p-4 shadow-sm hover:shadow-md transition-shadow duration-200">
    <div class="mb-3 min-w-0">
      <%= render 'readings/chapter_row_component/caption', chapter:, published_at_label: do %>
        <%= link_to_if title_url, chapter.display_title, title_url, title_link_html(CARD_TITLE_CLASSES) %>
      <% end %>
    </div>
    <div class="mb-3">
      <%= render 'shared/stat_pill_group' do %>
        <%= render 'shared/stat_chip', value: chapter.views, label: 'переглядів' do %>
          <svg class="<%= Readings::ChapterRowComponentStyles::STAT_ICON_CLASSES %>" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M2.25 12s3.75-7.5 9.75-7.5 9.75 7.5 9.75 7.5-3.75 7.5-9.75 7.5S2.25 12 2.25 12z" />
            <circle cx="12" cy="12" r="3" stroke-width="1.75" />
          </svg>
        <% end %>
        <%= render 'shared/stat_chip', value: chapter.comments_count, label: 'коментарів' do %>
          <svg class="<%= Readings::ChapterRowComponentStyles::STAT_ICON_CLASSES %>" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.2-3.8 7.5-8.5 7.5a9.3 9.3 0 01-4-.9L3 20l1.2-3.3A7.6 7.6 0 013 12c0-4.2 3.8-7.5 9-7.5s9 3.3 9 7.5z" />
          </svg>
        <% end %>
        <%= render 'shared/stat_chip', value: chapter.thanks_count, label: t('chapters.thanks.studio_label') do %>
          <%= stroke_icon(:heart, "#{Readings::ChapterRowComponentStyles::STAT_ICON_CLASSES} fill-current opacity-70") %>
        <% end %>
        <% if open_report_count? %>
          <%= render 'shared/stat_chip',
                     value: open_report_count,
                     label: open_report_label,
                     tone: :warning do %>
            <svg class="<%= Readings::ChapterRowComponentStyles::STAT_ICON_CLASSES %>" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 9v3.5m0 3.25h.01M10.3 4.2 2.7 17.1c-.7 1.2.2 2.7 1.6 2.7h15.4c1.4 0 2.3-1.5 1.6-2.7L13.7 4.2c-.7-1.2-2.5-1.2-3.4 0z" />
            </svg>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <div class="flex items-center justify-end pt-3 border-t border-line">
      <%= render_actions %>
    </div>
  </div>
<% end %>
