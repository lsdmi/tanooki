<div class="flex flex-col gap-3">
  <% if battle.legacy? %>
    <%= tag.p 'Раунди цього бою не збереглися', class: 'text-xs/4 text-fg-subtle', **rounds_attributes %>
  <% else %>
    <%= tag.ol class: 'grid grid-cols-1 gap-2 sm:grid-cols-2', **rounds_attributes do %>
      <% rounds.each do |round| %>
        <li class="flex flex-col gap-2 rounded-lg bg-surface p-3 ring-1 ring-inset ring-line">
          <span class="text-xs/4 font-medium text-fg-muted">Раунд <%= round.number %></span>
          <div class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-2">
            <%= fighter(round.attacker, fainted: !round.victory) %>
            <span class="text-xs/4 text-fg-subtle" aria-hidden="true">vs</span>
            <%= fighter(round.defender, fainted: round.victory, align: :end) %>
          </div>
        </li>
      <% end %>
    <% end %>
  <% end %>

  <div class="flex flex-col gap-1 rounded-lg bg-surface p-4 ring-1 ring-inset ring-line">
    <h3 class="text-sm/5 font-semibold text-fg">Бій завершено!</h3>
    <p class="text-sm/5 text-fg-secondary">
      Останній покемон
      <span class="font-semibold text-status-danger-solid"><%= loser_name %></span>
      вибуває з гри —
      <span class="font-semibold text-status-success-solid"><%= winner_name %></span>
      здобуває перемогу у цьому поєдинку!
    </p>
  </div>
</div>
