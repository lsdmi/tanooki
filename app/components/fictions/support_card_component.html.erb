<section class="flex flex-col gap-4 rounded-xl bg-main p-4 ring-1 ring-inset ring-line" aria-labelledby="<%= heading_id %>">
  <div class="flex items-center gap-4">
    <%= image_tag 'mascot.svg', alt: t('chapters.reader_support_card.mascot_alt'), loading: 'lazy',
                                class: 'size-21 shrink-0 select-none rounded-full border border-line dark:hidden' %>
    <%= image_tag 'mascot-dark.svg', alt: '', loading: 'lazy', aria: { hidden: true },
                                     class: 'hidden size-21 shrink-0 select-none rounded-full border border-line dark:block' %>
    <div class="flex min-w-0 flex-col gap-2">
      <h2 id="<%= heading_id %>" class="text-base/6 font-semibold text-fg"><%= t('chapters.reader_support_card.title') %></h2>
      <p class="text-xs/5 text-fg-muted"><%= t('chapters.reader_support_card.description') %></p>
    </div>
  </div>
  <%= render Ui::ButtonComponent.new(variant: :outline, size: :sm, as: :link, href:, full_width: true,
                                     html: { target: '_blank', rel: 'noopener noreferrer' }) do %>
    <svg class="size-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
    </svg>
    <%= t('chapters.reader_support_card.support') %>
  <% end %>
</section>
