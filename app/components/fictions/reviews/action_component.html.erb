<% case state %>
<% when :unmark %>
  <%= link_to review_path, data: { turbo_method: :delete, turbo_stream: '' }, class: link_class do %>
    <%= t('fictions.reviews.unmark') %>
  <% end %>
<% when :mark %>
  <%= link_to review_path, data: { turbo_method: :post, turbo_stream: '' }, class: link_class do %>
    <%= t('fictions.reviews.mark') %>
  <% end %>
<% when :too_short %>
  <p class="<%= hint_class %>"><%= t('fictions.reviews.cta_too_short', count: FictionReview::MIN_LENGTH) %></p>
<% when :rate_first %>
  <p class="<%= hint_class %>"><%= t('fictions.reviews.cta_rate_first') %></p>
<% when :already_reviewed %>
  <div class="flex flex-col gap-0.5">
    <button type="button" disabled class="<%= link_class %> cursor-not-allowed opacity-50">
      <%= t('fictions.reviews.mark') %>
    </button>
    <p class="<%= hint_class %>"><%= t('fictions.reviews.cta_already_reviewed') %></p>
  </div>
<% end %>
