<div class="<%= wrapper_classes %>">
  <div class="<%= stack_classes %>">
    <% if editorial_kinds.any? %>
      <%= render Ui::EditorialTagListComponent.new(
            kinds: editorial_kinds,
            variant: :outline,
            html: { class: tag_list_classes }
          ) %>
    <% end %>

    <%= tag.h2 class: title_classes do %>
      <%= link_to fiction.title, fiction_href, class: title_link_classes %>
    <% end %>

    <% unless mobile_minimal? %>
      <% if showcase_blurb.present? %>
        <p class="<%= description_classes %>"><%= showcase_blurb %></p>
      <% end %>

      <div class="<%= metadata_classes %>">
        <span class="<%= meta_rating_classes %>" title="Середня оцінка">
          <svg class="<%= meta_icon_classes %>" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          <%= rating_label %>
        </span>
        <span class="<%= meta_muted_classes %>" title="Перегляди">
          <svg class="<%= meta_icon_classes %>" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" d="M21 12c0 1.2-4.03 6-9 6s-9-4.8-9-6c0-1.2 4.03-6 9-6s9 4.8 9 6Z" />
            <path stroke-linecap="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          </svg>
          <%= format_view_count(fiction.views) %>
        </span>
        <span class="<%= meta_muted_classes %>" title="Автор">
          <svg class="<%= meta_icon_classes %>" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span class="max-w-[12rem] truncate sm:max-w-[16rem]"><%= fiction.author %></span>
        </span>
      </div>

      <%= link_to read_href,
                  class: read_link_classes,
                  **turbo_drive_visit_data(preload: eager_link_preload) do %>
        Читати
        <span aria-hidden="true">→</span>
      <% end %>
    <% end %>
  </div>
</div>
