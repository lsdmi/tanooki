<%= tag.div(id: DOM_ID, class: 'flex flex-col gap-5 md:gap-4') do %>
  <div class="flex flex-col gap-3 md:flex-row md:flex-wrap md:items-center md:pt-2">
    <% if cta? %>
      <%= tag.div(class: 'contents', **guest_continue_attributes) do %>
        <%= render Ui::ButtonComponent.new(label: cta_label, as: :link, href: cta_href, html: cta_html) do %>
          <%= stroke_icon(:book_open) %>
          <%= tag.span cta_label, data: ({ guest_continue_target: 'label' } if guest?) %>
        <% end %>
      <% end %>
    <% end %>

    <% if guest? %>
      <%= render Ui::ButtonComponent.new(label: t('fictions.hero.library.add'), variant: :on_media, as: :link,
                                         href: login_path, html: { class: 'w-full md:w-auto' }) do %>
        <%= stroke_icon(:bookmark) %>
        <span><%= t('fictions.hero.library.add') %></span>
      <% end %>
    <% else %>
      <%= render Ui::BottomSheetComponent.new(title: shelf_sheet_title, id: "#{DOM_ID}-shelves",
                                              html: { class: 'w-full md:w-auto' }) do |sheet| %>
        <% sheet.with_trigger do %>
          <%= render Ui::ButtonComponent.new(label: shelf_label, variant: :on_media, full_width: true) do %>
            <%= stroke_icon(:bookmark) %>
            <span><%= shelf_label %></span>
            <%= stroke_icon(:chevron_down) %>
          <% end %>
        <% end %>
        <% status_filters.each do |label, status| %>
          <%= form_with url: status_path, method: :patch, class: 'contents' do %>
            <%= hidden_field_tag :status, status, id: nil %>
            <%= render Ui::MenuItemComponent.new(label:, as: :submit, tone: status == shelf_status ? :selected : :default) %>
          <% end %>
        <% end %>
        <% if shelf_status %>
          <div class="my-1 h-px bg-line" role="separator"></div>
          <%= form_with url: status_path, method: :patch, class: 'contents' do %>
            <%= hidden_field_tag :status, Reading::UpdateStatus::DESTROY_STATUS, id: nil %>
            <%= render Ui::MenuItemComponent.new(label: t('fictions.hero.library.remove'), as: :submit, tone: :destructive) do |item| %>
              <% item.with_icon { stroke_icon(:trash) } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <% if (line = progress_line) %>
    <p class="token-raw text-xs/5 text-slate-400"><%= line %></p>
  <% end %>
<% end %>
