<% body = capture do %>
  <% if loading %>
    <svg class="<%= SPINNER_CLASSES %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M21 12a9 9 0 1 1-6.219-8.56" />
    </svg>
  <% end %>
  <% if show_content? %><%= content %><% elsif !icon_only %><%= label %><% end %>
<% end %>
<% if link? %>
  <%= link_to body, href, element_attributes %>
<% else %>
  <%= button_tag body, type: button_type, **element_attributes %>
<% end %>
