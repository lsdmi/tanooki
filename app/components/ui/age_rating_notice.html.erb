<section
  role="alert"
  aria-label="<%= t_notice('aria_label') %>"
  data-controller="age-rating-notice"
  data-age-rating-notice-rating-value="<%= rating %>"
  class="<%= root_classes %>">
  <% if eighteen? %>
    <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-2xl" aria-hidden="true">
      <svg class="adult-content-disclaimer__circle adult-content-disclaimer__circle--left absolute -bottom-[3.25rem] -left-[2.75rem] h-[9.5rem] w-[9.5rem] sm:-bottom-[3.75rem] sm:-left-[3rem] sm:h-44 sm:w-44" viewBox="0 0 160 160" xmlns="http://www.w3.org/2000/svg">
        <circle cx="80" cy="80" r="80" class="adult-content-disclaimer__circle-fill" />
      </svg>
      <svg class="adult-content-disclaimer__circle adult-content-disclaimer__circle--right absolute -top-[2.75rem] -right-[2.25rem] h-[8.5rem] w-[8.5rem] sm:-top-[3.25rem] sm:-right-[2.5rem] sm:h-40 sm:w-40" viewBox="0 0 140 140" xmlns="http://www.w3.org/2000/svg">
        <circle cx="70" cy="70" r="70" class="adult-content-disclaimer__circle-fill" />
      </svg>
    </div>
  <% end %>

  <div class="relative z-[1] flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
    <div class="flex min-w-0 flex-1 items-center gap-3 sm:gap-4">
      <div class="<%= icon_wrap_classes %>" aria-hidden="true">
        <svg class="<%= icon_classes %>" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <div class="min-w-0">
        <p class="text-[15px] font-bold leading-snug sm:text-base">
          <%= t_notice(title_key) %>
        </p>
        <p class="<%= description_classes %>">
          <%= t_notice('description') %>
        </p>
      </div>
    </div>

    <button
      type="button"
      data-action="age-rating-notice#dismiss"
      class="<%= dismiss_classes %>">
      <%= t_notice('dismiss') %>
    </button>
  </div>
</section>
