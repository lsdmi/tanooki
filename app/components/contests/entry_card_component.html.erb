<article class="group min-w-0">
  <%= link_to href,
        class: 'group/cover relative block aspect-[2/3] overflow-hidden rounded-md bg-surface-strong transition-[filter,transform] duration-200 ease-out hover:brightness-[1.03] focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-brand',
        data: { turbo_frame: '_top' } do %>
    <% if fiction.cover.attached? %>
      <%= cover_card_picture_tag(
            fiction.cover,
            alt: blur? ? '' : fiction.title,
            class: cover_class,
            picture_html: { class: 'absolute inset-0 block h-full w-full' },
            srcset: true,
            sizes: Meta::CoverCardPresets::CARD_GRID_SIZES,
            loading: 'lazy',
            decoding: 'async'
          ) %>
    <% end %>
    <% if age_label %>
      <span class="pointer-events-none absolute left-1.5 top-1.5 z-10 flex h-6 min-w-[1.5rem] items-center justify-center rounded-md px-1.5 text-xs font-bold shadow-sm backdrop-blur-[2px] <%= age_class %>"
            aria-label="<%= age_label %>"><%= age_label %></span>
    <% end %>
    <% unless plain? %>
      <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 flex items-end justify-between gap-1.5 bg-gradient-to-t from-black/80 via-black/40 to-transparent px-2 pb-2 pt-10">
        <%= render Ui::GenrePageTagComponent.new(variant: :stat_views, label: helpers.format_view_count(fiction.views)) %>
        <%= render Ui::GenrePageTagComponent.new(variant: :stat_rating, label: rating_text) %>
      </div>
    <% end %>
  <% end %>
  <div class="pt-1 sm:pt-1.5 md:pt-2 xl:pt-2">
    <h3 class="font-semibold leading-tight text-fg text-[10px] sm:text-[11px] md:text-xs lg:text-xs xl:text-sm 2xl:text-sm">
      <%= link_to fiction.title, href,
            class: 'line-clamp-2 rounded-md transition-colors hover:text-fg-brand hover:underline underline-offset-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand',
            data: { turbo_frame: '_top' } %>
    </h3>
    <% if entry.display_author.present? %>
      <p class="mt-0.5 truncate leading-snug text-fg-muted text-[9px] sm:mt-1 sm:text-[10px] md:text-[11px] lg:text-[11px] xl:text-xs 2xl:text-xs"><%= entry.display_author %></p>
    <% end %>
    <% if !plain? && genre_labels.any? %>
      <%= render Ui::TagListComponent.new(
            labels: genre_labels,
            variant: :genre,
            size: :sm,
            sort_adult_first: true,
            genre_slugs: genre_slugs,
            href_builder: ->(name) { genre_href(name) },
            tag_html: { data: { turbo_frame: '_top' } },
            html: { class: 'mt-1.5 gap-1 min-w-0' }
          ) %>
    <% end %>
  </div>
</article>
