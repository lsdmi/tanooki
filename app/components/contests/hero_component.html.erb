<section id="hero" class="relative overflow-hidden border-b border-line bg-surface">
  <div class="mx-auto grid max-w-screen-xl gap-8 px-4 py-10 md:grid-cols-12 md:gap-10 md:py-14 2xl:px-0">
    <div class="flex min-w-0 flex-col justify-center md:col-span-7">
      <p class="text-sm text-fg-muted"><%= phase_label %></p>
      <h1 class="mt-2 min-w-0 break-words text-3xl font-bold tracking-tight text-fg md:text-5xl md:leading-tight">
        <%= contest.title %>
      </h1>
      <% if contest.tagline.present? %>
        <p class="mt-3 max-w-xl text-base text-fg-secondary md:text-lg"><%= contest.tagline %></p>
      <% end %>
      <% if deadline_line.present? %>
        <p class="mt-4 text-sm font-medium text-fg-brand" data-controller="<%= 'contests--deadline' if presenter.phase == :submissions %>"
           <% if presenter.phase == :submissions %>
             data-contests--deadline-ends-at-value="<%= contest.submissions_close_at.iso8601 %>"
           <% end %>>
          <span data-contests--deadline-target="label"><%= deadline_line %></span>
        </p>
      <% end %>
      <div class="mt-6 flex flex-wrap gap-3">
        <% if primary %>
          <%= render Ui::ButtonComponent.new(label: action_label(primary), href: primary[:href], variant: :primary, size: :lg, as: :link) %>
        <% end %>
        <% if secondary %>
          <%= render Ui::ButtonComponent.new(label: action_label(secondary), href: secondary[:href], variant: :outline, size: :lg, as: :link) %>
        <% end %>
      </div>
    </div>
    <div class="md:col-span-5">
      <div class="contests-hero-cover aspect-[4/5] min-w-0 overflow-hidden rounded-xl bg-surface-strong ring-1 ring-line">
        <% if cover? %>
          <%= cover_card_picture_tag(contest.cover, class: 'size-full object-cover', alt: '', loading: 'eager') %>
        <% else %>
          <div class="flex size-full items-end bg-brand-subtle p-6">
            <p class="break-words text-2xl font-bold text-fg-brand"><%= contest.title %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
