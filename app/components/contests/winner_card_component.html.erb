<% if plain? %>
  <%= link_to href, class: 'group flex items-center gap-3 border-b border-line py-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand' do %>
    <div class="relative size-12 shrink-0 overflow-hidden rounded-md bg-surface-strong">
      <% if fiction&.cover&.attached? %>
        <%= cover_card_picture_tag(fiction.cover, class: 'size-full object-cover', alt: '') %>
      <% end %>
    </div>
    <div class="min-w-0">
      <p class="truncate text-sm font-medium text-fg group-hover:text-fg-brand"><%= title %></p>
      <p class="mt-0.5 truncate text-xs text-fg-muted"><%= [prize.title, author.presence].compact.join(' · ') %></p>
    </div>
  <% end %>
<% else %>
<%= link_to href, class: 'group flex gap-3 overflow-hidden rounded-xl bg-main p-3 ring-1 ring-line focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand' do %>
  <div class="relative h-24 w-16 shrink-0 overflow-hidden rounded-lg bg-surface-strong">
    <% if fiction&.cover&.attached? %>
      <%= cover_card_picture_tag(fiction.cover, class: 'size-full object-cover transition-transform duration-[220ms] ease-in-out motion-reduce:transition-none [@media(hover:hover)_and_(pointer:fine)]:group-hover:scale-[1.02]', alt: '') %>

    <% else %>
      <div class="size-full bg-brand-subtle"></div>
    <% end %>
  </div>
  <div class="min-w-0 flex-1">
    <p class="text-xs font-semibold text-fg-brand"><%= prize.title %></p>
    <p class="mt-1 line-clamp-2 text-sm font-semibold text-fg group-hover:text-fg-brand"><%= title %></p>
    <% if author.present? %>
      <p class="mt-0.5 text-xs text-fg-muted"><%= author %></p>
    <% end %>
    <p class="mt-2 text-xs text-fg-subtle"><%= contest.title %></p>
  </div>
<% end %>
<% end %>
