<%= link_to contest_path(contest), class: 'group flex gap-4 overflow-hidden rounded-xl bg-main p-3 ring-1 ring-line focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:p-4' do %>

  <div class="h-28 w-20 shrink-0 overflow-hidden rounded-lg bg-surface-strong">
    <% if contest.cover.attached? %>
      <%= cover_card_picture_tag(contest.cover, class: 'size-full object-cover', alt: '') %>
    <% else %>
      <div class="flex size-full items-end bg-brand-subtle p-2">
        <span class="line-clamp-3 text-xs font-bold text-fg-brand"><%= contest.title %></span>
      </div>
    <% end %>
  </div>
  <div class="min-w-0 flex-1">
    <p class="text-base font-semibold text-fg group-hover:text-fg-brand"><%= contest.title %></p>
    <p class="mt-1 text-sm text-fg-muted"><%= kind_label %> · <%= date_range %></p>
    <p class="mt-2 text-sm text-fg-subtle">
      <%= t('contests.hub.archive_entries', count: entry_count) %>
    </p>
    <% if top_covers.any? %>
      <ul class="mt-3 flex -space-x-2">
        <% top_covers.first(3).each do |cover| %>
          <li class="size-8 overflow-hidden rounded-md ring-2 ring-main">
            <% if cover %>
              <%= cover_card_picture_tag(cover, class: 'size-full object-cover', alt: '') %>
            <% else %>
              <span class="block size-full bg-surface-strong"></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
<% end %>
