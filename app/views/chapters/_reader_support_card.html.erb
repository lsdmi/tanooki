<%# locals: fiction: %>
<% support_button_markup = capture do %>
  <%= reader_outlined_button(href: fiction_reader_support_url(fiction), target: '_blank', rel: 'noopener noreferrer') do %>
    <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
    </svg>
    <span class="truncate"><%= fiction_reader_support_label(fiction) %></span>
  <% end %>
<% end %>

<section class="reader-bottom-card reader-support-card grid h-full w-full min-w-0 grid-cols-[auto_1fr] items-stretch gap-x-2.5 rounded-lg border border-line/90 bg-main/95 p-3 shadow-sm sm:gap-x-3 sm:rounded-xl sm:p-4 md:p-5 lg:flex lg:gap-4"
         aria-labelledby="reader-support-card-title">
  <div class="reader-bottom-card__visual reader-support-card__visual col-start-1 row-start-1 w-12 shrink-0 overflow-hidden sm:w-15 md:w-[4.5rem] lg:w-[5.25rem]">
    <%= image_tag 'mascot.svg',
                  alt: t('chapters.reader_support_card.mascot_alt'),
                  class: 'reader-support-card__mascot h-full w-full object-contain object-left dark:hidden',
                  loading: 'lazy' %>
    <%= image_tag 'mascot-dark.svg',
                  alt: '',
                  aria: { hidden: true },
                  class: 'reader-support-card__mascot hidden h-full w-full object-contain object-left dark:block',
                  loading: 'lazy' %>
  </div>

  <div class="reader-bottom-card__body col-start-2 row-start-1 flex min-h-0 min-w-0 flex-col lg:flex-1">
    <h2 id="reader-support-card-title" class="text-base font-bold leading-snug text-fg sm:text-lg md:text-xl">
      <%= t('chapters.reader_support_card.title') %>
    </h2>
    <p class="mt-1 text-xs leading-relaxed text-fg-secondary sm:text-sm">
      <%= t('chapters.reader_support_card.description') %>
    </p>

    <div class="reader-bottom-card__action reader-bottom-card__action--inline mt-auto hidden pt-3 sm:pt-4 lg:block">
      <%= support_button_markup %>
    </div>
  </div>

  <div class="reader-bottom-card__action reader-bottom-card__action--full col-span-2 row-start-2 pt-3 sm:pt-4 lg:hidden">
    <%= support_button_markup %>
  </div>
</section>
