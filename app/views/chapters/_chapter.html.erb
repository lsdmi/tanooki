<section class="w-full rounded-lg bg-page/95 ring-1 ring-line/80 shadow-sm dark:shadow-none p-3 sm:p-6 lg:p-8 transition-shadow duration-300 hover:shadow-md dark:hover:shadow-none relative overflow-hidden">
  <%= render "chapter_navigation", previous_chapter: previous_chapter, next_chapter: next_chapter, placement: :top %>
  <%= render "shared/adsense_chapter_reader_slot", placement: :top, navigation_key: chapter.id %>
  <div class="absolute top-0 left-0 w-full h-2 bg-brand"></div>

  <% reader_content = reader_chapter_content(chapter) %>
  <div id="user-content" class="prose dark:prose-invert max-w-none min-w-0 break-words text-base sm:text-lg leading-relaxed text-fg" data-controller="note-reference" data-action="click->note-reference#toggle" data-rp-digest="<%= reader_content.digest %>">
    <%= reader_content.render %>
  </div>

  <%= render "shared/adsense_chapter_reader_slot", placement: :bottom, navigation_key: chapter.id %>
  <%= render "chapter_navigation", previous_chapter: previous_chapter, next_chapter: next_chapter, placement: :bottom %>
  <%= render "reader_bottom_section", chapter: chapter, fiction: chapter.fiction %>
</section>
