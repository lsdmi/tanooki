<section class="bg-gray-50 dark:bg-gray-900 z-10 relative min-h-screen">
  <div class="py-8 px-4 sm:px-6 md:px-12 lg:px-24 mx-auto lg:py-12" data-controller="dropzone">
    <%= render 'chapters/composer_header',
               title: 'Додати Розділ',
               subtitle: 'Додайте новий розділ до вашого твору - заголовок, номер та текст історії!',
               chapter: @chapter %>

    <!-- Form Container -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg p-2 sm:p-8">
      <%= simple_form_for @chapter, as: :chapter, url: chapters_path, method: :post, html: { class: "form", multipart: true } do |f| %>
        <%= render 'form', chapter: @chapter, f: f %>
      <% end %>
    </div>
  </div>
</section>
