<%# locals: chapter: %>
<%# Hidden until `reading-progress` reports this chapter newly completed. Fixed, like the resume banner. %>
<section class="fixed bottom-18 left-4 right-4 z-40 mx-auto rounded-xl border border-line/90 bg-main/95 p-4 shadow-lg shadow-stone-900/10 backdrop-blur-sm dark:shadow-black/40 sm:bottom-6 sm:left-1/2 sm:right-auto sm:w-max sm:max-w-lg sm:-translate-x-1/2"
         data-controller="reader-finish-prompt"
         data-reader-finish-prompt-chapter-url-value="<%= record_progress_chapter_path(chapter) %>"
         data-reader-finish-prompt-done-text-value="<%= t('reading_progress.finish_prompt.done') %>"
         data-action="reading-progress:completed@window->reader-finish-prompt#show"
         aria-live="polite"
         hidden>
  <p class="text-sm font-medium text-fg" data-reader-finish-prompt-target="text">
    <%= t('reading_progress.finish_prompt.text') %>
  </p>
  <%# Two equal columns whatever the label lengths. %>
  <div class="mt-4 grid grid-cols-2 gap-3" data-reader-finish-prompt-target="actions">
    <%= form_with url: update_status_fiction_reading_progress_path(chapter.fiction),
                  method: :patch,
                  class: 'flex',
                  data: { action: 'turbo:submit-end->reader-finish-prompt#finished' } do %>
      <%= hidden_field_tag :status, 'finished', id: nil %>
      <%= ui_button(as: :submit, size: :md, html: { class: 'w-full whitespace-nowrap max-sm:px-3' }) do %>
        <%= t('reading_progress.finish_prompt.confirm') %>
      <% end %>
    <% end %>
    <%= ui_button(variant: :ghost, size: :md, html: { class: 'w-full whitespace-nowrap max-sm:px-3', data: { action: 'reader-finish-prompt#hide' } }) do %>
      <%= t('reading_progress.finish_prompt.dismiss') %>
    <% end %>
  </div>
</section>
