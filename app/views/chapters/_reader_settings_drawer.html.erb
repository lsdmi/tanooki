<%# locals: chapter: %>
<div data-reader-settings-target="backdrop"
     class="fixed inset-0 z-[51] bg-black/50 opacity-0 pointer-events-none transition-opacity duration-200 ease-out"
     data-action="click->reader-settings#close"
     aria-hidden="true"></div>

<aside id="reader-settings-panel"
       data-reader-settings-target="panel"
       class="reader-settings__panel fixed inset-0 z-[52] flex h-dvh max-h-dvh w-full translate-x-full flex-col overflow-hidden bg-main transition-transform duration-200 ease-out sm:inset-y-0 sm:left-auto sm:right-0 sm:max-w-sm sm:border-l sm:border-line sm:shadow-xl sm:shadow-stone-900/10 dark:sm:shadow-black/40"
       role="dialog"
       aria-modal="true"
       aria-labelledby="reader-settings-title">
  <div class="flex shrink-0 items-start justify-between gap-3 border-b border-line px-4 py-4 sm:px-5">
    <div class="min-w-0 pr-2">
      <h2 id="reader-settings-title" class="text-base font-semibold text-fg">
        <%= t('chapters.reader_settings.title') %>
      </h2>
      <p class="mt-0.5 text-sm text-fg-muted">
        <%= t('chapters.reader_settings.subtitle') %>
      </p>
    </div>
    <button type="button"
            class="shrink-0 rounded-md p-1.5 text-fg-muted transition-colors hover:bg-surface hover:text-fg focus:outline-none focus-visible:ring-2 focus-visible:ring-line-strong"
            data-action="click->reader-settings#close"
            aria-label="<%= t('chapters.reader_settings.close') %>">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-4 py-4 sm:px-5 sm:py-5">
    <section class="border-b border-line pb-5">
      <div class="mb-3 flex items-center gap-2 text-sm font-medium text-fg">
        <svg class="h-4 w-4 shrink-0 text-fg-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
        <%= t('chapters.reader_settings.font') %>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <% reader_font_choices.each do |font| %>
          <button type="button"
                  class="reader-settings__font rounded-lg border border-line-strong bg-main px-3 py-2 text-left text-sm font-medium text-fg transition-colors hover:border-line-strong"
                  data-reader-settings-target="fontOption"
                  data-font-id="<%= font[:id] %>"
                  data-action="click->reader-settings#selectFont"
                  aria-pressed="false">
            <%= font[:label] %>
          </button>
        <% end %>
      </div>
    </section>

    <section class="border-b border-line py-5">
      <div class="mb-3 flex items-center gap-2 text-sm font-medium text-fg">
        <svg class="h-4 w-4 shrink-0 text-fg-muted" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="m22 6-3-4-3 4h2v4h-2l3 4 3-4h-2V6zM9.307 4l-6 16h2.137l1.875-5h6.363l1.875 5h2.137l-6-16H9.307zm-1.239 9L10.5 6.515 12.932 13H8.068z" />
        </svg>
        <%= t('chapters.reader_settings.font_size') %>
      </div>
      <div class="flex items-center gap-0 overflow-hidden rounded-lg border border-line-strong">
        <button type="button"
                class="flex h-11 w-12 shrink-0 items-center justify-center text-lg font-medium text-fg-secondary transition-colors hover:bg-surface disabled:cursor-not-allowed disabled:opacity-40"
                data-reader-settings-font-step="decrease"
                data-action="click->reader-settings#decreaseFontSize"
                aria-label="<%= t('chapters.reader_settings.decrease_font_size') %>">
          −
        </button>
        <div class="flex h-11 min-w-0 flex-1 items-center justify-center border-x border-line-strong bg-surface text-sm font-semibold tabular-nums text-fg dark:bg-surface/80"
             data-reader-settings-target="fontSizeValue"
             aria-live="polite">
          16px
        </div>
        <button type="button"
                class="flex h-11 w-12 shrink-0 items-center justify-center text-lg font-medium text-fg-secondary transition-colors hover:bg-surface disabled:cursor-not-allowed disabled:opacity-40"
                data-reader-settings-font-step="increase"
                data-action="click->reader-settings#increaseFontSize"
                aria-label="<%= t('chapters.reader_settings.increase_font_size') %>">
          +
        </button>
      </div>
    </section>

    <section class="py-5">
      <div class="flex items-center justify-between gap-4">
        <div class="flex min-w-0 items-start gap-2">
          <svg class="mt-0.5 h-4 w-4 shrink-0 text-fg-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <div>
            <p class="text-sm font-medium text-fg">
              <%= t('chapters.reader_settings.dark_theme') %>
            </p>
            <p class="text-xs text-fg-muted">
              <%= t('chapters.reader_settings.dark_theme_hint') %>
            </p>
          </div>
        </div>
        <label class="relative inline-flex shrink-0 cursor-pointer items-center">
          <input type="checkbox"
                 class="peer sr-only"
                 data-reader-settings-target="themeToggle"
                 data-action="change->reader-settings#toggleTheme"
                 aria-label="<%= t('chapters.reader_settings.dark_theme') %>">
          <span class="h-6 w-11 rounded-full bg-surface-hover transition-colors peer-checked:bg-brand peer-focus-visible:ring-2 peer-focus-visible:ring-brand/60"></span>
          <span class="pointer-events-none absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform peer-checked:translate-x-5"></span>
        </label>
      </div>
      <p class="sr-only" data-reader-settings-target="themeLabel"></p>
    </section>

    <% if current_user&.manages_chapter?(chapter) && !chapter.fiction.license_frozen_for?(current_user) %>
      <section class="border-t border-line pt-5">
        <%= link_to edit_chapter_path(chapter),
                    class: 'flex w-full items-center justify-center gap-2 rounded-lg border border-line-strong bg-surface px-4 py-2.5 text-sm font-medium text-fg transition-colors hover:border-line-strong hover:bg-card dark:bg-surface/80' do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          <%= t('chapters.reader_settings.edit_chapter') %>
        <% end %>
      </section>
    <% end %>
  </div>
</aside>
