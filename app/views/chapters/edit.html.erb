<section class="bg-gray-50 dark:bg-gray-900 z-10 relative min-h-screen">
  <div class="py-8 px-4 sm:px-6 md:px-12 lg:px-24 mx-auto lg:py-12" data-controller="dropzone">
    <%= render 'chapters/composer_header',
               title: 'Оновити Розділ',
               subtitle: 'Відредагуйте розділ твору - оновіть заголовок, номер чи текст розділу!',
               chapter: @chapter %>

    <!-- Form Container -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl sm:border sm:border-gray-200 dark:border-gray-700 shadow-lg p-2 sm:p-8">
      <%= simple_form_for @chapter, as: :chapter, url: chapter_path(@chapter, page: @list_page), method: :put, html: { class: "form", multipart: true }, data: { turbo: false } do |f| %>
        <%= render 'form', chapter: @chapter, f: f %>
      <% end %>
    </div>
  </div>
</section>
