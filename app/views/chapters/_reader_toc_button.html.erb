<%# The toolbar hides while scrolling down, so phones get a Зміст that stays in the thumb zone mid-chapter. %>
<button type="button"
        class="fixed bottom-4 left-4 z-40 flex items-center gap-1.5 rounded-full border border-line/90 bg-page/95 py-2.5 pl-3 pr-4 text-sm font-medium text-fg shadow-md shadow-slate-900/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-fg-subtle/80 dark:shadow-black/40 dark:focus-visible:ring-fg-brand/80 sm:hidden"
        data-action="click->chapter-drawer#open"
        data-chapter-drawer-target="trigger"
        data-jump-to-top-target="reveal"
        aria-expanded="false"
        aria-controls="reader-chapter-list-panel"
        hidden>
  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h10M4 18h10" />
  </svg>
  <%= t('chapters.reader_chapter_drawer.toc') %>
</button>
