<%# locals: (title:, subtitle:, chapter:) %>
<div class="mb-8 text-center">
  <div class="mb-3 flex flex-wrap items-center justify-center gap-3">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white"><%= title %></h1>
    <%= render 'chapters/draft_badge', chapter: chapter %>
  </div>
  <p class="mx-auto max-w-2xl text-lg text-gray-600 dark:text-gray-400"><%= subtitle %></p>
</div>
