<%
  resume_locator = reader_resume_locator(@chapter)
  reader_controllers = "comments-drawer jump-to-top chapter-drawer reader-settings #{reader_progress_controllers}"
  reader_controllers = "#{reader_controllers} reading-resume" if resume_locator
%>
<div class="immersive-reader bg-reader-bg min-h-screen relative"
     data-controller="<%= reader_controllers %>"
     <%= tag.attributes(data: reader_progress_data(@chapter, @next_chapter)) %>
     <%= tag.attributes(data: reader_resume_data(resume_locator)) if resume_locator %>>
  <div class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat" style="background-image: url('<%= cover_background_url(@chapter.fiction.cover) %>');"></div>
  <div class="absolute inset-0 z-[1] bg-reader-bg/90"></div>

  <%= render 'reader_settings_drawer', chapter: @chapter %>
  <%= render 'comments_drawer', chapter: @chapter, comments: @comments, comment: @comment, commentable: @commentable %>

  <main class="relative z-10">
    <%= render 'reader_toolbar', chapter: @chapter, fiction: @chapter.fiction %>
    <%= render 'hero', chapter: @chapter, fiction: @chapter.fiction %>

    <% if epub_download_requires_login?(@chapter) %>
      <div class="container mx-auto px-4 py-4">
        <%= render 'reader_epub_login_banner', fiction: @chapter.fiction %>
      </div>
    <% end %>

    <!-- Main Content -->
    <% show_rating_notice = show_age_rating_notice?(@chapter.fiction) %>
    <% lock_reader = age_rating_reader_gate?(@chapter.fiction) %>
    <div class="container mx-auto px-4 py-2">
      <%= render Ui::AgeRatingNotice.new(rating: age_rating_notice_rating(@chapter.fiction), reader_gate: lock_reader) if show_rating_notice %>

      <div class="w-full py-2 sm:py-4<%= ' adult-content-gate--locked' if lock_reader %>"
           <%= 'data-adult-content-gate-content' if lock_reader %>>
        <%= render @chapter, previous_chapter: @previous_chapter, next_chapter: @next_chapter %>
      </div>
    </div>

    <%= render 'reader_copyright' %>
  </main>

  <button type="button"
          id="jump-to-top"
          class="fixed z-40 bottom-4 right-4 hidden rounded-full border border-line/90 bg-page/95 p-2.5 text-fg shadow-md shadow-slate-900/10 transition-opacity dark:shadow-black/40 sm:bottom-6 sm:right-6"
          title="Догори"
          aria-label="Прокрутити догори">
    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
    </svg>
  </button>

  <%= render 'reader_finish_prompt', chapter: @chapter if reader_finish_prompt?(@chapter, @next_chapter) %>

  <% if resume_locator && !reader_resume_auto? %>
    <%= render 'reader_resume_banner', locator: resume_locator %>
  <% elsif !user_signed_in? %>
    <%= render 'reader_resume_banner', locator: nil %>
  <% end %>

  <% if fiction_has_listable_chapters?(@chapter.fiction, current_user) %>
    <%= render 'reader_toc_button' %>
    <%= render "chapter_drawer",
               fiction: @chapter.fiction,
               order: @fiction_sidebar_presenter.order,
               toggle_order_button_id: "toggle-fictions-order-drawer",
               current_chapter: @chapter %>
  <% end %>

  <%# Drawer markup only on cadence chapters — omit hidden drawer slots on other pages so top/bottom can fill %>
  <%= render 'reader_ad_drawer', should_open: true if chapter_reader_ad_drawer_live? && @reader_ad_drawer_open %>
</div>
