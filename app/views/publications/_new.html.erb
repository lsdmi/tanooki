<section class="bg-page z-10 relative min-h-screen">
  <div class="py-4 px-2 sm:px-6 sm:py-8 md:px-12 lg:px-24 mx-auto lg:py-12" data-controller="dropzone">
    <!-- Header -->
    <div class="mb-6 text-center sm:mb-8">
      <h1 class="mb-3 text-2xl font-bold text-fg sm:text-3xl">Створити Допис</h1>
      <p class="mx-auto max-w-2xl text-base text-fg-muted sm:text-lg">Поділіться думками та досвідом з читачами! Створіть захоплюючий допис, який зацікавить аудиторію!</p>
    </div>

    <!-- Form Container -->
    <div class="bg-card rounded-2xl border border-line shadow-lg p-3 sm:p-8">
      <%= simple_form_for publication, as: :publication, url: publications_path, method: :post, html: { class: "form", multipart: true }, data: { turbo: false } do |f| %>
        <%= render 'publications/form', publication: publication, f: f, tags: tags %>
      <% end %>
    </div>
  </div>
</section>
