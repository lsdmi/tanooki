<section class="bg-page z-10 relative min-h-screen">
  <div class="py-8 px-4 sm:px-6 md:px-12 lg:px-24 mx-auto lg:py-12" data-controller="dropzone">
    <!-- Header -->
    <div class="mb-8 text-center">
      <h1 class="mb-3 text-3xl font-bold text-fg">Створити Допис</h1>
      <p class="text-lg text-fg-muted max-w-2xl mx-auto">Поділіться думками та досвідом з читачами! Створіть захоплюючий допис, який зацікавить аудиторію!</p>
    </div>

    <!-- Form Container -->
    <div class="bg-card rounded-2xl border border-line shadow-lg p-8">
      <%= simple_form_for publication, as: :publication, url: publications_path, method: :post, html: { class: "form", multipart: true }, data: { turbo: false } do |f| %>
        <%= render 'publications/form', publication: publication, f: f, tags: tags %>
      <% end %>
    </div>
  </div>
</section>
