<%= f.input :type, as: :hidden, input_html: { value: 'Tale' } %>

<div class="mx-auto">
  <!-- Main Content Area -->
  <div class="grid gap-6 lg:grid-cols-3 lg:gap-8">

    <!-- Left Column - Basic Info -->
    <div class="lg:col-span-1 space-y-6">

      <!-- Title Section -->
      <div class="sm:rounded-xl sm:border sm:border-line sm:bg-card sm:p-6 sm:shadow-sm">
        <div class="flex items-center mb-4">
          <div class="h-8 w-8 rounded-lg bg-brand-subtle flex items-center justify-center mr-3">
            <svg class="h-4 w-4 text-fg-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-fg">Основна інформація</h3>
        </div>

        <div class="space-y-4">
          <div>
            <%= f.label :title, 'Заголовок', class: 'block text-sm font-medium text-fg-secondary mb-2' %>
            <%= f.input :title, input_html: { class: "bg-surface-strong border border-line-strong text-fg text-sm rounded-lg focus:ring-2 focus:ring-brand focus:border-brand block w-full p-3 transition-all duration-200 #{'border-red-300 dark:border-red-500 ring-red-200 dark:ring-red-900/20' if publication.errors[:title].any?}" }, label: false, placeholder: 'Введіть заголовок допису' %>
            <%= tag.p publication.errors[:title].to_sentence(two_words_connector: "", last_word_connector: ""), class: 'text-sm text-status-danger-solid mt-1 flex items-center' do %>
              <svg class="h-4 w-4 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>
              <%= publication.errors[:title].first %>
            <% end if publication.errors[:title].any? %>
          </div>

          <div>
            <%= f.label :tag_ids, 'Теґи', class: 'block text-sm font-medium text-fg-secondary mb-2' %>
            <%= f.select :tag_ids, options_for_select(tags.pluck(:name, :id), selected: f.object.tags.ids), {}, { data: { controller: 'slim' }, multiple: true, class: 'bg-surface-strong border border-line-strong text-fg text-sm rounded-lg focus:ring-2 focus:ring-brand focus:border-brand block w-full p-3 transition-all duration-200' } %>
            <p class="text-xs text-fg-muted mt-1">Оберіть відповідні теґи для вашого допису</p>
          </div>
        </div>
      </div>

      <!-- Cover Image Section -->
      <div class="sm:rounded-xl sm:border sm:border-line sm:bg-card sm:p-6 sm:shadow-sm">
        <div class="flex items-center mb-4">
          <div class="h-8 w-8 rounded-lg bg-brand-subtle flex items-center justify-center mr-3">
            <svg class="h-4 w-4 text-fg-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-fg">Обкладинка</h3>
        </div>

        <div class="flex justify-center items-center w-full">
          <%= f.label :cover, class: "flex flex-col justify-center items-center w-full h-48 bg-surface-strong rounded-lg border-2 border-line-strong border-dashed cursor-pointer hover:border-brand/50 transition-all duration-200 #{'border-status-danger-subtle-border dark:border-status-danger-solid' if publication.errors[:cover].any?}" do %>
            <div class="flex flex-col justify-center items-center pt-5 pb-6">
              <svg aria-hidden="true" class="mb-3 w-8 h-8 text-fg-subtle" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
              <p class="mb-2 text-sm text-fg-muted"><span class="font-semibold">Натисніть,</span> аби обрати файл</p>
              <p class="text-xs text-fg-muted">SVG, PNG, JPEG чи WebP</p>
            </div>
            <%= f.file_field :cover, class: "hidden", label: false, data: { action: "change->dropzone#update" } %>
            <%= tag.div f.object.cover.blob&.filename || nil, id: 'image_name', class: 'text-center text-sm text-fg-muted' %>
          <% end %>
        </div>
        <%= tag.p publication.errors[:cover].to_sentence(two_words_connector: "", last_word_connector: ""), class: 'text-sm text-status-danger-solid mt-2 flex items-center' do %>
          <svg class="h-4 w-4 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>
          <%= publication.errors[:cover].first %>
        <% end if publication.errors[:cover].any? %>
      </div>

      <!-- Admin Options -->
      <% if current_user.admin? %>
        <div class="sm:rounded-xl sm:border sm:border-brand/25 sm:bg-gradient-to-r sm:from-brand-subtle sm:to-blue-50 sm:p-6 sm:shadow-sm dark:sm:to-purple-900/20">
          <div class="flex items-center mb-4">
            <div class="h-8 w-8 rounded-lg bg-brand-subtle flex items-center justify-center mr-3">
              <svg class="h-4 w-4 text-fg-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-fg">Адміністративні налаштування</h3>
          </div>

          <div class="flex items-center">
            <%= f.input :highlight, as: :boolean, type: 'checkbox', label: false, input_html: { class: 'w-4 h-4 text-fg-brand bg-surface-strong rounded border-line-strong focus:ring-brand' } %>
            <label for="inline-checkbox" class="ml-3 text-sm text-fg-secondary">Додати допис до центральної секції головної сторінки</label>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Right Column - Content -->
    <div class="lg:col-span-2">
      <div class="sm:rounded-xl sm:border sm:border-line sm:bg-card sm:p-6 sm:shadow-sm">
        <div class="mb-3 flex items-center sm:mb-6">
          <div class="h-8 w-8 rounded-lg bg-brand-subtle flex items-center justify-center mr-3">
            <svg class="h-4 w-4 text-fg-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-fg">Зміст допису</h3>
        </div>

        <div class="space-y-4">
          <div>
            <%= f.text_area :description, label: false, class: "tinymce block w-full min-h-[400px] focus:ring-0 bg-transparent text-fg border-0 p-0" %>
          </div>

          <%= tag.div publication.errors[:description].to_sentence(two_words_connector: "", last_word_connector: ""), class: 'mx-3 mt-2 flex items-center rounded-lg border border-red-200 bg-status-danger-subtle-bg p-3 text-sm text-status-danger-solid dark:border-red-800 sm:mx-0' do %>
            <svg class="h-4 w-4 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>
            <%= publication.errors[:description].first %>
          <% end if publication.errors[:description].any? %>
        </div>
      </div>
    </div>
  </div>

  <%= render 'shared/rich_text_submit',
             primary_label: t('publications.buttons.publish'),
             show_draft: show_publication_draft_save?(publication),
             unpublish: show_publication_unpublish?(publication),
             unpublish_confirm: t('publications.confirms.unpublish') %>
</div>
