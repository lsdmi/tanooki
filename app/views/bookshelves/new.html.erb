<section class="bg-page z-10 relative min-h-screen">
  <div class="py-8 px-4 sm:px-6 md:px-12 lg:px-24 mx-auto lg:py-12">
    <!-- Header -->
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-bold text-fg mb-3">Додати Нову Книжкову Полицю</h1>
      <p class="text-lg text-fg-muted max-w-2xl mx-auto">Згуртуйте улюблені твори в тематичну полицю для зручного доступу!</p>
    </div>

    <!-- Form Container -->
    <div class="bg-card rounded-2xl border border-line shadow-lg p-8">
      <%= render 'form', bookshelf: @bookshelf, selected_fictions: @selected_fictions %>
    </div>
  </div>
</section>
