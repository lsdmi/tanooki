<%# locals: (max_content_rating:, placement: :fan) %>
<%# Shelf-level mark: the shelf's highest rating, drawn with the same age icon as the covers. %>
<%# placement: :cover = focus card (top-left), :fan = update-row mini fan, :inline = next to the row title. %>
<% band = max_content_rating.to_i %>
<% rating = if band >= Fiction.content_ratings.fetch('eighteen') then 'eighteen'
            elsif band >= Fiction.content_ratings.fetch('sixteen') then 'sixteen'
            end %>
<% if rating %>
  <% options = case placement.to_sym
               when :cover then { size: :md, placement: :corner_left }
               when :fan then { size: :lg, placement: :corner_right }
               else { size: :md, placement: :inline }
               end %>
  <%= render Fictions::CoverAgeBadgeComponent.new(rating:, **options) %>
<% end %>
