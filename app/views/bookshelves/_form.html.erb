<%= form_with model: bookshelf, local: true, class: "space-y-6", data: { turbo: false } do |form| %>
  <% if bookshelf.errors.any? %>
    <div class="rounded-md bg-status-danger-subtle-bg p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800 dark:text-red-200">
            Виправте наступні помилки:
          </h3>
          <div class="mt-2 text-sm text-status-danger-solid">
            <ul class="list-disc list-inside space-y-1">
              <% bookshelf.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="mx-auto">
    <!-- Main Content Area - Columns Layout -->
    <div class="grid lg:grid-cols-2 gap-4 sm:gap-8 mb-8">
      <!-- Left Column - Basic Info -->
      <div class="space-y-4 sm:space-y-6">
        <div class="bg-card rounded-xl border border-line p-3 sm:p-6 shadow-sm">
          <div class="flex items-center mb-4">
            <div class="h-8 w-8 rounded-lg bg-brand-subtle flex items-center justify-center mr-3">
              <svg class="h-4 w-4 text-fg-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-fg">Основна інформація</h3>
          </div>
          <div class="space-y-4">
            <div>
              <%= form.label :title, "Назва полиці", class: "block text-sm font-medium text-fg-secondary mb-2" %>
              <%= form.text_field :title,
                  class: "block w-full rounded-lg border border-line-strong bg-surface-strong px-3 py-2 text-sm text-fg focus:border-brand focus:ring-brand placeholder-fg-muted",
                  placeholder: "Мої улюблені романи" %>
            </div>
            <div>
              <%= form.label :description, "Опис полиці", class: "block text-sm font-medium text-fg-secondary mb-2" %>
              <%= form.text_area :description,
                  rows: 4,
                  class: "block w-full rounded-lg border border-line-strong bg-surface-strong px-3 py-2 text-sm text-fg focus:border-brand focus:ring-brand placeholder-fg-muted",
                  placeholder: "Опишіть тематику та призначення цієї полиці..." %>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column - Fiction Selection -->
      <div class="space-y-4 sm:space-y-6">
        <div class="bg-card rounded-xl border border-line p-3 sm:p-6 shadow-sm">
          <div class="flex items-center mb-4">
            <div class="h-8 w-8 rounded-lg bg-brand-subtle flex items-center justify-center mr-3">
              <svg class="h-4 w-4 text-fg-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-fg">Оберіть твори</h3>
          </div>
          <div class="space-y-4">
            <%= form.select :fiction_ids,
                  options_from_collection_for_select(selected_fictions, :id, :title, bookshelf.fiction_ids),
                  {},
                  { multiple: true,
                    class: "bg-surface-strong border border-line-strong text-fg text-sm rounded-lg focus:ring-2 focus:ring-brand focus:border-brand block w-full p-3 transition-all duration-200",
                    data: {
                      controller: 'slim-fiction-search',
                      slim_fiction_search_url_value: fiction_options_bookshelves_path
                    } } %>
            <p class="text-xs text-fg-muted">Відкрийте список або введіть назву чи автора для пошуку</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Submit Section -->
  <div class="mt-8 pt-6 border-t border-line">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <div class="flex items-center text-sm text-fg-muted">
        </div>
      </div>

      <div class="flex items-center space-x-3">
        <%= link_to "Скасувати", studio_index_path(tab: 'bookshelves'),
            class: "px-4 py-2 text-sm font-medium text-fg-secondary bg-card border border-line-strong rounded-lg hover:bg-surface-strong transition-colors duration-200" %>
        <%= ui_button(as: :submit, label: 'Надіслати', size: :lg) %>
      </div>
    </div>
  </div>
<% end %>
