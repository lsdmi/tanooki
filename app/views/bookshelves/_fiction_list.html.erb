<%# locals: bookshelf:, fictions:, pagy:, hidden_fiction_count: 0, content_filter_fingerprint: nil %>
<% cache_key = bookshelf.fiction_list_fragment_cache_key(page: pagy.page) %>
<% cache_key << content_filter_fingerprint if content_filter_fingerprint.present? %>
<% cache cache_key do %>
  <%= render Ui::FilteredNoticeComponent.new(count: hidden_fiction_count.to_i, change_path: content_filter_settings_path) %>
  <%= render partial: 'fiction_lists/picker_list', locals: { fictions:, pagy: } %>
<% end %>
