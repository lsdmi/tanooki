<% share_url = bookshelf_url(@bookshelf) %>
<% content_for :head do %>
  <%= tag.link rel: 'preload', as: 'image', href: decoration_eager_url('psyduck_background.webp'),
               type: 'image/webp' %>
<% end %>
<div class="bookshelves-hub relative min-h-screen overflow-x-clip bg-page">
  <%= tag.div **eager_decoration_background(
        'psyduck_background.webp',
        html_class: 'pointer-events-none absolute inset-0 bg-cover bg-center bg-no-repeat bg-fixed',
        aria: { hidden: true }
      ) %>
  <div class="pointer-events-none absolute inset-0 bg-page/95 dark:bg-page/90" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-screen-xl px-4 pb-20 pt-6 sm:pb-24 sm:pt-8 lg:pt-10 2xl:px-0">
    <%= render 'bookshelves/breadcrumbs', bookshelf: @bookshelf %>

    <header class="bookshelves-hub-reveal mb-10 flex items-start justify-between gap-4 sm:mb-12 sm:gap-8">

      <div class="min-w-0 max-w-2xl flex-1">
        <div class="inline-flex max-w-full items-start gap-2">
          <h1 class="min-w-0 break-words text-3xl font-black leading-none tracking-tight text-fg sm:text-4xl lg:text-5xl">
            <%= @bookshelf.title %>
          </h1>
          <%= tag.div class: 'mt-1 shrink-0 sm:mt-1.5',
                      data: {
                        controller: 'share-link',
                        share_link_url_value: share_url,
                        share_link_copied_value: t('bookshelves.show.share.copied'),
                        share_link_idle_value: t('bookshelves.show.share.label')
                      } do %>
            <button type="button"
                    class="inline-flex size-8 items-center justify-center rounded-md text-fg-muted transition-[color,transform] duration-150 hover:text-fg-brand focus:outline-none focus-visible:ring-2 focus-visible:ring-brand"
                    title="<%= t('bookshelves.show.share.label') %>"
                    aria-label="<%= t('bookshelves.show.share.label') %>"
                    data-action="share-link#copyUrl">
              <%= stroke_icon(:share, 'size-4 shrink-0') %>
              <span class="sr-only" data-share-link-target="label"><%= t('bookshelves.show.share.label') %></span>
            </button>
          <% end %>
        </div>
        <p class="mt-3 text-sm text-fg-muted sm:mt-4">
          <%= link_to @bookshelf.user_name,
                      profile_path(@bookshelf.user_sqid),
                      class: 'rounded-sm transition-colors hover:text-fg-brand focus:outline-none focus-visible:ring-2 focus-visible:ring-brand' %>
        </p>
        <% if @bookshelf.description.present? %>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-pretty text-fg-secondary sm:mt-4 sm:text-[0.9375rem]">
            <%= @bookshelf.description %>
          </p>
        <% end %>
      </div>

      <% if @header_covers.any? %>
        <ul class="bookshelves-hub-cover-fan flex shrink-0 items-end -space-x-3 sm:-space-x-4" aria-hidden="true">
          <% @header_covers.each_with_index do |fiction, index| %>
            <li class="relative w-12 shrink-0 overflow-hidden rounded-md bg-surface-strong ring-2 ring-page sm:w-14"
                style="z-index: <%= @header_covers.size - index %>;">
              <%= cover_card_picture_tag(
                    fiction.cover,
                    preset: :thumb,
                    alt: t('meta.cover_alt', title: fiction.title),
                    class: 'aspect-[2/3] w-full object-cover',
                    loading: (index < 2 ? 'eager' : 'lazy'),
                    decoding: 'async',
                    fetchpriority: (index.zero? ? 'high' : nil),
                    srcset: true,
                    sizes: Meta::CoverCardPresets::HUB_FAN_SIZES
                  ) %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </header>

    <section class="bookshelves-hub-reveal" aria-label="<%= t('bookshelves.show.works') %>">
      <%= render 'bookshelves/hub_section_heading', title: t('bookshelves.show.works') %>
      <div class="bookshelves-hub-band rounded-2xl px-3 py-5 sm:px-5 sm:py-6">
        <%= render 'bookshelves/fiction_list',
                   bookshelf: @bookshelf,
                   fictions: @fictions,
                   pagy: @pagy,
                   hidden_fiction_count: @hidden_fiction_count,
                   content_filter_fingerprint: @content_filter_fingerprint %>
      </div>
    </section>
  </div>
</div>
