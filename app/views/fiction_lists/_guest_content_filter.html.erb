<div id="<%= dom_id %>" class="pt-4 mt-4 border-t border-line">
  <%= form_with url: content_filter_path, method: :patch, data: { turbo_stream: '' } do %>
    <%= hidden_field_tag :max_content_rating, '' %>
    <label class="inline-flex items-center" for="<%= dom_id %>_toggle">
      <%= check_box_tag :max_content_rating, '16', current_content_filter.max_rating == 16,
            id: "#{dom_id}_toggle",
            class: 'h-5 w-5 rounded border-line-strong text-brand focus:ring-brand bg-card transition duration-150',
            onchange: 'this.form.requestSubmit()' %>
      <span class="ml-2 text-base sm:text-lg font-black text-fg tracking-tight leading-none">
        <%= t('content_filters.guest_hide_eighteen') %>
      </span>
    </label>
  <% end %>
</div>
