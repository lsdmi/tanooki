<div class="mt-8 flex flex-col gap-4">
  <% fictions.each_with_index do |fiction, index| %>
    <% rating = fiction.average_rating %>
    <% rating_text = rating.positive? ? number_with_precision(rating, precision: 1, separator: ',') : nil %>
    <% age_label = fiction.content_rating_label %>
    <% blurb = fiction.short_description.presence || fiction.description.to_s %>
    <% genre_slugs = fiction.genres.sort_by(&:name).to_h { |genre| [genre.name, genre.slug] } %>
    <% genre_labels = Genre.sort_labels_adult_first(genre_slugs.keys, slugs: genre_slugs) %>
    <article class="flex gap-4 rounded-xl border border-line bg-main p-4"
             data-fiction-picker-id-param="<%= fiction.id %>">
      <%= link_to fiction_path(fiction),
            class: 'relative w-28 shrink-0 self-start overflow-hidden rounded-lg bg-surface-strong sm:w-32',
            data: { turbo_frame: '_top' } do %>
        <div class="aspect-[2/3]">
          <%= cover_card_picture_tag(fiction.cover, alt: '', class: 'h-full w-full object-cover', picture_html: { class: 'block h-full w-full' }) %>
        </div>
        <% if age_label %>
          <span class="pointer-events-none absolute left-1.5 top-1.5 z-10 flex h-6 min-w-[1.5rem] items-center justify-center rounded-md px-1.5 text-xs font-bold shadow-sm backdrop-blur-[2px] <%= fiction.content_rating_eighteen? ? 'token-raw border border-rose-700/60 bg-rose-100/80 text-rose-900 dark:border-rose-400/50 dark:bg-rose-950/70 dark:text-rose-100' : 'token-raw border border-amber-800/60 bg-amber-100/80 text-amber-950 dark:border-amber-400/50 dark:bg-amber-950/70 dark:text-amber-100' %>"
                aria-label="<%= age_label %>"><%= age_label %></span>
        <% end %>
      <% end %>

      <div class="flex min-w-0 flex-1 flex-col">
        <h2 class="text-base font-medium leading-5 text-fg sm:text-lg sm:leading-6">
          <%= link_to fiction.title, fiction_path(fiction),
                class: 'line-clamp-2 rounded-md transition-colors hover:text-fg-brand hover:underline underline-offset-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand',
                data: { turbo_frame: '_top' } %>
        </h2>

        <p class="mt-1.5 truncate text-sm text-fg-muted">
          <% if fiction.author.present? %>
            <span><%= fiction.author %></span>
            <span class="mx-1 text-fg-subtle" aria-hidden="true">·</span>
          <% end %>
          <span><%= t('fictions.hero.stats.chapters', count: fiction.chapter_count) %></span>
        </p>

        <ul class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-sm text-fg-muted">
          <% if rating_text %>
            <li class="inline-flex items-center gap-1.5">
              <svg class="h-3.5 w-3.5 shrink-0 text-amber-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              <span class="tabular-nums text-fg"><%= rating_text %></span>
            </li>
          <% end %>
          <li class="inline-flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5 shrink-0 text-fg-subtle" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
            <span class="tabular-nums"><%= format_view_count(fiction.views) %></span>
          </li>
          <li class="inline-flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5 shrink-0 text-fg-subtle" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4" /></svg>
            <span><%= fiction.public_listing_label %></span>
          </li>
        </ul>

        <% if blurb.present? %>
          <p class="mt-2.5 line-clamp-2 text-sm leading-5 text-fg-muted sm:line-clamp-3"><%= blurb %></p>
        <% end %>

        <% if genre_labels.any? %>
          <%= render Ui::TagListComponent.new(
                labels: genre_labels,
                variant: :genre,
                size: :sm,
                compact_max: 3,
                compact_max_sm: 2,
                sort_adult_first: true,
                genre_slugs: genre_slugs,
                href_builder: ->(name) {
                  slug = genre_slugs[name]
                  fiction_genre_fictions_path(slug) if slug.present?
                },
                tag_html: { data: { turbo_frame: '_top' } },
                html: { class: 'mt-3 gap-1.5 min-w-0' }
              ) %>
        <% end %>
      </div>
    </article>
    <% if catalog_mid_ad?(index: index, total: fictions.size) %>
      <%= render 'fiction_lists/catalog_ad_slot' %>
    <% end %>
  <% end %>
</div>
