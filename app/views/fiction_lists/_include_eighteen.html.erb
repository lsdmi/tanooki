<% guest_toggle_id = local_assigns.fetch(:guest_toggle_id, 'guest-content-filter') %>
<% eighteen_locked = current_content_filter.hides_eighteen? %>
<div id="catalog-include-eighteen-<%= guest_toggle_id %>">
  <input type="hidden" name="filters_applied" value="1">
  <% if eighteen_locked && catalog_include_eighteen? %>
    <input type="hidden" name="include_eighteen" value="1">
  <% end %>
  <label class="inline-flex cursor-pointer items-start gap-2.5">
    <input type="checkbox" name="include_eighteen" value="1"
           <%= 'checked' if !eighteen_locked && catalog_include_eighteen? %>
           <%= 'disabled' if eighteen_locked %>
           class="mt-0.5 h-5 w-5 rounded border-line-strong text-brand focus:ring-brand bg-main transition duration-150 disabled:opacity-50">
    <span class="text-sm font-medium text-fg">
      <%= t('fiction_lists.filters.include_eighteen') %>
    </span>
  </label>
  <% if eighteen_locked %>
    <% change_path = current_user ? content_filter_settings_path : "##{guest_toggle_id}" %>
    <p class="mt-1.5 ml-7 text-sm text-fg-muted">
      <%= t('content_filters.eighteen_locked') %>
      ·
      <%= link_to t('content_filters.change'), change_path,
                  class: 'text-fg-brand underline-offset-2 hover:underline',
                  data: { turbo_frame: '_top' } %>
    </p>
  <% end %>
</div>
