<%# locals: (pagy:) %>
<% current_sort = catalog_sort_key %>
<% active_filters = catalog_active_filter_count %>
<% frame_data = { turbo_frame: 'fiction-list-page', turbo_action: 'advance' } %>
<div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3 md:gap-4">
  <%= form_with url: alphabetical_fictions_path, method: :get, class: 'min-w-0 w-full sm:flex-1',
                data: frame_data do %>
    <% if params[:view] == 'list' %>
      <%= hidden_field_tag :view, 'list' %>
    <% end %>
    <% unless current_sort == FictionListQueryBuilder::DEFAULT_SORT %>
      <%= hidden_field_tag :sort, current_sort %>
    <% end %>
    <% catalog_filter_hidden_fields.each do |name, value| %>
      <%= hidden_field_tag name, value %>
    <% end %>
    <label class="catalog-control flex h-10 items-center gap-2 px-3 sm:px-3.5">
      <svg class="shrink-0 text-fg-subtle" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <%= text_field_tag :q, params[:q],
            placeholder: t('fiction_lists.search_placeholder'),
            autocomplete: 'off',
            class: 'min-w-0 flex-1 border-0 bg-transparent text-sm text-fg outline-none placeholder:text-fg-subtle sm:text-base' %>
    </label>
  <% end %>
  <div class="flex w-full items-center gap-2 sm:w-auto sm:shrink-0 sm:gap-3 md:gap-4">
    <p class="mr-1 hidden text-sm text-fg-muted lg:block"><%= t('fiction_lists.catalog_count', count: pagy.count) %></p>
    <div class="relative min-w-0 flex-1 sm:flex-none" data-controller="flowbite">
      <button id="catalog-sort-button" type="button" data-dropdown-toggle="catalog-sort-menu" data-dropdown-placement="bottom-end"
              class="catalog-control inline-flex h-10 w-full items-center justify-between gap-2 px-3.5 text-sm text-fg sm:w-auto"
              aria-haspopup="listbox" aria-label="<%= t('fiction_lists.sort.menu') %>">
        <%= catalog_sort_button_label(current_sort) %>
        <svg class="shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
      </button>
      <div id="catalog-sort-menu" class="z-20 hidden w-72 overflow-hidden rounded-[var(--catalog-radius)] bg-main shadow-popover ring-1 ring-[var(--catalog-control-line)]" role="listbox" aria-labelledby="catalog-sort-button">
        <ul class="max-h-80 overflow-y-auto text-sm">
          <% catalog_sort_options.each do |label, key| %>
            <li role="option" aria-selected="<%= key == current_sort %>">
              <%= link_to label, catalog_path_with(sort: key),
                    data: frame_data,
                    class: "block px-3.5 py-2.5 #{key == current_sort ? 'bg-surface-strong font-medium text-fg' : 'text-fg hover:bg-surface-hover'}" %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
    <button type="button"
            class="catalog-control relative grid h-10 w-10 place-items-center text-fg"
            data-catalog-filters-target="trigger"
            data-action="click->catalog-filters#open"
            aria-haspopup="dialog"
            aria-controls="catalog-filters-panel"
            aria-expanded="false"
            aria-label="<%= t('fiction_lists.filters.title') %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" /></svg>
      <% if active_filters.positive? %>
        <span class="absolute -right-1 -top-1 grid h-5 min-w-5 place-items-center rounded-full bg-brand px-1 text-[11px] font-semibold leading-none text-fg-on-brand"><%= active_filters %></span>
      <% end %>
    </button>
    <div class="catalog-control flex h-10 items-center gap-0.5 px-1.5">
      <%= link_to catalog_path_with(view: nil),
            data: frame_data,
            class: "grid h-7 w-7 place-items-center rounded-sm #{params[:view] == 'list' ? 'text-fg-subtle' : 'bg-surface-strong text-fg'}",
            aria: { label: t('fiction_lists.view_grid'), current: params[:view] == 'list' ? nil : 'page' } do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="4" width="6" height="6" rx="1" /><rect x="14" y="4" width="6" height="6" rx="1" /><rect x="4" y="14" width="6" height="6" rx="1" /><rect x="14" y="14" width="6" height="6" rx="1" /></svg>
      <% end %>
      <%= link_to catalog_path_with(view: 'list'),
            data: frame_data,
            class: "grid h-7 w-7 place-items-center rounded-sm #{params[:view] == 'list' ? 'bg-surface-strong text-fg' : 'text-fg-subtle'}",
            aria: { label: t('fiction_lists.view_list'), current: params[:view] == 'list' ? 'page' : nil } do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      <% end %>
    </div>
  </div>
</div>
