<%# Drawer must sit outside catalog-alpha's z-10 stacking context or the navbar covers its header. %>
<div data-controller="catalog-filters">
  <div class="catalog-alpha relative z-10 mx-auto max-w-screen-xl px-4 py-6 lg:py-12 2xl:px-0">
    <h1 class="sr-only">Сховище</h1>

    <%= render partial: 'fiction_lists/dynamic_content',
               locals: { fictions: @fictions, pagy: @pagy, explicit_hidden_genre: @explicit_hidden_genre,
                         content_filter_notice: true } %>
  </div>

  <%= render 'fiction_lists/catalog_filters_drawer' %>
</div>
