<%= turbo_frame_tag 'fiction-list-page', class: 'catalog-list-frame block' do %>
  <%= render 'fiction_lists/catalog_toolbar', pagy: pagy %>

  <div class="catalog-list-body relative mt-2 min-h-48">
    <div class="catalog-frame-spinner" aria-hidden="true">
      <svg class="h-8 w-8 animate-spin text-fg-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" role="presentation">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    </div>

    <div class="catalog-list-body-content">
      <% if local_assigns[:content_filter_notice] && current_content_filter.active? && !local_assigns[:explicit_hidden_genre] %>
        <div class="px-3">
          <%= render Ui::FilteredNoticeComponent.new(count: nil, change_path: content_filter_change_path) %>
        </div>
      <% end %>
      <% if local_assigns[:explicit_hidden_genre] %>
        <p role="status" class="px-3 pt-4 text-sm font-medium text-fg-muted">
          <%= t('content_filters.genre_hidden') %>
          ·
          <%= link_to t('content_filters.change'), content_filter_settings_path,
                      class: 'text-fg-brand underline-offset-2 hover:underline',
                      data: { turbo_frame: '_top' } %>
        </p>
      <% end %>

      <% if fictions.any? %>
        <% if params[:view] == 'list' %>
          <%= render 'fiction_lists/catalog_list', fictions: fictions %>
        <% else %>
          <%= render 'fiction_lists/catalog_grid', fictions: fictions %>
        <% end %>
        <%= ui_pagination(pagy, frame_id: 'fiction-list-page', custom_params: fiction_list_pagy_custom_params, html: { class: 'pt-12' }) %>
      <% elsif params[:q].present? %>
        <div class="py-16 text-center">
          <p class="font-semibold text-fg"><%= t('fiction_lists.empty.search_title', query: params[:q]) %></p>
          <p class="mt-1 text-sm text-fg-muted"><%= t('fiction_lists.empty.search_hint') %></p>
        </div>
      <% elsif local_assigns[:content_filter_notice] && current_content_filter.active? %>
        <p class="py-16 text-center text-lg font-semibold text-fg"><%= t('content_filters.empty') %></p>
      <% else %>
        <p class="py-16 text-center text-lg font-semibold text-fg"><%= t('fiction_lists.empty.none') %></p>
      <% end %>
    </div>
  </div>
<% end %>
