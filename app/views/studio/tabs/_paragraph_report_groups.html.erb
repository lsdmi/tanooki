<% digests = local_assigns.fetch(:paragraph_report_digests, {}) %>
<% groups = local_assigns.fetch(:paragraph_report_groups, []) %>
<div class="space-y-2">
  <% groups.each do |group| %>
    <% chapter = group.chapter %>
    <% fiction = chapter.fiction %>
    <% stale = digests[chapter.id].present? && digests[chapter.id] != group.digest %>
    <article class="rounded-lg border border-line bg-card p-4 shadow-sm">
      <div class="mb-3 flex flex-wrap items-center gap-1.5">
        <span class="text-sm font-semibold text-fg"><%= fiction.title %></span>
        <span class="rounded bg-brand-subtle px-2 py-0.5 text-xs text-fg-brand"><%= [
              (chapter.volume_number&.nonzero? ? "Том #{Chapters::Formatting.format_decimal(chapter.volume_number)}." : nil),
              "Розділ #{Chapters::Formatting.format_decimal(chapter.number)}"
            ].compact.join(' ') %></span>
        <% if group.size > 1 %>
          <span class="rounded bg-surface-strong px-2 py-0.5 text-xs text-fg-muted">
            <%= t('studio.paragraph_reports.reporters_count', count: group.size) %>
          </span>
        <% end %>
        <% if stale %>
          <% stale_hint_id = "paragraph-report-stale-#{group.primary.id}" %>
          <span class="group relative inline-flex">
            <button type="button"
                    class="inline-flex rounded p-0.5 text-status-warning-subtle-fg hover:bg-status-warning-subtle-bg focus:outline-none focus-visible:ring-2 focus-visible:ring-status-warning-subtle-border"
                    aria-describedby="<%= stale_hint_id %>"
                    aria-label="<%= t('studio.paragraph_reports.stale') %>">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </button>
            <span id="<%= stale_hint_id %>"
                  role="tooltip"
                  class="pointer-events-none absolute left-1/2 top-full z-20 mt-1 w-64 -translate-x-1/2 whitespace-normal rounded-md bg-invert px-2.5 py-1.5 text-left text-xs leading-snug text-fg-on-invert opacity-0 shadow-popover transition-opacity group-hover:opacity-100 group-focus-within:opacity-100">
              <%= t('studio.paragraph_reports.stale_hint') %>
            </span>
          </span>
        <% end %>
      </div>

      <blockquote class="border-l-2 border-line-strong pl-3 text-sm leading-relaxed text-fg">
        «<%= group.quote %><%= '…' if group.quote.length >= ParagraphReport::QUOTE_MAX %>»
      </blockquote>

      <ul class="mt-3 divide-y divide-line border-y border-line">
        <% group.reports.each do |report| %>
          <li class="flex gap-3 py-3">
            <%= image_tag avatar_image_url(report.user.avatar.image),
                          alt: '',
                          class: 'mt-0.5 size-8 shrink-0 rounded-full object-cover',
                          height: '32',
                          width: '32' %>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <%= link_to report.user.name, profile_path(report.user.sqid),
                            turbo_drive_visit_data.merge(class: 'text-sm font-medium text-fg hover:text-brand hover:underline') %>
                <time class="text-[11px] text-fg-subtle" datetime="<%= report.created_at.iso8601 %>">
                  <%= time_ago_in_words(report.created_at) %> тому
                </time>
              </div>
              <% if report.message.present? %>
                <p class="mt-1 text-sm leading-relaxed text-fg-muted break-words"><%= report.message %></p>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>

      <p class="mt-3 text-xs text-fg-subtle">
        <%= link_to t('studio.paragraph_reports.open_reader'),
                    chapter_path(chapter, resume: 1, rp_quote: group.quote, rp_i: group.block_index,
                                          rp_digest: group.digest),
                    turbo_drive_visit_data.merge(class: 'hover:text-brand hover:underline') %>
        ·
        <%= link_to t('studio.paragraph_reports.edit_chapter'),
                    edit_chapter_path(chapter),
                    turbo_drive_visit_data.merge(class: 'hover:text-brand hover:underline') %>
      </p>

      <div class="mt-3 flex gap-2">
        <%= button_to t('studio.paragraph_reports.fixed'),
                      studio_paragraph_report_path(group.primary, status: 'fixed'),
                      method: :patch,
                      params: { ids: group.report_ids },
                      form: { class: 'min-w-0 flex-1', data: { turbo_frame: '_top' } },
                      class: 'inline-flex w-full items-center justify-center rounded-lg bg-brand px-3 py-2 text-sm font-medium text-fg-on-brand transition-colors hover:opacity-95' %>
        <%= button_to t('studio.paragraph_reports.dismissed'),
                      studio_paragraph_report_path(group.primary, status: 'dismissed'),
                      method: :patch,
                      params: { ids: group.report_ids },
                      form: { class: 'min-w-0 flex-1', data: { turbo_frame: '_top' } },
                      class: 'inline-flex w-full items-center justify-center rounded-lg border border-line-strong bg-main px-3 py-2 text-sm font-medium text-fg transition-colors hover:bg-surface' %>
      </div>
    </article>
  <% end %>
</div>
