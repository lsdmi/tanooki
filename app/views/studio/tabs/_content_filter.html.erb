<% preference = current_content_filter %>
<% selected_rating = preference.max_rating.nil? ? '' : preference.max_rating.to_s %>
<% selected_packages = preference.package_keys %>
<% rating_options = [
     ['', t('content_filters.ratings.all')],
     ['16', t('content_filters.ratings.no_eighteen')],
     ['0', t('content_filters.ratings.no_sixteen')]
   ] %>
<div id="content-filter-card" class="rounded-lg border border-line bg-card shadow-sm relative overflow-hidden">
  <%= render 'shared/decorative_ornament' %>

  <div class="p-6 sm:p-8">
    <div class="text-center mb-8">
      <h3 class="text-xl font-semibold text-fg mb-2"><%= t('content_filters.title') %></h3>
      <p class="text-sm text-fg-muted"><%= t('content_filters.hint') %></p>
    </div>

    <%= form_with url: content_filter_path, method: :patch, data: { turbo_stream: '' } do %>
      <div class="mx-auto max-w-2xl space-y-8 lg:max-w-5xl">
        <fieldset>
          <legend class="block text-center text-lg font-medium text-fg mb-4"><%= t('content_filters.rating_legend') %></legend>
          <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
            <% rating_options.each do |value, label| %>
              <label class="inline-flex items-center cursor-pointer" for="content_filter_rating_<%= value.presence || 'all' %>">
                <%= radio_button_tag :max_content_rating, value, selected_rating == value,
                      id: "content_filter_rating_#{value.presence || 'all'}",
                      class: 'w-4 h-4 text-fg-secondary bg-surface border-line-strong focus:ring-line-strong focus:ring-2' %>
                <span class="ml-2 text-fg font-medium"><%= label %></span>
              </label>
            <% end %>
          </div>
        </fieldset>

        <fieldset data-controller="package-limit">
          <legend class="block text-center text-lg font-medium text-fg mb-1"><%= t('content_filters.packages_legend') %></legend>
          <p class="mb-4 text-center text-sm text-fg-muted"><%= t('content_filters.packages_hint') %></p>
          <% columns = [%i[relationships moods], %i[worlds]] %>
          <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:items-start lg:gap-x-10">
            <% columns.each do |column| %>
              <div class="space-y-6">
                <% column.each do |group| %>
                  <div>
                    <h4 class="mb-2 text-center text-sm font-semibold text-fg"><%= t("content_filters.groups.#{group}") %></h4>
                    <div class="space-y-1">
                      <% ContentFilters::Packages::GROUPS.fetch(group).each do |package_key| %>
                        <%= render 'studio/tabs/content_filter_package',
                                   package_key:,
                                   selected: selected_packages.include?(package_key) %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </fieldset>

        <% if local_assigns[:error].present? %>
          <p class="text-sm text-status-danger-solid text-center"><%= error %></p>
        <% end %>

        <div class="text-center">
          <%= ui_button(t('content_filters.save'), as: :submit, size: :md) %>
        </div>
      </div>
    <% end %>

    <div class="text-center mt-4">
      <%= button_to t('content_filters.reset'), content_filter_path, method: :patch,
            params: { max_content_rating: '' },
            class: 'text-sm text-fg-muted underline hover:text-fg',
            form: { class: 'inline', data: { turbo_stream: '' } } %>
    </div>
  </div>
</div>
