<% epub_export_requests = local_assigns.fetch(:epub_export_requests, []) %>

<div class="space-y-6">
  <div class="rounded-lg border border-line bg-card p-6 text-center shadow-sm relative overflow-hidden">
    <%= render 'shared/jellyfish_ornament' %>
    <div class="mx-auto h-20 w-20 rounded-full bg-brand-subtle flex items-center justify-center mb-4 relative z-10">
      <svg class="h-10 w-10 text-fg-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 16V4m0 12-4-4m4 4 4-4M5 20h14" />
      </svg>
    </div>
    <h3 class="mb-2 text-lg font-semibold leading-none text-fg relative z-10">EPUB-завантаження</h3>
    <p class="text-fg-muted relative z-10">Останні згенеровані EPUB-файли доступні протягом 24 годин.</p>
  </div>

  <% if epub_export_requests.any? %>
    <div class="rounded-lg border border-line bg-card shadow-sm">
      <div class="hidden sm:block rounded-lg relative overflow-x-auto">
        <%= render 'shared/jellyfish_ornament' %>
        <table class="w-full divide-y divide-line text-left text-sm text-fg">
          <thead class="bg-brand-subtle text-xs uppercase text-fg-muted">
            <tr>
              <th scope="col" class="whitespace-nowrap p-4 text-xs font-semibold uppercase text-fg-secondary">Файл</th>
              <th scope="col" class="whitespace-nowrap p-4 text-xs font-semibold uppercase text-fg-secondary text-center">Статус</th>
              <th scope="col" class="whitespace-nowrap p-4 text-xs font-semibold uppercase text-fg-secondary text-center">Створено</th>
              <th scope="col" class="whitespace-nowrap p-4 text-xs font-semibold uppercase text-fg-secondary text-right">Дії</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% epub_export_requests.each do |export_request| %>
              <tr class="hover:bg-brand-subtle transition-colors duration-200">
                <th scope="row" class="p-4 text-sm font-medium text-fg">
                  <%= export_request.filename.presence || export_request.volume_title.presence || "EPUB ##{export_request.id}" %>
                </th>
                <td class="p-4 text-center text-sm text-fg-muted"><%= export_request.status_label %></td>
                <td class="whitespace-nowrap p-4 text-center text-sm text-fg-muted">
                  <%= l(export_request.created_at, format: :short_datetime) %>
                </td>
                <td class="p-4 text-right">
                  <% if export_request.downloadable? %>
                    <%= ui_button(as: :link,
                                  href: url_for(controller: :downloads, action: :epub_export_file, token: export_request.token, only_path: true),
                                  size: :lg,
                                  label: 'Завантажити',
                                  html: { data: { turbo: false } }) %>
                  <% elsif export_request.failed? %>
                    <span class="text-sm text-status-danger-solid"><%= export_request.error_message.presence || t('downloads.alerts.error') %></span>
                  <% else %>
                    <span class="text-sm text-fg-muted">Готується...</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="space-y-3 p-4 sm:hidden">
        <% epub_export_requests.each do |export_request| %>
          <article class="rounded-lg border border-line bg-card p-4 shadow-sm">
            <p class="font-medium text-fg"><%= export_request.filename.presence || export_request.volume_title.presence || "EPUB ##{export_request.id}" %></p>
            <p class="mt-1 text-sm text-fg-muted"><%= l(export_request.created_at, format: :short_datetime) %> · <%= export_request.status_label %></p>
            <div class="mt-3">
              <% if export_request.downloadable? %>
                <%= ui_button(as: :link,
                              href: url_for(controller: :downloads, action: :epub_export_file, token: export_request.token, only_path: true),
                              size: :lg,
                              label: 'Завантажити',
                              html: { data: { turbo: false } }) %>
              <% elsif export_request.failed? %>
                <span class="text-sm text-status-danger-solid"><%= export_request.error_message.presence || t('downloads.alerts.error') %></span>
              <% else %>
                <span class="text-sm text-fg-muted">Готується...</span>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="rounded-lg border border-line bg-card p-8 text-center shadow-sm relative overflow-hidden">
      <%= render 'shared/ornament' %>
      <div class="mx-auto h-16 w-16 rounded-full bg-brand-subtle flex items-center justify-center mb-4 relative z-10">
        <svg class="h-8 w-8 text-fg-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 16V4m0 12-4-4m4 4 4-4M5 20h14" />
        </svg>
      </div>
      <h3 class="mb-2 text-lg font-semibold text-fg relative z-10">У вас ще немає EPUB-завантажень</h3>
      <p class="text-fg-muted relative z-10">Коли ви створите EPUB, він з'явиться тут.</p>
    </div>
  <% end %>
</div>
