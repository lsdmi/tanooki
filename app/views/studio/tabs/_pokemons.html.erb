<%# One column, fight-first: season whisper → duel stage → party dock → quiet footer. %>
<div id="section" class="mx-auto flex w-full max-w-xl flex-col gap-8 md:gap-10">
  <% if (season = PokemonSeason.current) %>
    <%= render 'users/pokemons/season_banner', season:, dex_leaderboard: pokemon_show.dex_leaderboard %>
  <% end %>

  <%= turbo_frame_tag "pokemon-leaderboard-screen", class: 'min-w-0', style: 'view-transition-name: pokemon-challenge; view-transition-class: pokemon-panel' do %>
    <%= render 'users/pokemons/dex_leaderboard', dex_leaderboard: pokemon_show.dex_leaderboard, opponent: pokemon_show.opponent,
                                                cooldown: pokemon_show.leaderboard_cooldown?,
                                                can_reroll: pokemon_show.reroll_available?,
                                                has_party: pokemon_show.pokemons.any? %>
  <% end %>

  <%= turbo_frame_tag "pokemon-data-screen", class: 'min-w-0' do %>
    <%= render 'users/pokemons/list', pokemons: pokemon_show.pokemons, selected_pokemon: pokemon_show.selected_pokemon, evolution: pokemon_show.evolution %>
  <% end %>

  <footer class="flex flex-col gap-8 border-t border-line pt-8">
    <%= render 'users/pokemons/battle_history', battle_history: pokemon_show.battle_history %>
    <%= render 'users/pokemons/top_trainers', top: pokemon_show.top_trainers, dex_leaderboard: pokemon_show.dex_leaderboard %>
  </footer>
</div>
