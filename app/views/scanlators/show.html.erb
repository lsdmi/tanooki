<% donation_url = @scanlator.donation_url %>
<% extra_link_url = @scanlator.extra_link_url %>
<% scanlator_has_links = @scanlator.telegram_id? || donation_url.present? || extra_link_url.present? %>
<% scanlator_link_class = 'underline font-medium text-fg-brand hover:text-fg-brand-hover break-words' %>
<% scanlator_social_btn = [
     'group inline-flex size-11 items-center justify-center rounded-full',
     'token-raw bg-white/35 text-fg-secondary shadow-sm ring-1 ring-zinc-950/25 backdrop-blur-sm',
     'transition duration-200 ease-out',
     'token-raw hover:bg-white/70 hover:text-fg hover:shadow-md hover:ring-zinc-950/35',
     'motion-safe:hover:-translate-y-0.5 active:translate-y-0 active:scale-95',
     'focus:outline-none focus-visible:ring-2 focus-visible:ring-brand',
     'token-raw dark:bg-zinc-950/25 dark:ring-white/30 dark:hover:bg-zinc-950/55 dark:hover:ring-white/40'
   ].join(' ') %>
<% scanlator_social_icon = 'size-5 shrink-0 transition duration-200 ease-out' %>
<% scanlator_social_icon_send = "#{scanlator_social_icon} motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5" %>
<% scanlator_social_icon_heart = "#{scanlator_social_icon} motion-safe:group-hover:scale-110 group-hover:fill-current" %>
<% scanlator_social_icon_link = "#{scanlator_social_icon} motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5" %>
<% scanlator_stat_chip = 'token-raw inline-flex items-center gap-1.5 rounded-lg border border-zinc-500 bg-white/40 px-3 py-1.5 text-sm backdrop-blur-sm dark:border-zinc-400/80 dark:bg-zinc-950/35' %>
<% scanlator_banner_src = @scanlator.banner.attached? ? scanlator_banner_url(@scanlator.banner) : nil %>

<div class="relative min-h-screen overflow-hidden bg-page">
  <% if scanlator_banner_src.blank? %>
    <%= tag.div **lazy_decoration_background(
          'psyduck_background.webp',
          html_class: 'pointer-events-none absolute inset-0 bg-cover bg-center bg-no-repeat bg-fixed',
          aria: { hidden: true }
        ) %>
    <div class="pointer-events-none absolute inset-0 bg-page/95 dark:bg-page/90" aria-hidden="true"></div>
  <% else %>
    <%# Full-page strip behind content; wash fades the art out by the bottom of the page. %>
    <div class="scanlator-show__banner pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
      <%= image_tag scanlator_banner_src,
                    alt: '',
                    class: 'absolute inset-0 size-full object-cover object-[50%_20%]' %>
      <div class="absolute inset-0 bg-linear-to-b from-page/75 via-page/95 via-[28%] to-page dark:from-page/70 dark:via-page/92 dark:via-[28%]"></div>
    </div>
  <% end %>

  <header class="relative z-10">
    <div class="relative mx-auto flex max-w-screen-xl flex-col items-center gap-4 px-4 pt-10 pb-6 md:flex-row md:items-start md:gap-6 md:pt-14 md:pb-8 2xl:px-0">
      <div class="size-40 shrink-0 overflow-hidden rounded-full bg-surface-strong">
        <%= image_tag scanlator_avatar_url(@scanlator.avatar),
                      alt: @scanlator.title,
                      class: 'size-full object-cover' %>
      </div>

      <div class="flex min-w-0 flex-1 flex-col gap-2 text-center md:max-w-2xl md:text-left">
        <h1 class="text-xl font-bold tracking-tight text-fg md:text-2xl"><%= @scanlator.title %></h1>

        <% if @scanlator.description? %>
          <div class="text-sm leading-relaxed text-pretty text-fg-secondary md:text-base">
            <%= linkify_urls(@scanlator.description, link_class: scanlator_link_class) %>
          </div>
        <% end %>

        <ul class="mt-1 flex flex-wrap justify-center gap-2 md:justify-start">
          <li class="<%= scanlator_stat_chip %>">
            <span class="font-semibold tabular-nums text-fg"><%= format_view_count(@scanlator_stats.chapters_count) %></span>
            <span class="text-fg-secondary">Розділів</span>
          </li>
          <li class="<%= scanlator_stat_chip %>">
            <span class="font-semibold tabular-nums text-fg"><%= format_view_count(@scanlator_stats.total_views) %></span>
            <span class="text-fg-secondary">Прочитань</span>
          </li>
          <li class="<%= scanlator_stat_chip %>">
            <span class="font-semibold tabular-nums text-status-danger-subtle-fg"><%= format_view_count(@scanlator_stats.total_thanks_count) %></span>
            <span class="text-fg-secondary"><%= t('chapters.thanks.scanlator_label') %></span>
          </li>
          <% if @scanlator_stats.active_recently? %>
            <li class="<%= scanlator_stat_chip %> font-medium text-status-success-subtle-fg">
              Активна
            </li>
          <% else %>
            <li class="<%= scanlator_stat_chip %> text-fg-secondary">
              Неактивна
            </li>
          <% end %>
          <% if @scanlator_stats.average_rating.to_f.positive? %>
            <li class="<%= scanlator_stat_chip %>">
              <%= stroke_icon(:star, 'size-3.5 fill-amber-400 text-amber-400') %>
              <span class="font-semibold tabular-nums text-fg"><%= number_with_precision(@scanlator_stats.average_rating, precision: 1) %></span>
            </li>
          <% end %>
        </ul>

        <% if @members.any? %>
          <ul class="mt-3 flex flex-wrap items-center justify-center gap-y-2 -space-x-2 md:justify-start" aria-label="Учасники">
            <% @members.each do |member| %>
              <li>
                <%= link_to profile_path(member.sqid),
                            class: 'relative inline-flex size-8 overflow-hidden rounded-full bg-surface-strong ring-2 ring-page transition hover:z-10 hover:ring-brand focus:outline-none focus-visible:z-10 focus-visible:ring-brand',
                            title: member.name,
                            aria: { label: member.name } do %>
                  <%= image_tag avatar_image_url(member.avatar.image),
                                alt: '',
                                class: 'size-full object-cover',
                                loading: 'lazy',
                                decoding: 'async' %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>

      <% if scanlator_has_links %>
        <div class="flex flex-wrap justify-center gap-2 md:ml-auto md:justify-end">
          <% if @scanlator.telegram_id? %>
            <% telegram_label = "Telegram @#{@scanlator.telegram_id}" %>
            <%= link_to telegram_profile_url(@scanlator.telegram_id),
                        target: '_blank',
                        rel: 'noopener noreferrer',
                        class: scanlator_social_btn,
                        title: telegram_label,
                        aria: { label: telegram_label } do %>
              <%= stroke_icon(:send, scanlator_social_icon_send) %>
            <% end %>
          <% end %>
          <% if donation_url %>
            <% donation_label = t('chapters.reader_support_card.support', service: @scanlator.donation_service) %>
            <%= link_to donation_url,
                        target: '_blank',
                        rel: 'noopener noreferrer',
                        class: "#{scanlator_social_btn} text-status-danger-solid hover:text-status-danger-solid",
                        title: donation_label,
                        aria: { label: donation_label } do %>
              <%= stroke_icon(:heart, scanlator_social_icon_heart) %>
            <% end %>
          <% end %>
          <% if extra_link_url %>
            <% extra_label = scanlator_extra_link_label(extra_link_url) %>
            <%= link_to extra_link_url,
                        target: '_blank',
                        rel: 'noopener noreferrer',
                        class: scanlator_social_btn,
                        title: extra_label,
                        aria: { label: extra_label } do %>
              <%= stroke_icon(:external_link, scanlator_social_icon_link) %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </header>

  <div class="relative z-10 mx-auto max-w-screen-xl space-y-10 px-4 pb-16 2xl:px-0">
    <% if @scanlator.notice? %>
      <section class="border-t border-line-strong pt-6">
        <h2 class="text-sm font-medium text-fg-muted">Оголошення</h2>
        <div class="mt-1.5 text-base leading-relaxed text-fg">
          <%= linkify_urls(@scanlator.notice, link_class: scanlator_link_class) %>
        </div>
      </section>
    <% end %>

    <section>
      <h2 class="sr-only">Твори</h2>
      <%= render 'scanlators/works_catalog', fictions: @fictions, pagy: @pagy, scanlator: @scanlator %>
    </section>
  </div>
</div>
