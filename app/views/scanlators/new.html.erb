<section class="bg-page z-10 relative min-h-screen">
  <div class="py-8 px-4 sm:px-6 md:px-12 lg:px-24 mx-auto lg:py-12" data-controller="dropzone">
    <!-- Header -->
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-bold text-fg mb-3">Додати Профіль Перекладача</h1>
      <p class="text-lg text-fg-muted max-w-2xl mx-auto">Додайте профіль вашої команди перекладачів!</p>
    </div>

    <% if @return_to %>
      <%= render Ui::NoticeComponent.new(kind: :announced, title: t('scanlators.new.chapter_hint'), html: { class: 'mb-6 rounded-xl' }) %>
    <% end %>

    <!-- Form Container -->
    <div class="bg-card rounded-2xl border border-line shadow-lg p-8">
      <%= simple_form_for @scanlator, as: :scanlator, url: scanlators_path, method: :post, html: { class: "form", multipart: true }, data: { turbo: false } do |f| %>
        <%= hidden_field_tag :return_to, @return_to if @return_to %>
        <%= render 'form', scanlator: @scanlator, f: f %>
      <% end %>
    </div>
  </div>
</section>
