<section class="bg-page z-10 relative min-h-screen">
  <div class="py-8 px-4 sm:px-6 md:px-12 lg:px-24 mx-auto lg:py-12" data-controller="dropzone">
    <!-- Header -->
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-bold text-fg mb-3">Оновити Профіль Перекладача</h1>
      <p class="text-lg text-fg-muted max-w-2xl mx-auto">Відредагуйте профіль, щоб він став ще кращим!</p>
    </div>

    <!-- Form Container -->
    <div class="bg-card rounded-2xl border border-line shadow-lg p-8">
      <%= simple_form_for @scanlator, as: :scanlator, url: scanlator_path(@scanlator), method: :put, html: { class: "form", multipart: true }, data: { turbo: false } do |f| %>
        <%= render 'form', scanlator: @scanlator, f: f %>
      <% end %>
    </div>
  </div>
</section>
