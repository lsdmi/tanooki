<% page_gutter = 'mx-5 md:mx-6 lg:mx-4' %>

<div class="relative z-10">
  <section class="mx-auto xl:w-[1300px]">
    <div class="<%= page_gutter %> pb-8 pt-4">
      <section class="my-10">
      <p class="drop-shadow uppercase leading-5 text-gray-900 dark:text-gray-100 text-lg sm:text-xl lg:text-2xl font-extrabold mb-4 ">
        Останні <span class="text-cyan-800 dark:text-rose-700">Оновлення</span>
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 gap-y-8 py-2">
        <% @latest.each_with_index do |video, idx| %>
          <div class="<%= idx >= 2 ? 'hidden md:block' : '' %> overflow-hidden">
            <%= link_to youtube_video_path(video), class: 'block w-full aspect-[16/9] mb-2 overflow-hidden rounded-lg shadow-sm' do %>
              <div data-controller="lazy-image" data-lazy-image-image-id="<%= video.id %>" class="relative">
                <div id="spinner-<%= video.id %>" class="absolute inset-0 flex items-center justify-center bg-gray-200 dark:bg-gray-700 rounded-md">
                  <!-- Spinner SVG or content here -->
                </div>
                <%= image_tag video_thumbnail_url(video.thumbnail),
                  alt: video.title,
                  id: "image-#{video.id}",
                  width: 374,
                  height: 210,
                  class: "w-full h-full object-cover rounded-md shadow-sm transition duration-300 transform hover:scale-105 opacity-0",
                  loading: "lazy",
                  data: { url: video_thumbnail_url(video.thumbnail) } %>
              </div>
            <% end %>
            <div class="py-2 px-2">
              <%= link_to video.title, youtube_video_path(video), class: 'drop-shadow lg:leading-tight text-sm sm:text-xs lg:text-lg font-semibold text-stone-800 dark:text-gray-200 line-clamp-1 hover:text-cyan-700 dark:hover:text-rose-700 transition-colors duration-300 mb-1 line-clamp-1' %>
              <p class="drop-shadow text-stone-700 dark:text-gray-300 text-xs lg:text-sm my-2 line-clamp-1">
                <%= link_to video.youtube_channel.title, search_index_path(search: [video.youtube_channel.title]), class: 'inline text-stone-800 dark:text-gray-200 line-clamp-1 hover:text-cyan-700 dark:hover:text-rose-700 transition-colors duration-300' %> •
                <%= tag.span l(video.published_at, format: :short).downcase, class: 'inline' %>
              </p>
              <% if video.tags? %>
                <%= render Ui::TagListComponent.new(
                      labels: Search::TagCounts.labels_from_youtube_video(
                        video,
                        limit: Search::TagCounts::INDEX_LATEST_YOUTUBE_TAG_LIMIT
                      ),
                      variant: :keyword,
                      size: :sm,
                      max: 3,
                      href_builder: ->(video_tag) { search_index_path(search: [video_tag]) },
                      counts: @video_tag_counts
                    ) %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      </section>

      <section class="youtube-index__hero mb-10">
      <div class="flex flex-col gap-3 lg:hidden">
        <%= render 'root/videos_featured_player', video: @highlight %>
        <%= render 'root/videos_featured_meta', video: @highlight, video_tag_counts: @video_tag_counts %>

        <%= render 'video_list_mobile',
                   other_youtube_videos: @other_youtube_videos,
                   pagy: @pagy,
                   video_tag_counts: @video_tag_counts %>
      </div>

      <div class="hidden lg:grid lg:grid-cols-[minmax(0,1.65fr)_minmax(0,1fr)] lg:grid-rows-[auto_auto] lg:items-stretch lg:gap-x-4 lg:gap-y-3"
           role="group"
           aria-label="Обране відео">
        <%= render 'root/videos_featured_player', video: @highlight %>

        <div class="min-w-0 lg:col-start-1 lg:row-start-2">
          <%= render 'root/videos_featured_meta', video: @highlight, video_tag_counts: @video_tag_counts %>
        </div>

        <%= render 'video_list',
                   other_youtube_videos: @other_youtube_videos,
                   pagy: @pagy,
                   video_tag_counts: @video_tag_counts %>
      </div>
      </section>

      <% if adsense_slot_renderable?(:youtube_index) %>
        <section class="youtube-index__ad mx-auto m-0 w-full max-w-3xl empty:hidden has-[.reader-ad-slot--adsense-filled]:mb-10 has-[.reader-ad-slot--preview]:mb-10 has-[.reader-ad-slot--collapsed]:hidden [&:not(:has(.reader-ad-slot--preview))]:not(:has(.reader-ad-slot--adsense-filled))]:not(:has(.reader-ad-slot--measuring))]:not(:has(.reader-ad-slot--pending))]:hidden [&_.reader-ad-slot--measuring:not(.reader-ad-slot--adsense-filled)_.reader-ad-slot__frame]:min-h-0 [&_.reader-ad-slot--measuring:not(.reader-ad-slot--adsense-filled)_.reader-ad-slot__frame]:max-h-none">
        <%= render 'shared/adsense_slot',
                   placement: :youtube_index,
                   navigation_key: 'index',
                   measure_as: 'bottom' %>
        </section>
      <% end %>

      <section>
      <p class="drop-shadow uppercase leading-5 text-gray-900 dark:text-gray-100 text-lg sm:text-xl lg:text-2xl font-extrabold mb-4">
        Популярні <span class="text-cyan-700 dark:text-rose-700">Відео</span>
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-6 gap-y-4 lg:gap-y-8">
        <% @popular.each do |video| %>
          <%= render 'single_video', video: %>
        <% end %>
      </div>
      </section>
    </div>
  </section>
</div>
