<%# locals: (other_youtube_videos:, pagy:, video_tag_counts:) %>
<%= turbo_frame_tag 'video-list', class: 'contents' do %>
  <div class="flex min-h-0 flex-col gap-4 lg:col-start-2 lg:row-start-1">
    <% other_youtube_videos.each do |video| %>
      <%= render 'root/videos_card', video:, video_tag_counts:, variant: :compact %>
    <% end %>
  </div>

  <div class="youtube-index__pagination mt-4 lg:col-start-2 lg:row-start-2 lg:mt-0">
    <%= ui_pagination(pagy, frame_id: 'video-list', html: { class: 'mt-0' }) %>
  </div>
<% end %>
