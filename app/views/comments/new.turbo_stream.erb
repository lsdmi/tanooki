<% drawer = @commentable.is_a?(Chapter) %>
<%= turbo_stream.update "comment-reply-#{@comment.parent_id}" do %>
  <%= simple_form_for @comment, url: comments_path, method: :post, html: { class: 'comment form' } do |f| %>
    <%= render "comments/new", comment: @comment, commentable: @commentable, f: f, drawer: drawer %>
  <% end %>
<% end %>
<%= turbo_stream.update "comment-content-#{@comment.parent_id}" do %>
  <%= tag.p @comment.parent_content, class: drawer ? 'text-fg-secondary text-sm leading-relaxed pr-4 pb-2' : Comments::PresentationHelper::COMMENT_TEXT_CLASS %>
<% end %>
