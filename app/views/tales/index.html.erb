<div class="mx-auto w-full max-w-screen-xl px-4 py-6 2xl:px-0">
  <header class="mb-6">
    <h1 class="text-xl font-semibold uppercase tracking-tight text-fg sm:text-2xl">
      Новини та <span class="text-brand">блоги</span>
    </h1>
  </header>

  <%= render 'publication_tiles',
             publications: @highlights,
             publication_tag_counts: @publication_tag_counts,
             ad_placement: :tales_index %>

  <section class="<%= 'border-t border-line/70 dark:border-line/50 pt-1' if @highlights.any? %>">
    <%= render 'publication_tiles',
               publications: @publications,
               publication_tag_counts: @publication_tag_counts,
               tile_offset: @highlights.size,
               ad_placement: :tales_index %>
    <%= render 'home/next_page', pagy: @pagy %>
  </section>
</div>
