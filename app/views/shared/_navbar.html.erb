<nav class="relative z-50 border-b border-line bg-main antialiased shadow-md">
  <div class="mx-auto max-w-screen-xl px-4 2xl:px-0">
    <%# Fixed row height so chrome does not jump between pages (logo h-9 / md:h-12). %>
    <div class="flex h-14 items-center justify-between gap-2 sm:gap-3 md:h-16">
      <% cache navbar_fragment_cache_key(:brand), expires_in: 1.hour do %>
        <%= render "shared/navbar_brand" %>
      <% end %>

      <%# Not fragment-cached: icon markup must not stick behind an hourly key. %>
      <%= render "shared/navbar_nav_links" %>

      <div class="flex shrink-0 items-center justify-end md:space-x-2">
        <% cache navbar_fragment_cache_key(:toolbar), expires_in: 1.hour do %>
          <%= render "shared/navbar_toolbar" %>
        <% end %>
        <%= render "shared/navbar_auth" %>
      </div>
    </div>
  </div>
</nav>

<% cache navbar_fragment_cache_key(:search_modal), expires_in: 1.hour do %>
  <%= render "shared/navbar_search_modal" %>
<% end %>
