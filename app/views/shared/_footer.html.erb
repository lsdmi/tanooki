<% cache footer_fragment_cache_key, expires_in: 12.hours do %>
<footer class="token-raw bg-zinc-900 border-t border-zinc-200 dark:border-zinc-700">
  <div class="mx-auto flex w-full max-w-[1300px] flex-col gap-5 px-5 py-6 md:px-6 lg:px-4">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
      <a href="/" class="inline-flex shrink-0 items-center">
        <%= image_tag 'logo-dark.webp',
                      class: 'h-10 w-auto transition duration-500 hover:scale-105 sm:h-12',
                      alt: 'logo',
                      width: '294',
                      height: '112',
                      loading: 'lazy',
                      decoding: 'async' %>
      </a>
      <nav class="token-raw flex flex-wrap gap-x-5 gap-y-2 text-sm text-zinc-300 sm:justify-end" aria-label="Про сайт">
        <%= link_to about_path, class: 'hover:text-white hover:underline underline-offset-2', title: 'Про Баку — baka.in.ua' do %>
          Про Бака
        <% end %>
        <%= link_to friends_path, class: 'hover:text-white hover:underline underline-offset-2', title: 'Друзі Баки — baka.in.ua' do %>
          Друзі
        <% end %>
        <%= link_to rules_path, class: 'hover:text-white hover:underline underline-offset-2', title: 'Правила спільноти — baka.in.ua' do %>
          Правила
        <% end %>
        <%= link_to api_docs_path, class: 'hover:text-white hover:underline underline-offset-2', title: 'API для команд — baka.in.ua' do %>
          API
        <% end %>
        <%= link_to telegram_site_url, class: 'hover:text-white hover:underline underline-offset-2', title: 'Контакти (Telegram) — baka.in.ua', rel: 'noopener noreferrer', target: '_blank' do %>
          Контакти
        <% end %>
      </nav>
    </div>
    <div class="token-raw flex flex-col gap-2 border-t border-zinc-800 pt-4 text-xs text-zinc-500 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
      <p>
        © 2023-<%= Time.zone.now.year %>
        <a href="/" class="token-raw hover:text-zinc-300 hover:underline">baka.in.ua™</a>.
        Всі права захищені.
      </p>
      <nav class="token-raw flex flex-wrap gap-x-4 gap-y-1" aria-label="Юридична інформація">
        <%= link_to privacy_path, class: 'token-raw hover:text-zinc-300 hover:underline underline-offset-2', title: 'Політика конфіденційності — baka.in.ua' do %>
          Конфіденційність
        <% end %>
        <%= link_to privacy_path(anchor: 'cookies'), class: 'token-raw hover:text-zinc-300 hover:underline underline-offset-2', title: 'Політика cookies — baka.in.ua' do %>
          Cookies
        <% end %>
      </nav>
    </div>
  </div>
</footer>
<% end %>
