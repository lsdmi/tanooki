      <div class="lg:order-1 shrink-0">
        <% theme = cookies[:color_theme] || 'light' %>
        <a href="/" class="flex items-center">
          <%= image_tag(
                theme == 'dark' ? 'logo-dark-nav.webp' : 'logo-default-nav.webp',
                id: 'site-logo',
                class: 'mr-3 h-9 md:h-12 w-auto',
                alt: 'logo',
                width: '105',
                height: '36',
                data: {
                  "default-logo": asset_path('logo-default-nav.webp'),
                  "dark-logo": asset_path('logo-dark-nav.webp')
                }
              ) %>
        </a>
      </div>
