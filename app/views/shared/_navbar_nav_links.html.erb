      <div class="w-full md:flex md:items-center md:justify-center lg:order-2">
        <nav class="flex relative items-center justify-center gap-1 p-2 rounded-lg sm:gap-2" aria-label="Основна навігація">
          <% show_contests = contests_publicly_visible? %>
          <% cue = contests_navbar_cue if show_contests %>
          <div class="relative">
            <button id="ranobeNavButton"
                    type="button"
                    data-dropdown-toggle="ranobeNavDropdown"
                    data-dropdown-placement="bottom"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-controls="ranobeNavDropdown"
                    class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-fg rounded-lg
                           hover:text-fg-secondary hover:bg-surface-hover
                           focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
              Ранобе
              <% if show_contests && cue.hot? %>
                <span class="size-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true"></span>
                <span class="sr-only"><%= t('contests.nav.hot_sr') %></span>
              <% end %>
              <svg class="size-3.5 shrink-0 text-fg-muted" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19 9-7 7-7-7" />
              </svg>
            </button>

            <div id="ranobeNavDropdown"
                 class="z-50 hidden w-64 divide-y divide-line overflow-hidden rounded-lg bg-card shadow-lg dark:bg-surface-strong"
                 role="menu"
                 aria-labelledby="ranobeNavButton">
              <div class="p-1.5">
                <%= link_to fictions_path,
                            role: 'menuitem',
                            class: 'block rounded-md px-3 py-2 text-sm font-medium text-fg
                                    hover:bg-surface-hover
                                    focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand' do %>
                  Головна
                <% end %>
                <% if show_contests %>
                  <%= link_to contests_path,
                              role: 'menuitem',
                              class: 'block rounded-md px-3 py-2 hover:bg-surface-hover
                                      focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand' do %>
                    <span class="block text-sm font-medium text-fg"><%= t('contests.nav.label') %></span>
                    <span class="mt-0.5 block text-xs font-normal text-fg-muted"><%= cue.subtitle %></span>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>

          <%= link_to calendar_fictions_path,
                      class: 'inline-flex items-center px-3 py-2 text-sm font-medium text-fg rounded-lg
                              hover:text-fg-secondary hover:bg-surface-hover
                              focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand' do %>
            Календар
          <% end %>
          <%= link_to alphabetical_fictions_path,
                      class: 'inline-flex items-center px-3 py-2 text-sm font-medium text-fg rounded-lg
                              hover:text-fg-secondary hover:bg-surface-hover
                              focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand' do %>
            Сховище
          <% end %>
        </nav>
      </div>
