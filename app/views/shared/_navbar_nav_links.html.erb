<%
  nav_items = [
    { path: fictions_path, label: 'Ранобе', icon: :book },
    { path: calendar_fictions_path, label: 'Календар', icon: :calendar },
    { path: alphabetical_fictions_path, label: 'Сховище', icon: :library }
  ]
  nav_link_class = %w[
    relative inline-flex h-full items-center justify-center px-2 text-sm font-medium text-fg sm:px-3
    transition-colors duration-200
    after:pointer-events-none after:absolute after:inset-x-1.5 after:bottom-0 after:h-0.5
    after:origin-center after:scale-x-0 after:rounded-full after:bg-brand after:content-['']
    after:transition-transform after:duration-200 motion-reduce:after:transition-none
    hover:text-fg-brand hover:after:scale-x-100
    focus-visible:text-fg-brand focus-visible:after:scale-x-100
    focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand
    aria-[current=page]:text-fg-brand aria-[current=page]:after:scale-x-100
    motion-reduce:transition-none
  ].join(' ')
%>
<div class="flex h-full min-w-0 flex-1 items-stretch justify-end sm:justify-center">
  <nav class="flex h-full items-stretch gap-0.5 sm:gap-1" aria-label="Основна навігація">
    <% nav_items.each do |item| %>
      <% active = current_page?(item[:path]) %>
      <div class="group relative flex h-full">
        <%= link_to item[:path],
                    class: nav_link_class,
                    aria: { label: item[:label], **(active ? { current: 'page' } : {}) } do %>
          <span class="sm:hidden">
            <%= navbar_icon(item[:icon], 'h-4 w-4 shrink-0') %>
          </span>
          <span class="hidden sm:inline"><%= item[:label] %></span>
        <% end %>
        <span class="pointer-events-none absolute left-1/2 z-30 -translate-x-1/2 whitespace-nowrap rounded-md bg-invert px-2 py-1 text-xs/5 text-fg-on-invert opacity-0 shadow-popover transition-opacity group-hover:opacity-100 group-focus-within:opacity-100 sm:hidden"
              style="top: calc(100% + 6px)"
              role="tooltip"><%= item[:label] %></span>
      </div>
    <% end %>
  </nav>
</div>
