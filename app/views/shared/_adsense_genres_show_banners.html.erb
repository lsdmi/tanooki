<%# locals: (wrapper_class: "") %>
<%# Dual genres-show banner row: stacked on mobile, side-by-side on sm+ (same as fictions index). %>
<% return unless adsense_genres_show_banners_renderable? %>

<section class="index-banners <%= wrapper_class %>" aria-label="Реклама">
  <div class="index-banners__grid">
    <% Adsense::GENRES_SHOW_BANNER_PLACEMENTS.each do |placement, navigation_key| %>
      <div class="index-banners__slot">
        <%# measure_as bottom buys the longer fill window; both cells sit at the same height. %>
        <%= render 'shared/adsense_slot', placement:, navigation_key:, measure_as: 'bottom' %>
      </div>
    <% end %>
  </div>
</section>
