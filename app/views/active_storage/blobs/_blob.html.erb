<figure class="attachment attachment--<%= blob.representable? ? "preview" : "file" %> attachment--<%= blob.filename.extension %>">
  <% blob_alt = blob.try(:caption).presence || t('activestorage.blob.image_alt') %>
  <% if blob.representable? && ReadOnlyStorage.covers?(blob.service_name) %>
    <%= image_tag blob, alt: blob_alt if blob.image? %>
  <% elsif blob.representable? %>
    <%= image_tag blob.representation(resize_to_limit: local_assigns[:in_gallery] ? [ 800, 600 ] : [ 1024, 768 ]), alt: blob_alt %>
  <% end %>

  <% if caption = blob.try(:caption) %>
    <figcaption class="attachment__caption">
      <%= caption %>
    </figcaption>
  <% end %>
</figure>
