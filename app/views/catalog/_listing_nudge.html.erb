<%# locals: (fiction:, wrapper_class: nil, field_links: :edit_path) %>
<% nudge = Catalog::ListingNudge.for(fiction) %>
<% if nudge %>
  <% link_kinds = [Catalog::ListingNudge::OPTIONAL_EXPECTED, Catalog::ListingNudge::MISSING_GENRES] %>
  <% text_action_class = 'text-sm text-stone-500 underline-offset-2 hover:text-stone-800 hover:underline dark:text-zinc-400 dark:hover:text-zinc-200' %>
  <% expected_href = field_links == :fragment ? '#fiction_expected_chapters' : edit_fiction_path(fiction, anchor: 'fiction_expected_chapters') %>
  <% genres_href = field_links == :fragment ? '#fiction_genre_ids' : edit_fiction_path(fiction, anchor: 'fiction_genre_ids') %>
  <% primary_url = case nudge.kind
                   when Catalog::ListingNudge::POSTED_AFTER_COMPLETE then reopen_fiction_listing_nudge_path(fiction)
                   when Catalog::ListingNudge::STALE_PLAN then raise_expected_fiction_listing_nudge_path(fiction)
                   when Catalog::ListingNudge::OPTIONAL_EXPECTED then expected_href
                   when Catalog::ListingNudge::MISSING_GENRES then genres_href
                   when Catalog::ListingNudge::ADULT_CONTENT then mark_adult_fiction_listing_nudge_path(fiction)
                   else complete_fiction_listing_nudge_path(fiction)
                   end %>
  <section class="rounded-lg border border-stone-200 bg-stone-50/70 p-4 dark:border-zinc-700 dark:bg-zinc-900/40 sm:p-5 <%= wrapper_class %>" aria-label="<%= t("fictions.listing_nudges.#{nudge.kind}.title") %>">
    <h2 class="mb-1 text-sm font-semibold text-stone-900 dark:text-zinc-100">
      <%= t("fictions.listing_nudges.#{nudge.kind}.title") %>
    </h2>
    <p class="mb-3 text-sm leading-snug text-stone-600 dark:text-zinc-400">
      <%= t("fictions.listing_nudges.#{nudge.kind}.body", count: nudge.chapter_count, plan: nudge.expected_chapters) %>
    </p>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <% if link_kinds.include?(nudge.kind) %>
        <%= ui_button(as: :link, href: primary_url, size: :xs, label: t("fictions.listing_nudges.#{nudge.kind}.action"),
                      html: (field_links == :fragment ? {} : turbo_drive_visit_data)) %>
      <% else %>
        <%= form_with url: primary_url, method: :post, class: 'inline' do %>
          <%= ui_button(as: :submit, size: :xs, label: t("fictions.listing_nudges.#{nudge.kind}.action")) %>
        <% end %>
      <% end %>
      <% if nudge.kind == Catalog::ListingNudge::STALE_PLAN %>
        <%= form_with url: clear_expected_fiction_listing_nudge_path(fiction), method: :post, class: 'inline' do %>
          <%= button_tag t('fictions.listing_nudges.stale_plan.clear'), type: :submit, class: text_action_class %>
        <% end %>
      <% end %>
      <%= form_with url: dismiss_fiction_listing_nudge_path(fiction), method: :post, class: 'inline' do %>
        <%= button_tag t("fictions.listing_nudges.#{nudge.kind}.dismiss"), type: :submit, class: text_action_class %>
      <% end %>
    </div>
  </section>
<% end %>
