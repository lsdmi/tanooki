<%# locals: fiction:, order: :asc, reader_drawer: false (optional), current_chapter: nil (optional), continue_chapter: nil (optional) %>
<% list_order = local_assigns.fetch(:order, :asc) %>
<% reader_drawer = local_assigns.fetch(:reader_drawer, false) %>
<% current_chapter_id = local_assigns[:current_chapter]&.id %>
<% continue_chapter = local_assigns[:continue_chapter] unless reader_drawer %>
<% sections = chapter_list_section_index(fiction, order: list_order, viewer: current_user) %>
<% open_section_key = chapter_list_open_section_key(sections, continue_chapter) unless reader_drawer %>
<% drawer_accordion_opened = false %>
<% lazy_page_sizes = {} %>
<% unless reader_drawer %>
  <% lazy_page_sizes = { chapter_section_page_size: Fictions::ChapterSectionLoader::PAGE_SIZE, chapter_section_mobile_page_size: Fictions::ChapterSectionLoader::MOBILE_PAGE_SIZE } %>
  <% lazy_skeleton_rows = safe_join([render('fictions/chapter_row_skeleton')] * 4) %>
<% end %>
<% accordion_shell = if reader_drawer
  'border-b border-line last:border-b-0'
else
  # The outline sits on a pseudo-element: an inset ring on the card itself would be painted under the header fill.
  'relative rounded-xl after:pointer-events-none after:absolute after:inset-0 after:rounded-xl after:ring-1 after:ring-inset after:ring-line'
end %>
<% accordion_head = if reader_drawer
  'flex cursor-pointer items-center justify-between gap-2 px-4 py-3.5 hover:bg-surface'
else
  'bg-surface px-4 py-3 transition-colors hover:bg-surface-hover md:p-4'
end %>
<% accordion_body = if reader_drawer
  'border-0 bg-transparent'
else
  'bg-main'
end %>
<div class="<%= reader_drawer ? 'my-0' : 'flex flex-col gap-6 md:gap-5' %>" data-controller="chapters-accordion" data-chapters-accordion-root<%= ' data-chapters-accordion-default-open' if reader_drawer %> <%= tag.attributes(data: { chapters_accordion_focus_row_value: (dom_id(continue_chapter, :chapter_list) if continue_chapter), action: ('tabs:activated@window->chapters-accordion#tabActivated' if continue_chapter) }) %>>
  <% sections.each_with_index do |section, section_index| %>
    <% accordion_open = reader_drawer && !drawer_accordion_opened && (chapter_list_section_current?(section, current_chapter_id) || (current_chapter_id.nil? && section_index.zero?)) %>
    <% drawer_accordion_opened = true if accordion_open %>
    <% preload_section = accordion_open || (!reader_drawer && section[:section_key] == open_section_key) %>
    <% section_path = fiction_chapter_section_path(fiction, section[:section_key], order: list_order) %>
    <% section_chapter_ids = chapter_list_section_ids(section) %>
    <div class="accordion overflow-hidden <%= accordion_shell %>">
      <div class="accordion-header flex cursor-pointer items-center justify-between gap-2 <%= accordion_head %>"
           role="button"
           tabindex="0"
           aria-expanded="<%= preload_section || accordion_open ? 'true' : 'false' %>"
           data-action="click->chapters-accordion#toggle keydown.enter->chapters-accordion#toggle keydown.space->chapters-accordion#toggle">
        <h3 class="min-w-0 flex-1 truncate text-left <%= reader_drawer ? 'text-sm font-medium' : 'text-sm/5 font-semibold md:text-base/6' %> text-fg">
          <%= reader_drawer ? reader_drawer_section_title(section) : section[:title] %>
        </h3>
        <div class="flex shrink-0 items-center <%= reader_drawer ? 'gap-1' : 'gap-2 md:gap-3' %>">
          <% unless reader_drawer %>
            <% group_total = section[:chapter_keys].size %>
            <% if local_assigns[:drawer_progress]&.started? %>
              <% group_read = drawer_progress.read_count(section[:chapter_keys]) %>
              <%= render Ui::MiniProgressBarComponent.new(read: group_read, total: group_total, check: false, html: { class: 'w-8 md:w-13', aria: { hidden: true } }) %>
              <span class="whitespace-nowrap text-xs/5 text-fg-muted md:text-sm/5"><%= t('fictions.chapters_tab.progress', read: group_read, total: group_total) %></span>
              <% if group_read == group_total %>
                <%= render Ui::ProgressIconComponent.new(state: :read, size: :sm) %>
              <% end %>
            <% else %>
              <span class="whitespace-nowrap text-xs/5 text-fg-muted md:text-sm/5"><%= t('fictions.chapters_tab.count', count: group_total) %></span>
            <% end %>
          <% end %>
          <% if !reader_drawer && epub_download_available_for_section?(fiction, section_chapter_ids) %>
            <div class="-my-1.5 flex"
                 data-controller="epub-download"
                 data-epub-download-url-value="<%= epub_multiple_downloads_path %>"
                 data-epub-download-params-value="<%= { chapter_ids: section_chapter_ids, volume_title: section[:epub_title] }.to_json %>">
              <button data-epub-download-target="button"
                      data-action="click->epub-download#download"
                      class="flex h-8 min-w-8 items-center justify-center rounded-md px-2 text-fg-muted hover:bg-surface-hover hover:text-fg"
                      title="Завантажити EPUB">
                <%= stroke_icon(:download) %>
                <span class="sr-only">Завантажити EPUB</span>
              </button>
            </div>
          <% end %>
          <span class="accordion-icon transition-transform duration-200 <%= (preload_section || accordion_open) ? 'rotate-180 ' : '' %>text-fg-muted<%= ' transform hover:text-fg' unless reader_drawer %>" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="<%= reader_drawer ? 'h-5 w-5' : 'size-4' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </div>
      </div>
      <div class="accordion-content <%= preload_section ? '' : 'hidden' %> <%= accordion_body %>">
        <% if preload_section %>
          <%= render 'fictions/chapter_section_items',
                     chapters: if reader_drawer
                                 fiction_section_chapters(fiction, section, order: list_order, scanlators: false)
                               else
                                 fiction_section_first_page(fiction, section, order: list_order, through: continue_chapter)
                               end,
                     reader_drawer: reader_drawer,
                     current_chapter: local_assigns[:current_chapter],
                     drawer_progress: local_assigns[:drawer_progress],
                     total: section_chapter_ids.size,
                     section_url: section_path,
                     focus_chapter: continue_chapter %>
        <% else %>
          <% lazy_params = {} %>
          <% lazy_params[:reader_drawer] = true if reader_drawer %>
          <% lazy_params[:current_chapter_id] = current_chapter_id if current_chapter_id.present? %>
          <div data-chapter-section-url="<%= section_path %>"
               data-chapter-section-params="<%= lazy_params.to_json %>"
               <%= tag.attributes(data: lazy_page_sizes) %>>
            <% if reader_drawer %>
              <p class="px-4 py-3 text-sm text-fg-muted chapter-section-placeholder">Натисніть, щоб завантажити розділи…</p>
            <% else %>
              <ul class="chapter-section-placeholder grid grid-cols-1 gap-2 p-3 md:grid-cols-2" aria-busy="true" aria-label="<%= t('fictions.chapters_tab.pager.loading') %>">
                <%= lazy_skeleton_rows %>
              </ul>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
