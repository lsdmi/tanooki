<%# locals: chapter:, read:, marker: nil (row status; :in_progress keeps its marker on the button), current_chapter: nil, reader_drawer: true %>
<% reader_drawer = local_assigns.fetch(:reader_drawer, true) %>
<% label = t(read ? 'chapters.reader_chapter_drawer.mark_unread' : 'chapters.reader_chapter_drawer.mark_read') %>
<% icon_status = read ? :read : (local_assigns[:marker] == :in_progress ? :in_progress : :unread) %>
<% toggle_params = reader_drawer ? { current_chapter_id: current_chapter&.id }.compact : { fiction_list: 1 } %>
<% form_class = reader_drawer ? 'flex shrink-0 self-stretch' : 'relative flex shrink-0' %>
<% surface_class = reader_drawer ? 'px-4 hover:bg-surface' : 'size-8 justify-center rounded-full hover:bg-line' %>
<%= button_to chapter_read_path(chapter),
              method: read ? :delete : :post,
              params: toggle_params,
              form: {
                class: form_class,
                data: { turbo_stream: true, controller: 'read-toggle', action: 'turbo:submit-end->read-toggle#clearCache' }
              },
              class: "flex items-center transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-line-strong #{surface_class}",
              title: label,
              aria: { label: } do %>
  <%= chapter_progress_icon(icon_status, size: reader_drawer ? :md : :lg) %>
<% end %>
