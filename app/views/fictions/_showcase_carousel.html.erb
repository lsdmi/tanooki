<%# locals: showcase:, popular_novelty_ids:, top_fiction_ids:, latest_update_ids:, content_rail:, melt_top: %>
<% content_rail = local_assigns.fetch(:content_rail, true) %>
<% melt_top = local_assigns.fetch(:melt_top, false) %>
<% carousel_nav_visible = showcase.size > 1 %>
<% first_fiction = showcase.first %>
<% first_desktop_url = first_fiction && banner_showcase_url(first_fiction.banner) %>
<% first_mobile_url = first_fiction && banner_showcase_url(first_fiction.banner, size: :mobile) %>
<% first_lcp_url = first_mobile_url || first_desktop_url %>
<% eager_first_slide = first_lcp_url.present? %>
<%# Mikai-style veil + mask so art dissolves into the page (bottom always; top when nestled under a heading). %>
<%# Light theme: slight black wash under the page veil so banner art reads a bit darker. %>
<% slide_dim = 'absolute inset-0 z-[1] bg-black/22 dark:hidden' %>
<% slide_veil = 'absolute inset-0 z-[1] bg-linear-to-b from-main/72 via-main/84 to-main/96 dark:from-main/55 dark:via-main/75 dark:to-main/95' %>
<% art_melt = if melt_top
                '[mask-image:linear-gradient(to_bottom,transparent,#000_16%,#000_55%,transparent)] ' \
                  '[-webkit-mask-image:linear-gradient(to_bottom,transparent,#000_16%,#000_55%,transparent)]'
              else
                '[mask-image:linear-gradient(to_bottom,#000_55%,transparent)] ' \
                  '[-webkit-mask-image:linear-gradient(to_bottom,#000_55%,transparent)]'
              end %>
<%# Genre pages sit under a heading — a bit taller so the dual melt still leaves room for type. %>
<% slide_h = melt_top ? 'h-[23rem] md:h-[29rem]' : 'h-[20rem] md:h-[25rem]' %>
<% if eager_first_slide %>
  <% content_for :head do %>
    <% if first_mobile_url.present? && first_desktop_url.present? && first_mobile_url != first_desktop_url %>
      <%= tag.link rel: 'preload', as: 'image', href: first_mobile_url, fetchpriority: 'high',
                   media: '(max-width: 767px)' %>
      <%= tag.link rel: 'preload', as: 'image', href: first_desktop_url, fetchpriority: 'high',
                   media: '(min-width: 768px)' %>
    <% else %>
      <%= tag.link rel: 'preload', as: 'image', href: first_lcp_url, fetchpriority: 'high' %>
    <% end %>
  <% end %>
<% end %>
<% if showcase.blank? && current_content_filter.active? %>
  <section class="mx-auto max-w-[1300px] px-4 pt-8 pb-2" aria-label="Вітрина творів">
    <p class="px-2 text-sm font-medium text-fg-muted xl:px-0"><%= t('content_filters.empty') %></p>
  </section>
<% elsif showcase.present? %>
<section class="relative <%= melt_top ? '-mt-8 -mb-8 md:-mt-10 md:-mb-10' : '-mb-8 md:-mb-10' %>" aria-label="Вітрина творів">
  <div data-controller="custom-carousel"
       data-action="pointerdown->custom-carousel#pointerDown"
       <% if eager_first_slide %> data-custom-carousel-eager-first-slide-value="true" <% end %>
       class="relative w-full touch-pan-y overflow-hidden <%= slide_h %>">
    <div data-custom-carousel-target="spinner" class="absolute inset-0 z-40 flex items-center justify-center bg-main/40<%= ' hidden' if eager_first_slide %>">
      <svg class="h-7 w-7 animate-spin text-fg-muted" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    </div>

    <div data-custom-carousel-target="slides" class="flex w-full transition-transform duration-700 ease-in-out <%= slide_h %>" style="transform: translateX(0);">
      <% showcase.each_with_index do |fiction, index| %>
        <% desktop_url = index.zero? ? first_desktop_url : banner_showcase_url(fiction.banner) %>
        <% mobile_url = index.zero? ? first_mobile_url : banner_showcase_url(fiction.banner, size: :mobile) %>
        <% banner_url = desktop_url || mobile_url %>
        <% eager_slide = index.zero? && first_lcp_url.present? %>
        <div class="relative min-w-full flex-shrink-0 overflow-hidden <%= slide_h %>">
          <%# Art + veil melt together; overlay/indicators stay crisp above the fade. %>
          <div class="absolute inset-0 <%= art_melt %>" aria-hidden="true">
            <% if eager_slide %>
              <picture class="absolute inset-0 z-0 block size-full">
                <% if first_desktop_url.present? && first_desktop_url != first_lcp_url %>
                  <source media="(min-width: 768px)" srcset="<%= first_desktop_url %>">
                <% end %>
                <%= image_tag first_lcp_url,
                      alt: "",
                      aria: { hidden: true },
                      fetchpriority: "high",
                      loading: "eager",
                      decoding: "async",
                      width: banner_showcase_mobile_dimensions[0],
                      height: banner_showcase_mobile_dimensions[1],
                      class: "block size-full object-cover object-center" %>
              </picture>
            <% else %>
              <div
                data-controller="lazy-bg"
                data-lazy-bg-id-value="<%= fiction.id %>"
                data-lazy-bg-url-value="<%= banner_url %>"
                <% if mobile_url.present? && mobile_url != banner_url %>
                  data-lazy-bg-small-url-value="<%= mobile_url %>"
                <% end %>
                class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat"
                id="lazy-bg-<%= fiction.id %>"
                style="background-image: none;"></div>
            <% end %>
            <div class="<%= slide_dim %>"></div>
            <div class="<%= slide_veil %>"></div>
          </div>

          <% first_readable_chapter = ordered_chapters(fiction, viewer: current_user).first %>
          <% read_href = first_readable_chapter ? chapter_path(first_readable_chapter) : fiction_path(fiction) %>
          <%= render Fictions::ShowcaseSlideOverlayComponent.new(
                fiction: fiction,
                editorial_kinds: Fictions::HeroEditorialTags.new(
                  fiction,
                  popular_novelty_ids: popular_novelty_ids,
                  top_fiction_ids: top_fiction_ids,
                  latest_update_ids: latest_update_ids
                ).call,
                links: { read: read_href, fiction: fiction_path(fiction) },
                eager_link_preload: index.zero? && first_readable_chapter.present?,
                content_rail: content_rail
              ) %>
        </div>
      <% end %>
    </div>

    <% if carousel_nav_visible %>
      <div class="pointer-events-none absolute inset-x-0 bottom-10 z-30 md:bottom-14 <%= content_rail ? 'mx-auto max-w-[1300px] px-4' : 'px-4' %>">
        <div class="pointer-events-auto flex items-center justify-center gap-2" role="group" aria-label="Навігація по слайдах вітрини">
          <% showcase.each_with_index do |fiction, idx| %>
            <% indicator_active = idx.zero? %>
            <button
              type="button"
              data-custom-carousel-target="indicator"
              data-action="custom-carousel#goTo"
              data-index="<%= idx %>"
              aria-label="Перейти до слайду <%= idx + 1 %> з <%= showcase.size %>: <%= fiction.title %>"
              <% if indicator_active %> aria-current="true"<% end %>
              class="carousel-indicator shrink-0 rounded-full transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand <%= indicator_active ? 'h-1 w-6 bg-fg dark:bg-white' : 'h-1 w-1.5 bg-fg/35 hover:bg-fg/55 dark:bg-white/45 dark:hover:bg-white/70' %>"></button>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
<% end %>
