<%# locals: show_presenter: %>
<% current_reads = show_presenter.monthly_reads_count %>
<% total_fictions = show_presenter.monthly_reads_fiction_count %>
<% current_rank = show_presenter.monthly_reads_rank || total_fictions %>
<div class="bg-surface rounded-lg p-4 border border-line relative overflow-hidden">
  <%= render 'shared/jellyfish_ornament' %>
  <h4 class="text-xl font-bold text-fg mb-4">Славомір</h4>

  <div class="flex items-center justify-between mb-3">
    <span class="text-sm font-medium text-fg-muted">Щабель цього місяця:</span>
    <span class="text-2xl font-extrabold text-fg bg-surface-strong px-3 py-1 rounded-lg">#<%= current_rank %></span>
  </div>
  <div class="flex items-center justify-between mb-3">
    <span class="text-sm font-medium text-fg-muted">Прочитань цього місяця:</span>
    <span class="text-xl font-bold text-fg"><%= current_reads %></span>
  </div>
  <div class="w-full bg-surface-hover rounded-full h-3 overflow-hidden">
    <div class="bg-fg-secondary h-full rounded-full transition-all duration-500 ease-out"
          style="width: <%= [100 - (current_rank.to_f / total_fictions * 100), 100].min %>%"></div>
  </div>
  <p class="text-xs font-medium text-fg-muted mt-2 text-right">
    Перші <%= ((current_rank.to_f / total_fictions) * 100).round(1) %>% цього місяця
  </p>
</div>
