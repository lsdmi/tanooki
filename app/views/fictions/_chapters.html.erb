<%# locals: fiction:, order:, toggle_order_button_id: 'toggle-fictions-order' (optional), reader_drawer: false (optional), current_chapter: nil (optional) %>
<% toggle_btn_id = local_assigns.fetch(:toggle_order_button_id, 'toggle-fictions-order') %>
<% reader_drawer = local_assigns.fetch(:reader_drawer, false) %>
<% if reader_drawer %>
  <section class="max-w-full bg-transparent"
           data-controller="chapter-drawer-search"
           data-chapter-drawer-search-chapters-value="<%= reader_chapter_drawer_search_index(fiction, order: order, current_chapter: local_assigns[:current_chapter]).to_json %>">
    <%= render 'fictions/reader_chapter_drawer_search',
               fiction: fiction,
               order: order,
               toggle_order_button_id: toggle_btn_id,
               current_chapter: local_assigns[:current_chapter] %>

    <div data-chapter-drawer-search-target="list">
      <div data-controller="flowbite">
        <%= render 'fictions/chapter_list', fiction: fiction, order: order, reader_drawer: true, current_chapter: local_assigns[:current_chapter] %>
      </div>
    </div>
  </section>
<% else %>
  <% listed = listed_chapters(fiction, viewer: current_user) %>
  <% latest = listed.first %>
  <% newest_first = order.to_sym == :desc %>
  <% list_progress = reader_chapter_drawer_progress(fiction) if user_signed_in? %>
  <% total = chapters_size(fiction, viewer: current_user) %>
  <section class="flex flex-col gap-6 md:gap-5">
    <div class="flex items-center justify-between gap-3">
      <div class="flex min-w-0 flex-col gap-1">
        <p class="text-base/6 font-semibold text-fg">
          <% if list_progress&.started? %>
            <%= t('fictions.chapters_tab.progress', read: chapter_list_read_count(listed, list_progress), total:) %>
          <% else %>
            <%= t('fictions.chapters_tab.count', count: total) %>
          <% end %>
        </p>
        <% if latest %>
          <p class="text-sm/5 text-fg-muted">
            <%= t('fictions.chapters_tab.latest', number: Chapters::Formatting.format_decimal(latest.number), date: l(latest.public_at, format: :shortest)) %>
          </p>
        <% end %>
      </div>
      <%= button_to toggle_order_fiction_path(fiction, order: order),
                    data: {
                      turbo_stream: '',
                      'turbo-method': :post,
                      controller: 'fictions-order-toggle',
                      action: 'click->fictions-order-toggle#spin'
                    },
                    id: toggle_btn_id,
                    title: t(newest_first ? 'fictions.chapters_tab.show_oldest' : 'fictions.chapters_tab.show_newest'),
                    class: 'fictions-order-toggle group inline-flex shrink-0 items-center gap-2 rounded-lg bg-main px-4 py-2.5 text-sm/5 font-medium text-fg ring-1 ring-inset ring-line transition-colors hover:bg-surface-hover' do %>
        <span class="flex transition-transform duration-300 group-hover:rotate-180" data-fictions-order-toggle-target="icon">
          <%= stroke_icon(:arrow_down_up) %>
        </span>
        <%= t(newest_first ? 'fictions.chapters_tab.newest' : 'fictions.chapters_tab.oldest') %>
      <% end %>
    </div>

    <div data-controller="flowbite">
      <%= render 'fictions/chapter_list', fiction: fiction, order: order, reader_drawer: false, current_chapter: local_assigns[:current_chapter], drawer_progress: list_progress %>
    </div>

    <% if list_progress %>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs/5 text-fg-muted">
        <% %i[unread in_progress read].each do |state| %>
          <span class="inline-flex items-center gap-1">
            <%= render Ui::ProgressIconComponent.new(state:, size: :sm) %>
            <%= t(state, scope: 'fictions.chapters_tab.legend') %>
          </span>
        <% end %>
        <% if list_progress.toggleable? %>
          <span><%= t('fictions.chapters_tab.legend.hint') %></span>
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>
