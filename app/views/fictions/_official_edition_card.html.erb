<%# locals: (fiction:, id: 'official-edition') %>
<section class="relative flex flex-col gap-4 rounded-xl bg-main p-5 ring-1 ring-inset ring-status-licensed-subtle-border" id="<%= id %>-card" aria-labelledby="<%= id %>-title">
  <div class="flex items-center gap-3">
    <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-status-licensed-subtle-bg text-fg" aria-hidden="true">
      <%= stroke_icon(:book_open, 'size-5') %>
    </span>
    <div class="flex min-w-0 flex-col">
      <h2 id="<%= id %>-title" class="text-xl/7 font-bold text-fg"><%= t('fictions.license.card.title') %></h2>
      <% if fiction.license_publisher %>
        <p class="text-sm/5 text-status-licensed-solid">«<%= fiction.license_publisher %>»</p>
      <% end %>
    </div>
  </div>
  <p class="text-sm/5 text-fg-secondary"><%= t(fiction.license_readable_count.positive? ? :body_preview : :body, scope: 'fictions.license.card') %></p>
  <%= render Fictions::OfficialEditionButtonComponent.new(fiction:, label: t('fictions.license.card.link'),
                                                          variant: :licensed, full_width: true) %>
</section>
