<%# locals: fiction:, order:, read_filter:, team_filter: %>
<div class="flex w-full flex-wrap gap-1 rounded-lg bg-surface p-1 ring-1 ring-inset ring-line" role="group" aria-label="<%= t('fictions.chapters_tab.team.label') %>">
  <% choices = [[nil, t('fictions.chapters_tab.filter.all')]] + team_filter.teams.map { |team| [team.id, team.title] } %>
  <% choices.each do |value, label| %>
    <% selected = team_filter.value == value %>
    <%= button_to label,
                  chapter_team_fiction_path(fiction, order:, filter: read_filter.value, team: value),
                  form: { class: 'flex flex-none' },
                  data: { turbo_stream: '' },
                  aria: { pressed: selected },
                  class: ['rounded-lg px-4 py-1.5 text-sm/5 font-semibold transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-line-strong',
                          selected ? 'bg-main text-fg shadow-sm' : 'text-fg-muted hover:bg-surface-hover hover:text-fg'] %>
  <% end %>
</div>
