<%# locals: (fictions:, featured: nil, released_chapter_count: 0) %>
<% fictions = Array(fictions) %>
<% featured ||= fictions.first %>

<section aria-labelledby="fictions-index-hot-novelty"
         data-controller="fiction-picker"
         data-fiction-picker-variant="hot_novelty">
  <header class="mb-6 flex items-stretch gap-3 sm:gap-4 lg:mb-8">
    <div class="w-1.5 shrink-0 rounded-lg bg-cyan-700 dark:bg-rose-500" aria-hidden="true"></div>
    <div class="flex min-w-0 flex-1 items-center justify-between gap-4">
      <h2 id="fictions-index-hot-novelty" class="text-xl font-bold leading-snug tracking-tight text-stone-900 dark:text-slate-100 lg:text-2xl">
        Гарячі Новинки
      </h2>
      <%= render 'root/section_more_link',
                 path: alphabetical_fictions_path,
                 label: 'Сховище',
                 link_class: 'text-cyan-700 dark:text-rose-400' %>
    </div>
  </header>

  <% if fictions.any? %>
    <%# Padding keeps the selected/focus ring from being clipped by the scroll container; negative margins preserve alignment. %>
    <%# The trailing mask fades the overflowing edge so the row reads as scrollable. %>
    <div
      class="-mx-1 -mt-1 mb-3 flex gap-2 overflow-x-auto overscroll-x-contain px-1 py-1 [-webkit-overflow-scrolling:touch] [mask-image:linear-gradient(to_right,#000_calc(100%-40px),transparent)] lg:mb-4 lg:gap-3"
      role="group"
      aria-label="Гарячі Новинки — обкладинки">
      <% fictions.each do |fiction| %>
        <button
          type="button"
          class="group/cover aspect-[3/4] w-[68px] shrink-0 cursor-pointer overflow-hidden rounded-lg bg-slate-200 shadow-sm transition-shadow duration-300 hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-700 lg:w-[92px] dark:bg-slate-800 dark:focus-visible:ring-rose-800"
          data-action="click->fiction-picker#selectFiction"
          data-fiction-picker-target="image"
          data-fiction-picker-id-param="<%= fiction.id %>">
          <%= cover_card_picture_tag(fiction.cover,
                        alt: fiction.title,
                        class: 'h-full w-full object-cover object-center transition-transform duration-300 group-hover/cover:scale-105',
                        loading: 'lazy') %>
        </button>
      <% end %>
    </div>

    <%= turbo_frame_tag 'fiction_details' do %>
      <%= render 'fictions/hot_novelty_featured',
                 fiction: featured,
                 released_chapter_count: released_chapter_count,
                 eager_cover: true %>
    <% end %>
  <% end %>
</section>
