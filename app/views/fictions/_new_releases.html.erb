<header class="mb-6 flex items-stretch gap-3 sm:gap-4 lg:mb-8">
  <div class="w-1.5 shrink-0 rounded-lg bg-cyan-700 dark:bg-rose-500" aria-hidden="true"></div>
  <div class="flex min-w-0 flex-1 items-center justify-between gap-4">
    <h2 id="fictions-index-hot-novelty" class="text-xl font-bold leading-snug tracking-tight text-stone-900 dark:text-slate-100 lg:text-2xl">
      Гарячі Новинки
    </h2>
    <%= render 'root/section_more_link',
               path: alphabetical_fictions_path,
               label: 'Всі Твори',
               link_class: 'text-cyan-700 dark:text-rose-400' %>
  </div>
</header>

<div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
  <% fictions.each do |fiction| %>
    <div class="flex flex-col">
      <%= link_to fiction_path(fiction), class: 'w-full h-48 sm:h-56 md:h-72 lg:h-48 aspect-[2/3] mb-2 relative transition duration-300 transform hover:scale-105' do %>
        <%= cover_card_picture_tag(fiction.cover,
          alt: fiction.cover.blob.filename.to_s,
          class: "w-full h-48 sm:h-56 md:h-72 lg:h-48 object-cover rounded-2xl shadow-sm",
          loading: "lazy",
          data: {
            controller: "lazy-image",
            lazy_image_target: "image",
            lazy_image_url_value: cover_card_url(fiction.cover)
          } ) %>
      <% end %>
      <div class="flex flex-col w-full">
        <%= link_to fiction_path(fiction), class: 'group w-full items-center' do %>
          <h3 class="text-xs md:text-base lg:text-xs font-semibold text-stone-800 dark:text-gray-200 line-clamp-1 group-hover:text-cyan-700 dark:group-hover:text-rose-700 transition-colors duration-300 text-center">
            <%= fiction.title %>
          </h3>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
