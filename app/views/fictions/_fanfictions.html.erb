<%# locals: (fictions:) %>
<% return if fictions.blank? %>
<section class="mb-8 lg:mb-14" aria-labelledby="fictions-index-fanfictions">
  <header class="mb-6 flex items-stretch gap-3 sm:gap-4 lg:mb-8">
    <div class="w-1.5 shrink-0 rounded-lg bg-brand" aria-hidden="true"></div>
    <div class="flex min-w-0 flex-1 items-center justify-between gap-4">
      <h2 id="fictions-index-fanfictions"
          class="text-xl font-bold leading-snug tracking-tight text-fg lg:text-2xl">
        Фанфіки
      </h2>
      <%= render 'root/section_more_link',
                 path: fiction_genre_fictions_path(Genre::FANFICTION_SLUG),
                 link_class: 'text-fg-brand' %>
    </div>
  </header>

  <%= render 'root/fictions', fictions:, show_scanlator: true %>
</section>
