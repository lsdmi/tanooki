<div class="relative overflow-hidden rounded-lg bg-surface border border-brand h-full">
  <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-16 h-px bg-gradient-to-r from-transparent via-fg-brand to-transparent opacity-20"></div>
  <div class="relative px-4 py-6 md:px-6 md:py-8 h-full flex flex-col justify-center">
    <div class="text-center">
      <div class="flex items-center justify-center mb-3">
        <div class="relative">
          <div class="absolute -inset-2 rounded-lg border border-dashed border-brand opacity-20 animate-spin" style="animation-duration: 20s;"></div>
          <div class="p-2 bg-brand rounded-lg">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
            </svg>
          </div>
        </div>
      </div>
      <h2 class="text-lg md:text-xl font-bold text-fg mb-3">
        Не Знайшли Улюбленої Історії?
      </h2>
      <p class="text-sm text-fg-secondary mb-4">
        Зробіть запит на переклад! Наша команда готова допомогти!
      </p>
      <div class="flex flex-col gap-2">
        <%= ui_button(as: :link, href: translation_requests_path, size: :md) do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
          </svg>
          Додати Запит
        <% end %>
      </div>
    </div>
  </div>
</div>
