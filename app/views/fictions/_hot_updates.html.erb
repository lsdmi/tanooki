<%# locals: fictions:, latest_chapters_by_fiction: %>
<% cards = recently_updated_cards(fictions, latest_chapters_by_fiction) %>
<% card_options = { cover_class: 'w-[68px] lg:w-[92px]', gap_class: 'gap-3 lg:gap-4' } %>

<section aria-labelledby="fictions-index-new-releases">
  <header class="mb-6 flex items-stretch gap-3 sm:gap-4 lg:mb-8">
    <div class="w-1.5 shrink-0 rounded-lg bg-cyan-700 dark:bg-rose-500" aria-hidden="true"></div>
    <div class="flex min-w-0 flex-1 items-center justify-between gap-4">
      <h2 id="fictions-index-new-releases" class="text-xl font-bold leading-snug tracking-tight text-stone-900 dark:text-slate-100 lg:text-2xl">
        Нові Релізи
      </h2>
      <%= render 'root/section_more_link',
                 path: calendar_fictions_path,
                 label: 'Календар',
                 link_class: 'text-cyan-700 dark:text-rose-400' %>
    </div>
  </header>

  <%# Below sm the rows collapse into one snap column per swipe; -mr-6 clears the page gutter so the next column peeks. %>
  <div
    class="-mr-6 flex snap-x snap-mandatory gap-4 overflow-x-auto overscroll-x-contain [-webkit-overflow-scrolling:touch] sm:hidden"
    role="group"
    aria-label="Нові Релізи">
    <% cards.each_slice(3) do |column_cards| %>
      <div class="flex w-[78%] shrink-0 snap-start flex-col gap-3">
        <% column_cards.each do |card| %>
          <%= render 'root/recently_updated_card', **card_options, fiction: card[:fiction], chapter: card[:chapter] %>
        <% end %>
      </div>
    <% end %>
  </div>

  <ul class="hidden list-none gap-3 sm:grid sm:grid-cols-2 lg:gap-4" aria-label="Нові Релізи">
    <% cards.each do |card| %>
      <li>
        <%= render 'root/recently_updated_card', **card_options, fiction: card[:fiction], chapter: card[:chapter] %>
      </li>
    <% end %>
  </ul>
</section>
