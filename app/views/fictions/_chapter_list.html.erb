<%# locals: fiction:, order:, reader_drawer: false (optional), current_chapter: nil (optional), drawer_progress: nil (optional), continue_chapter: nil (optional) %>
<% reader_drawer = local_assigns.fetch(:reader_drawer, false) %>
<%# Guests on the fiction page get plain rows; the drawer always has progress (current chapter, toggles). %>
<% drawer_progress = local_assigns[:drawer_progress] %>
<% drawer_progress ||= reader_chapter_drawer_progress(fiction, current_chapter: local_assigns[:current_chapter]) if reader_drawer || user_signed_in? %>
<div class="<%= reader_drawer ? '' : 'rounded-lg' %>">
  <div id="chapters-list">
    <%= render 'fictions/chapter_collection',
               fiction: fiction,
               order: order,
               reader_drawer: reader_drawer,
               current_chapter: local_assigns[:current_chapter],
               drawer_progress: drawer_progress,
               continue_chapter: local_assigns[:continue_chapter] %>
  </div>
</div>
