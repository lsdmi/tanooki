<%# locals: (fiction:, released_chapter_count: 0, eager_cover: false) %>
<% copy = hot_novelty_featured_copy(fiction, released_chapter_count) %>
<% text_link_class = 'rounded-lg transition-colors hover:text-cyan-700 hover:underline underline-offset-2 dark:hover:text-rose-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-700 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-rose-800 dark:focus-visible:ring-offset-gray-900' %>

<div id="fiction_details" class="flex gap-3 lg:gap-5">
  <%= link_to fiction_path(fiction),
              turbo_drive_visit_data.merge(class: 'group/cover aspect-[3/4] w-[144px] shrink-0 overflow-hidden rounded-lg bg-slate-200 shadow-sm transition-transform duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-700 dark:bg-slate-800 dark:focus-visible:ring-rose-800 lg:w-[193px]') do %>
    <%= cover_card_picture_tag(fiction.cover,
                  alt: fiction.title,
                  class: 'h-full w-full object-cover object-center transition-transform duration-300 group-hover/cover:scale-[1.03]',
                  loading: (eager_cover ? 'eager' : 'lazy')) %>
  <% end %>

  <%# Uniform gap between rows; my-auto hands the leftover height back as equal top/bottom margin. %>
  <div class="my-auto flex min-w-0 flex-1 flex-col gap-1.5 lg:gap-2">
    <h3 class="line-clamp-1 text-base font-bold leading-snug text-slate-900 dark:text-slate-100 lg:text-xl">
      <%= link_to fiction.title, fiction_path(fiction), turbo_drive_visit_data.merge(class: text_link_class) %>
    </h3>
    <p class="line-clamp-1 text-xs text-slate-500 dark:text-slate-400 lg:text-sm">
      <%= fiction.author %> · <%= copy[:chapters] %> Розділи
    </p>
    <%# flex-nowrap + overflow-hidden rather than line-clamp-1: line-clamp needs display:-webkit-box, which flex overrides. %>
    <ul class="flex min-w-0 flex-nowrap items-center gap-x-4 overflow-hidden text-xs text-slate-600 dark:text-slate-300 lg:text-sm">
      <li class="inline-flex items-center gap-1.5">
        <svg class="h-4 w-4 shrink-0 text-amber-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
        <%= copy[:rating] %>
      </li>
      <li class="inline-flex items-center gap-1.5">
        <svg class="h-4 w-4 shrink-0 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
        <%= copy[:views] %>
      </li>
      <li class="inline-flex min-w-0 items-center gap-1.5" title="<%= copy[:status] %>">
        <svg class="h-4 w-4 shrink-0 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
        <span class="lg:hidden"><%= copy[:status_short] %></span>
        <span class="hidden lg:inline"><%= copy[:status] %></span>
      </li>
    </ul>
    <p class="line-clamp-4 text-xs leading-relaxed text-slate-600 dark:text-slate-300 lg:text-sm"><%= copy[:excerpt] %></p>
    <%= render Ui::GenrePageTagListComponent.new(
          genres: copy[:genres],
          tag_html: turbo_drive_visit_data,
          pin_bottom: false,
          compact_max: 1
        ) %>
  </div>
</div>
