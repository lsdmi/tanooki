<%# locals: chapter:, reader_drawer: false (optional), current_chapter: nil (optional), drawer_progress: nil (optional) %>
<% reader_drawer = local_assigns.fetch(:reader_drawer, false) %>
<% drawer_progress = local_assigns[:drawer_progress] %>
<% status = drawer_progress ? reader_drawer_chapter_status(chapter, drawer_progress:) : :unread %>
<% title_class = chapter_row_title_class(status, reader_drawer:) %>
<% row_class = chapter_row_class(status, reader_drawer:) %>
<% row_attributes = if reader_drawer
  { id: dom_id(chapter, :reader_drawer),
    data: { chapter_drawer_search_target: 'row', chapter_id: chapter.id, chapter_status: status } }
else
  { data: { chapter_status: (status if drawer_progress) } }
end %>
<%= tag.li class: 'group', **row_attributes do %>
  <% if reader_drawer %>
    <% toggle = drawer_progress.toggleable? %>
    <% if status == :current %>
      <div class="flex items-center gap-3 border-l-2 border-cyan-700 bg-cyan-50/80 dark:border-rose-500 dark:bg-rose-950/40 <%= toggle ? 'pl-4' : 'px-4 py-3' %>" aria-current="page">
        <span class="min-w-0 flex-1 truncate <%= title_class %><%= ' py-3' if toggle %>">
          <%= chapter.display_title_no_volume %>
        </span>
        <% if toggle %>
          <span class="sr-only"><%= t('chapters.reader_chapter_drawer.progress_current') %></span>
          <%= render 'fictions/reader_chapter_read_toggle', chapter:, read: drawer_progress.read?(chapter), current_chapter: local_assigns[:current_chapter] %>
        <% else %>
          <%= render 'fictions/reader_chapter_drawer_status', status: status %>
        <% end %>
      </div>
    <% elsif toggle %>
      <div class="flex items-center transition-colors <%= row_class %>">
        <%= link_to chapter_path(chapter), turbo_drive_visit_data.merge(class: 'min-w-0 flex-1 py-3 pl-4') do %>
          <span class="block truncate <%= title_class %>">
            <%= chapter.display_title_no_volume %>
          </span>
          <% if status == :in_progress %>
            <span class="sr-only"><%= t('chapters.reader_chapter_drawer.progress_in_progress') %></span>
          <% end %>
        <% end %>
        <%= render 'fictions/reader_chapter_read_toggle', chapter:, read: status == :read, marker: status, current_chapter: local_assigns[:current_chapter] %>
      </div>
    <% else %>
      <%= link_to chapter_path(chapter), turbo_drive_visit_data.merge(class: "flex items-center gap-3 px-4 py-3 transition-colors #{row_class}") do %>
        <span class="min-w-0 flex-1 truncate <%= title_class %>">
          <%= chapter.display_title_no_volume %>
        </span>
        <%= render 'fictions/reader_chapter_drawer_status', status: status %>
      <% end %>
    <% end %>
  <% else %>
    <div class="p-3 transition duration-150 ease-in-out <%= row_class %>">
      <%= link_to chapter_path(chapter), turbo_drive_visit_data.merge(class: "block") do %>
        <div class="flex items-center justify-between gap-4">
          <div class="flex min-w-0 flex-1 items-center gap-3">
            <span class="mt-2 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-stone-200 text-xs font-medium text-stone-600 dark:bg-gray-600 dark:text-gray-300">
              <%= chapter.number %>
            </span>
            <div class="min-w-0 flex-1">
              <span class="block truncate <%= title_class %>">
                <%= chapter.display_title_no_volume %>
              </span>
            </div>
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <% if status.in?(%i[read in_progress]) %>
              <%= render 'fictions/reader_chapter_drawer_status', status: status %>
            <% end %>
            <span class="whitespace-nowrap text-xs text-stone-500 dark:text-gray-400">
              <%= l(chapter.public_at, format: :shortest).downcase %>
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-stone-400 group-hover:text-stone-600 dark:text-gray-500 dark:group-hover:text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </div>
      <% end %>
      <% if chapter.scanlators.any? %>
        <div class="-mt-1 pl-9">
          <p class="text-[0.65rem] leading-snug text-stone-500 dark:text-gray-500">
            <%= safe_join(
                  chapter.scanlators.map { |scanlator|
                    link_to(
                      scanlator.title,
                      scanlator_path(scanlator),
                      turbo_drive_visit_data.merge(
                        class: "text-stone-500 underline-offset-2 hover:text-stone-800 hover:underline dark:text-gray-500 dark:hover:text-gray-300"
                      )
                    )
                  },
                  ', '
                ) %>
          </p>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
