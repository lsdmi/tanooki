<%# locals: chapter:, reader_drawer: false (optional), current_chapter: nil (optional), drawer_progress: nil (optional) %>
<% reader_drawer = local_assigns.fetch(:reader_drawer, false) %>
<% drawer_progress = local_assigns[:drawer_progress] %>
<% status = drawer_progress ? reader_drawer_chapter_status(chapter, drawer_progress:) : :unread %>
<% title_class = chapter_row_title_class(status, reader_drawer:) %>
<% row_class = chapter_row_class(status, reader_drawer:) %>
<% row_attributes = if reader_drawer
  { id: dom_id(chapter, :reader_drawer),
    data: { chapter_drawer_search_target: 'row', chapter_id: chapter.id, chapter_status: status } }
elsif drawer_progress
  { id: dom_id(chapter, :chapter_list), data: { chapter_status: status } }
else
  {}
end %>
<%= tag.li class: 'group', **row_attributes do %>
  <% if reader_drawer %>
    <% toggle = drawer_progress.toggleable? %>
    <% if status == :current %>
      <div class="flex items-center gap-3 border-l-2 border-brand bg-brand-subtle <%= toggle ? 'pl-4' : 'px-4 py-3' %>" aria-current="page">
        <span class="min-w-0 flex-1 truncate <%= title_class %><%= ' py-3' if toggle %>">
          <%= chapter.display_title_no_volume %>
        </span>
        <% if toggle %>
          <span class="sr-only"><%= t('chapters.reader_chapter_drawer.progress_current') %></span>
          <%= render 'fictions/reader_chapter_read_toggle', chapter:, read: drawer_progress.read?(chapter), current_chapter: local_assigns[:current_chapter] %>
        <% else %>
          <%= chapter_progress_icon(status) %>
        <% end %>
      </div>
    <% elsif toggle %>
      <div class="flex items-center transition-colors <%= row_class %>">
        <%= link_to chapter_path(chapter), turbo_drive_visit_data.merge(class: 'min-w-0 flex-1 py-3 pl-4') do %>
          <span class="block truncate <%= title_class %>">
            <%= chapter.display_title_no_volume %>
          </span>
          <% if status == :in_progress %>
            <span class="sr-only"><%= t('chapters.reader_chapter_drawer.progress_in_progress') %></span>
          <% end %>
        <% end %>
        <%= render 'fictions/reader_chapter_read_toggle', chapter:, read: status == :read, marker: status, current_chapter: local_assigns[:current_chapter] %>
      </div>
    <% else %>
      <%= link_to chapter_path(chapter), turbo_drive_visit_data.merge(class: "flex items-center gap-3 px-4 py-3 transition-colors #{row_class}") do %>
        <span class="min-w-0 flex-1 truncate <%= title_class %>">
          <%= chapter.display_title_no_volume %>
        </span>
        <%= chapter_progress_icon(status) %>
      <% end %>
    <% end %>
  <% else %>
    <% toggle = drawer_progress&.toggleable? %>
    <% continue_row = status == :in_progress %>
    <% mobile_title, desktop_title = chapter_list_row_titles(chapter) %>
    <%# The title link stretches over the row; team links and the toggle sit above it. %>
    <div class="relative flex items-center gap-3 rounded-lg p-3 transition-colors <%= row_class %>">
      <span class="flex h-11 min-w-11 shrink-0 items-center justify-center rounded-md bg-surface px-2 text-xs/5 font-medium text-fg-secondary ring-1 ring-inset ring-line transition-colors md:min-w-13 <%= 'group-hover:bg-main' unless continue_row %>">
        <%= Chapters::Formatting.format_decimal(chapter.number) %>
      </span>
      <div class="flex min-w-0 flex-1 flex-col gap-1">
        <%= link_to chapter_path(chapter), turbo_drive_visit_data.merge(class: "truncate rounded-sm text-sm/5 font-medium after:absolute after:inset-0 after:rounded-lg focus:outline-none focus-visible:after:ring-2 focus-visible:after:ring-line-strong #{title_class}") do %>
          <span class="md:hidden"><%= mobile_title %></span><span class="hidden md:inline"><%= desktop_title %></span>
          <% if toggle && continue_row %>
            <span class="sr-only"><%= t('chapters.reader_chapter_drawer.progress_in_progress') %></span>
          <% end %>
        <% end %>
        <p class="truncate text-xs/5 text-fg-muted<%= ' hidden md:block' if continue_row %>">
          <% if chapter.scanlators.any? %>
            <%= safe_join(chapter.scanlators.map { |scanlator| link_to(scanlator.title, scanlator_path(scanlator), turbo_drive_visit_data.merge(class: 'relative rounded-sm underline-offset-2 hover:text-fg-secondary hover:underline')) }, ', ') %>
            ·
          <% end %>
          <%= l(chapter.public_at, format: :shortest) %>
        </p>
        <% if continue_row %>
          <p class="text-xs/5 font-semibold text-fg-brand md:hidden" aria-hidden="true"><%= t('fictions.chapters_tab.continue_mobile') %></p>
        <% end %>
      </div>
      <% if continue_row %>
        <span class="hidden shrink-0 rounded-md bg-brand px-3 py-1 text-xs/5 font-semibold text-fg-on-brand md:inline-flex" aria-hidden="true"><%= t('fictions.chapters_tab.continue') %></span>
      <% end %>
      <% if toggle %>
        <%= render 'fictions/reader_chapter_read_toggle', chapter:, read: status == :read, marker: status, reader_drawer: false %>
      <% elsif drawer_progress && status.in?(%i[read in_progress]) %>
        <span class="flex size-8 shrink-0 items-center justify-center"><%= chapter_progress_icon(status, size: :lg) %></span>
      <% end %>
    </div>
  <% end %>
<% end %>
