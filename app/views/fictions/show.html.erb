<% cache_if guest_fiction_show_fragment_cacheable?,
            guest_fiction_show_fragment_cache_key(@fiction, @show_presenter),
            expires_in: guest_fiction_show_fragment_expires_in do %>
<div class="bg-surface min-h-screen z-10 relative">
  <%= render Fictions::HeroBandComponent.new(fiction: @fiction, presenter: @show_presenter, user: current_user) do |hero| %>
    <% notices = Fictions::NoticeZone.for(@fiction, age: show_age_rating_notice?(@fiction)) %>
    <% if notices.any? %>
      <% hero.with_notice do %>
        <div class="flex flex-col gap-2">
          <% notices.each do |notice| %>
            <%= render Ui::NoticeComponent.new(style: :scrim, **notice.to_h) %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
  <% active_tab = @show_presenter.default_tab %>
  <div class="group/tabs" data-controller="tabs" data-tabs-active-tab-value="<%= active_tab %>" data-action="hashchange@window->tabs#hashChanged">
    <%= render 'show_tabs', fiction: @fiction, active_tab: %>

    <main class="max-w-screen-xl mx-auto px-4 2xl:px-0 py-8 relative z-10">
      <%= render Fictions::TeamToolbarComponent.new(fiction: @fiction, user: current_user) %>

      <%= render layout: 'tab_panel', locals: { id: :about, active_tab: } do %>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <section class="lg:col-span-2 rounded-lg">
            <%= render 'details', fiction: @fiction, show_presenter: @show_presenter %>

            <section class="fiction-show__ad fiction-show__ad--main mt-8">
              <%= render "shared/adsense_slot",
                         placement: :fiction_show,
                         navigation_key: @fiction.id,
                         measure_as: "bottom" %>
            </section>
          </section>

          <div class="space-y-8">
            <%= render 'scanlator_notice', fiction: @fiction %>

            <section class="fiction-show__ad fiction-show__ad--sidebar">
              <%= render "shared/adsense_slot",
                         placement: :fiction_show_sidebar,
                         navigation_key: @fiction.id,
                         measure_as: "bottom" %>
            </section>

            <%= render 'epub_disclaimer', fiction: @fiction %>

            <%= render 'add_chapter_cta', fiction: @fiction %>
          </div>
        </div>
      <% end %>

      <%= render layout: 'tab_panel', locals: { id: :chapters, active_tab: } do %>
        <section class="bg-surface-strong rounded-lg shadow-md p-6 border border-line">
          <% if fiction_has_listable_chapters?(@fiction, current_user) %>
            <%= turbo_frame_tag 'sort-chapters' do %>
              <%= render 'chapters', fiction: @fiction, order: @show_presenter.order %>
            <% end %>
          <% else %>
            <%= render 'first_chapter_cta', fiction: @fiction %>
          <% end %>
        </section>
      <% end %>

      <%# A lazy frame in a hidden panel never intersects, so comments load when their tab first opens. %>
      <%= render layout: 'tab_panel', locals: { id: :comments, active_tab: } do %>
        <section class="bg-card rounded-lg shadow-md p-6 border border-line">
          <%= turbo_frame_tag 'fiction_comments', src: comments_fiction_path(@fiction), loading: :lazy do %>
            <p class="py-6 text-center text-sm text-fg-muted">Завантаження коментарів…</p>
          <% end %>
        </section>
      <% end %>

      <% if @fiction.scanlators.any? %>
        <%= turbo_frame_tag 'fiction_similar', src: similar_fictions_fiction_path(@fiction), loading: :lazy, class: 'mt-8 block' do %>
          <p class="py-4 text-center text-sm text-fg-muted">Завантаження…</p>
        <% end %>
      <% end %>
    </main>
  </div>
</div>
<% end %>
