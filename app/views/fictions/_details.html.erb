<div class="fiction-details bg-main rounded-lg shadow-sm border border-line">
  <!-- Main Content Section (2/3 of the partial) -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 p-6">
    <!-- Left Column - Main Content (2/3) -->
    <div class="min-w-0 lg:col-span-2 space-y-6">
      <!-- Tags -->
      <% if fiction.genres.any? || fiction.age_labelled? %>
        <div class="bg-surface rounded-lg p-4 border border-line relative overflow-hidden">
          <%= render 'shared/jellyfish_ornament' %>
          <h4 class="font-semibold text-fg mb-3">Теґи</h4>
          <% fiction_tag_labels = fiction.with_content_rating_tag_labels(fiction.genres.map(&:name)) %>
          <%= render Ui::TagListComponent.new(
                labels: fiction_tag_labels,
                variant: :genre,
                sort_adult_first: true,
                genre_slugs: fiction.genres.to_h { |genre| [genre.name, genre.slug] },
                size: :sm,
                href_builder: ->(name) {
                  next if Genre.rating_tag?(name)

                  genre = fiction.genres.find { |g| g.name == name }
                  fiction_genre_fictions_path(genre) if genre
                }
              ) %>
        </div>
      <% end %>

      <!-- Description Section (2/3 of the partial) -->
      <div class="bg-surface rounded-lg p-4 border border-line relative overflow-hidden">
        <%= render 'shared/decorative_ornament' %>
        <h3 class="font-semibold text-fg">Опис</h3>
        <div class="text-sm sm:text-base text-fg-muted whitespace-pre-line leading-relaxed">
          <%= fiction.description %>
        </div>
      </div>

      <% if fiction_reader_support?(fiction) %>
        <div class="fiction-support-card">
          <%= render 'chapters/reader_support_card', fiction: fiction %>
        </div>
      <% end %>
    </div>
    <!-- Right Column - Sidebar (1/3) -->
    <div class="min-w-0 space-y-6">
      <!-- Rating Section -->
      <%= render 'rating_section', fiction: fiction %>

      <!-- Bookmarks Stats -->
      <div class="">
        <div class="grid grid-cols-2 gap-3 text-center">
          <div class="bg-surface rounded-lg p-4 border border-line">
            <div class="text-lg font-bold text-blue-600 dark:text-blue-400"><%= show_presenter.bookmark_stats[0] %></div>
            <div class="text-xs text-fg-secondary">Читають</div>
          </div>
          <div class="bg-surface rounded-lg p-4 border border-line">
            <div class="text-lg font-bold text-status-success-solid"><%= show_presenter.bookmark_stats[1] %></div>
            <div class="text-xs text-fg-secondary">Прочитано</div>
          </div>
          <div class="bg-surface rounded-lg p-4 border border-line">
            <div class="text-lg font-bold text-yellow-600 dark:text-yellow-400"><%= show_presenter.bookmark_stats[2] %></div>
            <div class="text-xs text-fg-secondary">Відкладено</div>
          </div>
          <div class="bg-surface rounded-lg p-4 border border-line">
            <div class="text-lg font-bold text-status-danger-solid"><%= show_presenter.bookmark_stats[3] %></div>
            <div class="text-xs text-fg-secondary">Покинуто</div>
          </div>
        </div>
      </div>

      <%= turbo_frame_tag 'fiction_sidebar_stats', src: sidebar_stats_fiction_path(fiction), loading: :lazy, class: 'space-y-6 block' do %>
        <p class="py-4 text-center text-sm text-fg-muted">Завантаження…</p>
      <% end %>
    </div>
  </div>
</div>
