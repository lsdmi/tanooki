<div class="min-h-screen">
  <div class="max-w-[1300px] mx-auto px-4 pb-16 lg:pb-20 z-10 relative">
    <div class="px-2 xl:px-0 py-6 sm:py-8 lg:py-10">
    <%= render 'showcase_carousel',
               showcase: @index_presenter.showcase,
               popular_novelty_ids: @index_presenter.carousel_popular_novelty_ids,
               top_fiction_ids: @index_presenter.carousel_most_read_ids,
               latest_update_ids: @index_presenter.carousel_latest_update_ids %>

    <!-- First Section: Rising and Cheering Fictions -->
    <div class="flex flex-col gap-8 lg:flex-row lg:gap-10 mb-8 mt-8 lg:mt-12">
      <!-- Rising Fictions -->
      <div class="w-full lg:w-2/4 lg:mb-0">
        <%= render 'hot_updates', fictions: @index_presenter.latest_updates %>
      </div>

      <!-- Cheering Fictions -->
      <div class="w-full lg:w-2/4">
        <%= render 'new_releases', fictions: @index_presenter.popular_novelty %>
      </div>
    </div>

    <%= render "shared/adsense_collapse_safe",
               placement: :fictions_index_top,
               navigation_key: "top",
               wrapper_class: "mb-8 lg:mb-10" %>

    <!-- Mid-page Banner and Translation Request Section -->
    <%= render 'fictions/genres/promo_row' %>

    <%= render "shared/adsense_collapse_safe",
               placement: :fictions_index_mid,
               navigation_key: "mid",
               measure_as: "bottom",
               wrapper_class: "mb-8 lg:mb-10" %>

    <!-- Second Section: Rankings and Filtered Fictions -->
    <div class="flex flex-col gap-8 lg:flex-row lg:gap-10">
      <!-- Rankings -->
      <div class="w-full lg:w-1/3">
        <%= render 'top_fictions', fictions: @index_presenter.most_reads, released_chapter_counts: @index_presenter.released_chapters_counts_for_most_reads %>
      </div>

      <!-- Filtered Fictions -->
      <div class="w-full lg:w-2/3">
        <%= render 'filtered_fiction_list', fictions: @index_presenter.other, genres: @index_presenter.genres, sample_genre: @index_presenter.sample_genre %>
      </div>
    </div>
    </div>
  </div>
</div>
