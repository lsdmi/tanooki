<div class="min-h-screen">
  <div class="max-w-[1300px] mx-auto px-4 z-10 relative">
    <div class="px-2 xl:px-0 pt-6 sm:pt-8 lg:pt-10">
    <%= render 'showcase_carousel',
               showcase: @index_presenter.showcase,
               popular_novelty_ids: @index_presenter.carousel_popular_novelty_ids,
               top_fiction_ids: @index_presenter.carousel_most_read_ids,
               latest_update_ids: @index_presenter.carousel_latest_update_ids %>

    <!-- New releases and hot novelty -->
    <div class="flex flex-col gap-8 lg:flex-row mb-8 mt-8 lg:mb-14 lg:mt-14">
      <div class="w-full lg:w-2/4 lg:mb-0">
        <%= render 'hot_updates',
                   fictions: @index_presenter.latest_updates,
                   latest_chapters_by_fiction: @index_presenter.latest_update_chapters %>
      </div>

      <div class="w-full lg:w-2/4">
        <%= render 'new_releases',
                   fictions: @index_presenter.popular_novelty,
                   featured: @index_presenter.popular_novelty_featured,
                   released_chapter_count: @index_presenter.popular_novelty_featured_chapter_count %>
      </div>
    </div>

    <%= render 'shared/adsense_fictions_index_banners', wrapper_class: 'mb-8 lg:mb-14' %>

    <%= render 'popular_ranobe', fictions: @index_presenter.most_reads %>
    </div>
  </div>

  <%= render 'originals', fictions: @index_presenter.originals %>

  <div class="max-w-[1300px] mx-auto px-4 pb-16 lg:pb-20 z-10 relative">
    <div class="px-2 xl:px-0">
    <%= render 'fanfictions', fictions: @index_presenter.fanfictions %>

    <%= render 'genre_spotlight', entries: @index_presenter.genre_spotlight %>

    <%= render 'fictions/genres/promo_row' %>
    </div>
  </div>
</div>
