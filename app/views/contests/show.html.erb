<% content_for :title, @contest.title %>

<% cache_if current_user.blank?,
            [@contest, @contest.updated_at, @contest.entries.maximum(:updated_at), Date.current],
            expires_in: 10.minutes do %>
  <div class="contests-page min-h-screen bg-page pb-24 md:pb-16">
    <% @presenter.visible_sections.each do |section| %>
      <% case section[:id] %>
      <% when :hero %>
        <%= render Contests::HeroComponent.new(contest: @contest, presenter: @presenter) %>
      <% when :summary %>
        <%= render Contests::SummaryComponent.new(presenter: @presenter) %>
      <% when :section_nav %>
        <%= render Contests::SectionNavComponent.new(presenter: @presenter) %>
      <% when :timeline %>
        <div class="mx-auto max-w-screen-xl px-4 py-10 2xl:px-0">
          <%= render Contests::TimelineComponent.new(presenter: @presenter) %>
        </div>
      <% when :prizes %>
        <div class="mx-auto max-w-screen-xl px-4 py-10 2xl:px-0">
          <%= render Contests::PrizePoolComponent.new(presenter: @presenter) %>
        </div>
      <% when :cancellation %>
        <%= render partial: section[:partial_or_component],
                   locals: { contest: @contest, presenter: @presenter } %>
      <% else %>
        <div class="mx-auto max-w-screen-xl px-4 py-10 2xl:px-0">
          <%= render partial: section[:partial_or_component],
                     locals: { contest: @contest, presenter: @presenter } %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
