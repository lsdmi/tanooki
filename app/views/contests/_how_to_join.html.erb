<%# locals: (contest:, presenter:) %>
<section id="how-to-join" class="scroll-mt-24">
  <p class="<%= contest_section_label_class %>"><%= t('contests.show.sections.how_to_join') %></p>
  <ol class="mt-4 grid gap-x-10 md:grid-cols-3">
    <% [
         %i[step1_title step1_body],
         %i[step2_title step2_body],
         %i[step3_title step3_body]
       ].each_with_index do |(title_key, body_key), index| %>
      <li class="border-b border-line py-3">
        <p class="text-xs text-fg-muted"><%= index + 1 %></p>
        <p class="mt-1 text-sm font-medium text-fg"><%= t("contests.show.how_to_join.#{title_key}") %></p>
        <p class="mt-1 text-sm text-fg-secondary"><%= t("contests.show.how_to_join.#{body_key}") %></p>
      </li>
    <% end %>
  </ol>
  <% join = presenter.primary_action if presenter.primary_action&.dig(:label_key)&.end_with?('.join') %>
  <% if join %>
    <div class="mt-6">
      <%= render Ui::ButtonComponent.new(
            label: t('contests.show.actions.join'),
            href: join[:href],
            variant: :primary,
            size: :lg,
            as: :link
          ) %>
    </div>
  <% end %>
</section>
