<%# locals: (contest:, presenter:) %>
<section id="cancelled" class="scroll-mt-24 border-b border-line bg-status-warning-subtle-bg">
  <div class="mx-auto max-w-screen-xl px-4 py-8 2xl:px-0">
    <h2 class="text-xl font-bold text-status-warning-subtle-fg"><%= t('contests.show.sections.cancellation') %></h2>
    <p class="mt-2 text-sm text-status-warning-subtle-fg"><%= t('contests.show.cancellation.body') %></p>
    <% if contest.cancel_reason.present? %>
      <p class="mt-2 text-sm text-status-warning-subtle-fg"><%= t('contests.show.cancellation.reason', reason: contest.cancel_reason) %></p>
    <% end %>
  </div>
</section>
