<%# locals: (contest:) %>
<% archives = other_archive_contests(contest) %>
<% return if archives.blank? %>

<section id="other-archives"
         class="relative z-10 mx-auto w-full max-w-screen-xl scroll-mt-24 px-4 2xl:px-0 <%= contest_section_y_class %>"
         aria-labelledby="other-archives-heading">
  <h2 id="other-archives-heading" class="<%= contest_section_label_class %>">
    <%= t('contests.show.other_archives.title') %>
  </h2>
  <ul class="mt-2.5 space-y-2 sm:mt-3 md:mt-3.5">
    <% archives.each do |other| %>
      <li>
        <%= link_to contest_path(other),
                    class: 'group inline-flex max-w-full flex-col gap-0.5 rounded-md text-fg transition-colors hover:text-fg-brand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand sm:flex-row sm:items-baseline sm:gap-2' do %>
          <span class="font-semibold underline-offset-2 group-hover:underline"><%= other.title %></span>
          <% if other.tagline.present? %>
            <span class="text-sm text-fg-muted line-clamp-1"><%= other.tagline %></span>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
  <p class="mt-3 text-sm text-fg-muted">
    <%= link_to t('contests.show.other_archives.rules_link'),
                rules_path(anchor: 'contest-rules'),
                class: 'font-medium text-fg-brand underline-offset-2 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand' %>
  </p>
</section>
