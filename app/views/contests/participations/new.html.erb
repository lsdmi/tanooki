<% content_for :title, t('contests.submit.title', contest: @contest.title) %>

<div class="contests-page min-h-screen bg-page pb-16"
     data-controller="contests--rules-modal">
  <div class="mx-auto max-w-xl px-4 py-8 2xl:px-0">
    <header class="mb-8">
      <p class="text-sm text-fg-muted">
        <%= link_to @contest.title, contest_path(@contest), class: 'hover:text-fg-brand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand' %>
      </p>
      <h1 class="mt-2 text-2xl font-bold text-fg md:text-3xl">
        <%= t('contests.participation.heading', title: @fiction.title) %>
      </h1>
      <p class="mt-2 text-sm text-fg-secondary"><%= t('contests.participation.subhead') %></p>
      <button type="button"
              class="mt-3 text-sm font-semibold text-fg-brand hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
              data-action="contests--rules-modal#open">
        <%= t('contests.submit.rules_link') %>
      </button>
    </header>

    <% values = @form.params || {} %>
    <% confirmed = current_user.confirmed? %>

    <%= form_with url: contest_participation_path(@contest, fiction_id: @fiction.slug), method: :post,
                  class: 'space-y-6',
                  data: { turbo: false, controller: 'contests--ai-usage' } do %>
      <% if @form.errors[:base].any? %>
        <div class="rounded-xl bg-status-danger-subtle-bg px-4 py-3 text-sm text-status-danger-subtle-fg ring-1 ring-status-danger-subtle-border" role="alert">
          <ul class="list-disc space-y-1 pl-4">
            <% @form.errors[:base].each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <fieldset data-action="change->contests--ai-usage#sync">
        <legend class="text-sm font-semibold text-fg"><%= t('contests.submit.fields.ai_usage') %></legend>
        <div class="mt-3 space-y-2">
          <% [
               %w[none contests.submit.ai.none],
               %w[assist contests.submit.ai.assist],
               %w[substantial contests.submit.ai.substantial]
             ].each do |value, key| %>
            <label class="flex cursor-pointer items-start gap-3 rounded-lg bg-surface px-3 py-3 ring-1 ring-line has-[:checked]:bg-brand-subtle has-[:checked]:ring-brand">
              <input type="radio" name="participation[ai_usage]" value="<%= value %>" required
                     class="mt-0.5 size-4 border-line-strong text-fg-brand focus:ring-brand"
                     <%= 'checked' if values[:ai_usage].to_s == value %>>
              <span class="text-sm text-fg"><%= t(key) %></span>
            </label>
          <% end %>
        </div>
        <div class="mt-3" data-contests--ai-usage-target="note" hidden>
          <label for="participation_ai_note" class="block text-sm font-semibold text-fg"><%= t('contests.submit.fields.ai_note') %></label>
          <textarea name="participation[ai_note]" id="participation_ai_note" rows="2" disabled
                    class="mt-2 w-full rounded-lg border border-line bg-main px-3 py-3 text-sm text-fg focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20"><%= values[:ai_note] %></textarea>
          <p class="mt-1 text-xs text-fg-muted"><%= t('contests.submit.fields.ai_private') %></p>
        </div>
      </fieldset>

      <label class="flex cursor-pointer items-start gap-3">
        <input type="checkbox" name="participation[rules_accepted]" value="1" required
               class="mt-1 size-4 rounded border-line-strong text-fg-brand focus:ring-brand"
               <%= 'checked' if ActiveModel::Type::Boolean.new.cast(values[:rules_accepted]) %>>
        <span class="text-sm text-fg"><%= t('contests.submit.fields.rules_accepted') %></span>
      </label>

      <% unless confirmed %>
        <div class="rounded-xl bg-status-warning-subtle-bg px-4 py-3 text-sm text-status-warning-subtle-fg ring-1 ring-status-warning-subtle-border">
          <p class="font-semibold"><%= t('contests.submit.confirm_email') %></p>
          <%= button_to t('contests.submit.resend_confirmation'),
                        user_confirmation_path,
                        params: { user: { email: current_user.email } },
                        method: :post,
                        form: { class: 'mt-3 inline-block' },
                        class: 'text-sm font-semibold underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand' %>
        </div>
      <% end %>

      <%= render Ui::ButtonComponent.new(
            label: t('contests.submit.submit'),
            variant: :primary,
            size: :lg,
            as: :submit,
            full_width: true,
            disabled: !confirmed
          ) %>
    <% end %>

    <dialog class="contests-rules-dialog m-auto w-[min(36rem,calc(100%-2rem))] max-h-[80vh] overflow-y-auto rounded-xl bg-main p-0 text-fg shadow-xl ring-1 ring-line backdrop:bg-overlay-scrim-60"
            data-contests--rules-modal-target="dialog"
            data-action="click->contests--rules-modal#backdrop">
      <div class="sticky top-0 flex items-center justify-between border-b border-line bg-main px-4 py-3">
        <h2 class="text-base font-semibold"><%= t('contests.submit.rules_link') %></h2>
        <button type="button" class="rounded-lg px-2 py-1 text-sm text-fg-muted hover:bg-surface"
                data-action="contests--rules-modal#close">
          <%= t('contests.submit.rules_close') %>
        </button>
      </div>
      <div class="space-y-4 px-4 py-4">
        <%= render 'contests/general_rules' %>
        <% if @contest.rules.present? %>
          <div class="prose prose-slate max-w-none border-t border-line pt-4 text-sm dark:prose-invert">
            <h3 class="mb-2 text-base font-semibold text-fg"><%= t('contests.show.rules.extra') %></h3>
            <%= @contest.rules %>
          </div>
        <% end %>
      </div>
    </dialog>
  </div>
</div>
