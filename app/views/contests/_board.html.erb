<%# locals: (contest:, presenter:) %>
<% jurors = contest.jurors.exists? %>
<% show_timeline = presenter.phase != :results %>
<div class="grid lg:grid-cols-12 lg:items-start <%= contest_split_gap_class %>">
  <% if show_timeline %>
    <div id="timeline" class="scroll-mt-24 lg:col-span-12">
      <h2 class="<%= contest_section_label_class %>"><%= t('contests.show.sections.timeline') %></h2>
      <%= render Contests::TimelineComponent.new(presenter:, embedded: true) %>
    </div>
  <% end %>

  <div id="prizes" class="scroll-mt-24 <%= jurors ? 'lg:col-span-7' : 'lg:col-span-12' %>">
    <h2 class="<%= contest_section_label_class %>"><%= t('contests.show.sections.prizes') %></h2>
    <%= render Contests::PrizePoolComponent.new(presenter:, embedded: true) %>
  </div>

  <% if jurors %>
    <div id="jury" class="scroll-mt-24 lg:col-span-5 <%= contest_split_rail_class %>">
      <h2 class="<%= contest_section_label_class %>"><%= t('contests.show.sections.jury') %></h2>
      <%= render 'contests/jury', contest: %>
    </div>
  <% end %>
</div>
