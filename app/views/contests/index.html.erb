<% content_for :title, t('contests.hub.title') %>

<div class="contests-page min-h-screen bg-page pb-16">
  <% if @hub.hub_state == :idle %>
    <header class="border-b border-line bg-surface">
      <div class="mx-auto max-w-screen-xl px-4 py-10 2xl:px-0">
        <h1 class="text-3xl font-bold text-fg md:text-4xl"><%= t('contests.hub.title') %></h1>
        <% if @hub.teaser_draft %>
          <p class="mt-3 max-w-2xl text-base text-fg-secondary"><%= @hub.teaser_draft.teaser_text %></p>
          <p class="mt-2 max-w-2xl text-sm text-fg-muted"><%= t('contests.hub.teaser_hint') %></p>
        <% else %>
          <p class="mt-3 max-w-2xl text-base text-fg-secondary"><%= t('contests.hub.idle_title') %></p>
          <p class="mt-2 max-w-2xl text-sm text-fg-muted"><%= t('contests.hub.idle_body') %></p>
        <% end %>
        <div class="mt-6">
          <%= render Ui::ButtonComponent.new(
                label: t('contests.hub.telegram'),
                href: telegram_site_url,
                variant: :primary,
                size: :lg,
                as: :link,
                html: { target: '_blank', rel: 'noopener noreferrer' }
              ) %>
        </div>
      </div>
    </header>
  <% else %>
    <% contest = @hub.featured %>
    <% presenter = Contests::ShowPresenter.new(contest:, user: current_user) %>
    <%= render Contests::HeroComponent.new(contest:, presenter:) %>
  <% end %>

  <main class="mx-auto max-w-screen-xl px-4 py-10 2xl:px-0">
    <section class="mb-14">
      <%= render Ui::SectionHeadingComponent.new(title: t('contests.hub.hall_of_fame')) %>
      <% fame = @hub.hall_of_fame.to_a %>
      <% if fame.any? %>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <% fame.each do |award| %>
            <li><%= render Contests::WinnerCardComponent.new(award:) %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-4 text-sm text-fg-muted"><%= t('contests.hub.hall_of_fame_empty') %></p>
      <% end %>
    </section>

    <section>
      <%= render Ui::SectionHeadingComponent.new(title: t('contests.hub.archive_title')) %>
      <% archive = @hub.archive.with_attached_cover.to_a %>
      <% if archive.any? %>
        <ul class="mt-6 flex flex-col gap-3">
          <% counts = @hub.entry_counts %>
          <% covers = @hub.archive_top_covers %>
          <% archive.each do |contest| %>
            <li><%= render Contests::ArchiveCardComponent.new(
                      contest:,
                      entry_count: counts[contest.id].to_i,
                      top_covers: covers[contest.id]
                    ) %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-4 text-sm text-fg-muted"><%= t('contests.hub.archive_empty') %></p>
      <% end %>
    </section>
  </main>
</div>
