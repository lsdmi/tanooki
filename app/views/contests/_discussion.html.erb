<%# locals: (contest:) %>
<%= render 'comments/index',
           comments: @comments,
           comment: @comment,
           commentable: contest,
           no_comments_prompt: t('contests.show.sections.discussion'),
           show_heading: false,
           quiet: true,
           more_href: (@comment_page.more? ? comments_contest_path(contest, page: @comment_page.next_page) : nil),
           more_frame: "comments_page_#{@comment_page.next_page}" %>
