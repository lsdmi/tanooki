<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4 gap-3 sm:gap-0">
  <h2 class="text-lg sm:text-xl lg:text-2xl font-semibold text-fg mb-2 sm:mb-0">Читальня</h2>
  <div class="flex gap-1 sm:gap-2 flex-wrap">
    <% status_filters.each do |label, status| %>
      <%= link_to label,
            library_path(section: status),
            data: { turbo_stream: "" },
            class: [
              "px-2 lg:px-3 py-1 rounded-md text-xs font-semibold shadow-sm ring-1 transition duration-300 whitespace-nowrap",
              "hover:cursor-pointer",
              "focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand",
              status == section ?
                "bg-brand text-fg-on-brand ring-brand scale-105" :
                "bg-brand-subtle text-fg-brand-hover ring-brand/30 hover:bg-brand/15 hover:ring-brand/60 hover:scale-105"
            ].join(' '),
            "aria-pressed": status == section %>
    <% end %>
  </div>
</div>

<div class="relative p-4 sm:p-6 lg:p-8 bg-surface rounded-lg shadow-md overflow-hidden border border-brand">
  <!-- Ornament SVG -->
  <svg class="absolute top-0 right-0 w-20 h-20 sm:w-24 sm:h-24 lg:w-32 lg:h-32 opacity-20 pointer-events-none" viewBox="0 0 100 100" fill="none">
    <circle cx="80" cy="20" r="40" fill="#67e8f9" />
    <rect x="10" y="60" width="30" height="30" fill="#f472b6" rx="8" />
  </svg>
  <% if paginated_readings.any? %>
    <ul class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6 lg:gap-8">
      <% paginated_readings.each_with_index do |reading, index| %>
        <%= render 'reading_progresses/reading_progress', reading: reading, section: section, preload_continue: index.zero? %>
      <% end %>
    </ul>
    <%= ui_pagination(
          pagy,
          frame_id: 'library-list',
          form_path: library_path,
          custom_params: { section: section },
          html: { class: 'mt-6 sm:mt-8' }
        ) %>
  <% else %>
    <div class="text-center text-fg-secondary py-8">
      <p>Тут так порожньо.</p>
      <p>Спробуйте змінити фільтри.</p>
    </div>
  <% end %>
</div>
