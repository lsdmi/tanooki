<% licensed = fiction.licensed? %>
<% editable = !fiction.license_frozen_for?(current_user) %>
<% paragraph_report_counts = local_assigns.fetch(:paragraph_report_counts, {}) %>
<% fiction_open_report_count = local_assigns.fetch(:fiction_open_report_count, 0).to_i %>
<div class="relative z-10 space-y-4 p-4 sm:space-y-6 sm:p-8">
  <!-- Navigation Header -->
  <div class="mb-6">
    <!-- Mobile Navigation -->
    <div class="lg:hidden mb-4">
      <!-- Back Button -->
      <div class="flex items-center mb-3">
        <%= link_to readings_path, turbo_drive_visit_data.merge(class: "inline-flex items-center text-sm text-fg-muted hover:text-fg-brand transition-colors duration-200") do %>
          <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Назад до майстерні
        <% end %>
      </div>

      <!-- Fiction Title -->
      <h1 class="text-lg font-bold text-fg mb-2 line-clamp-2">
        <%= fiction.title %>
      </h1>

      <!-- Quick Stats -->
      <%= render 'shared/stat_pill_group' do %>
        <%= render 'shared/stat_chip', value: pagy.count, label: 'розділів' do %>
          <svg class="h-3.5 w-3.5 shrink-0 opacity-70" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        <% end %>
        <%= render 'shared/stat_chip', value: fiction.views, label: 'переглядів' do %>
          <svg class="h-3.5 w-3.5 shrink-0 opacity-70" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M2.25 12s3.75-7.5 9.75-7.5 9.75 7.5 9.75 7.5-3.75 7.5-9.75 7.5S2.25 12 2.25 12z" />
            <circle cx="12" cy="12" r="3" stroke-width="1.75" />
          </svg>
        <% end %>
        <%= render 'shared/stat_chip', value: fiction.comments_count, label: 'коментарів' do %>
          <svg class="h-3.5 w-3.5 shrink-0 opacity-70" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.2-3.8 7.5-8.5 7.5a9.3 9.3 0 01-4-.9L3 20l1.2-3.3A7.6 7.6 0 013 12c0-4.2 3.8-7.5 9-7.5s9 3.3 9 7.5z" />
          </svg>
        <% end %>
        <% if fiction_open_report_count.positive? %>
          <%= render 'shared/stat_chip',
                     value: fiction_open_report_count,
                     label: t('chapters.paragraph_reports.studio_label', count: fiction_open_report_count),
                     tone: :warning do %>
            <svg class="h-3.5 w-3.5 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 9v3.5m0 3.25h.01M10.3 4.2 2.7 17.1c-.7 1.2.2 2.7 1.6 2.7h15.4c1.4 0 2.3-1.5 1.6-2.7L13.7 4.2c-.7-1.2-2.5-1.2-3.4 0z" />
            </svg>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <!-- Desktop Navigation -->
    <div class="hidden lg:block mb-6">
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center space-x-2 text-sm text-fg-muted mb-4">
        <%= link_to "Головна", root_path, turbo_drive_visit_data.merge(class: "hover:text-fg-brand transition-colors duration-200") %>
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
        </svg>
        <%= link_to "Майстерня", readings_path, turbo_drive_visit_data.merge(class: "hover:text-fg-brand transition-colors duration-200") %>
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
        </svg>
        <span class="text-fg font-medium">Розділи</span>
      </nav>

      <!-- Fiction Context Header -->
      <div class="bg-card rounded-xl border border-line p-6 shadow-sm">
        <div class="flex items-start space-x-4">
          <!-- Fiction Cover -->
          <div class="flex-shrink-0">
            <%= link_to fiction_path(fiction), turbo_drive_visit_data do %>
              <%= cover_card_picture_tag(fiction.cover,
                  alt: fiction.title,
                  class: "w-20 h-24 rounded-lg object-cover shadow-sm border border-line-strong hover:shadow-md transition-shadow duration-200" ) %>
            <% end %>
          </div>

          <!-- Fiction Info -->
          <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between">
              <div class="flex-1 min-w-0">
                <%= link_to fiction_path(fiction), turbo_drive_visit_data.merge(class: "block") do %>
                  <h1 class="text-2xl font-bold text-fg hover:text-fg-brand transition-colors duration-200 mb-2 line-clamp-2">
                    <%= fiction.title %>
                  </h1>
                <% end %>

                <div class="mb-3">
                  <%= render 'shared/stat_pill_group' do %>
                    <%= render 'shared/stat_chip', value: pagy.count, label: 'розділів' do %>
                      <svg class="h-3.5 w-3.5 shrink-0 opacity-70" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                    <% end %>
                    <%= render 'shared/stat_chip', value: fiction.views, label: 'переглядів' do %>
                      <svg class="h-3.5 w-3.5 shrink-0 opacity-70" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M2.25 12s3.75-7.5 9.75-7.5 9.75 7.5 9.75 7.5-3.75 7.5-9.75 7.5S2.25 12 2.25 12z" />
                        <circle cx="12" cy="12" r="3" stroke-width="1.75" />
                      </svg>
                    <% end %>
                    <%= render 'shared/stat_chip', value: fiction.comments_count, label: 'коментарів' do %>
                      <svg class="h-3.5 w-3.5 shrink-0 opacity-70" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.2-3.8 7.5-8.5 7.5a9.3 9.3 0 01-4-.9L3 20l1.2-3.3A7.6 7.6 0 013 12c0-4.2 3.8-7.5 9-7.5s9 3.3 9 7.5z" />
                      </svg>
                    <% end %>
                    <% if fiction_open_report_count.positive? %>
                      <%= render 'shared/stat_chip',
                                 value: fiction_open_report_count,
                                 label: t('chapters.paragraph_reports.studio_label', count: fiction_open_report_count),
                                 tone: :warning do %>
                        <svg class="h-3.5 w-3.5 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 9v3.5m0 3.25h.01M10.3 4.2 2.7 17.1c-.7 1.2.2 2.7 1.6 2.7h15.4c1.4 0 2.3-1.5 1.6-2.7L13.7 4.2c-.7-1.2-2.5-1.2-3.4 0z" />
                        </svg>
                      <% end %>
                    <% end %>
                  <% end %>
                </div>
              </div>

              <!-- Quick Actions -->
              <div class="flex items-center space-x-2">
                <!-- View Fiction Button -->
                <%= link_to fiction_path(fiction), turbo_drive_visit_data.merge(class: "inline-flex items-center px-3 py-2 text-sm font-medium text-fg-secondary bg-card border border-line-strong rounded-lg hover:bg-surface-strong transition-colors duration-200") do %>
                  <svg class="h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.25 12s3.75-7.5 9.75-7.5 9.75 7.5 9.75 7.5-3.75 7.5-9.75 7.5S2.25 12 2.25 12z" />
                    <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5" fill="none" />
                  </svg>
                  Переглянути
                <% end %>

                <!-- Edit Fiction Button -->
                <%= ui_button(as: :link, href: edit_fiction_path(fiction.slug), size: :lg, html: turbo_drive_visit_data) do %>
                  <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                  </svg>
                  Редагувати
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%= render 'catalog/listing_nudge', fiction: fiction %>

  <% if licensed %>
    <%= render 'readings/licensed_notice' %>
  <% end %>

  <% if chapters.any? %>
    <% unless licensed %>
      <!-- Compact "Add chapter" (Mobile Only) -->
      <div class="sm:hidden">
        <%= ui_button(as: :link, href: new_chapter_path(fiction:), full_width: true, html: { data: { turbo: false } }) do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 -ml-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" />
          </svg>
          Додати розділ
        <% end %>
      </div>

      <!-- CTA Card -->
      <div class="hidden sm:block rounded-lg border border-line bg-card p-6 text-center shadow-sm relative overflow-hidden">
        <%= render 'shared/decorative_ornament' %>

        <div class="mx-auto h-20 w-20 rounded-full bg-brand-subtle flex items-center justify-center mb-4 relative z-10">
          <svg class="h-10 w-10 text-fg-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
        </div>
        <h3 class="mb-2 text-lg font-semibold leading-none text-fg relative z-10">Додайте новий розділ!</h3>
        <p class="mb-4 text-fg-muted relative z-10">Створіть захоплююче продовження улюбленої історії!</p>
        <%= ui_button(as: :link, href: new_chapter_path(fiction:), html: { data: { turbo: false }, class: 'relative z-10' }) do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 -ml-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" />
          </svg>
          Додати розділ
        <% end %>
      </div>
    <% end %>

    <!-- Pagination (Top) -->
    <%= ui_pagination(pagy, pagy_id: 'pagy-top', form_path: reading_path(fiction), html: { class: 'p-2' }) %>

    <!-- Chapters List -->
    <div class="rounded-lg border border-line bg-card shadow-sm">
      <!-- Desktop Table View -->
      <div class="hidden sm:block rounded-lg relative overflow-x-auto">
        <%= render 'shared/jellyfish_ornament' %>
        <table class="w-full divide-y divide-line text-left text-sm text-fg">
          <thead class="bg-brand-subtle text-xs uppercase text-fg-muted">
            <tr>
              <th scope="col" class="whitespace-nowrap p-4 text-xs font-semibold uppercase text-fg-secondary">Розділ</th>
              <th scope="col" class="whitespace-nowrap p-4 text-xs font-semibold uppercase text-fg-secondary">Статистика</th>
              <th scope="col" class="whitespace-nowrap p-4 text-xs font-semibold uppercase text-fg-secondary">Дії</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-line">
            <% chapters.each do |chapter| %>
              <%= render Readings::ChapterRowComponent.new(
                    chapter:,
                    variant: :table_row,
                    pagy_page: pagy.page,
                    editable:,
                    open_report_count: paragraph_report_counts[chapter.id].to_i
                  ) %>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Card View (Mobile Only) -->
      <div class="sm:hidden p-3">
        <div class="grid grid-cols-1 gap-3">
          <% chapters.each do |chapter| %>
            <%= render Readings::ChapterRowComponent.new(
                  chapter:,
                  variant: :card,
                  pagy_page: pagy.page,
                  editable:,
                  open_report_count: paragraph_report_counts[chapter.id].to_i
                ) %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Pagination (Bottom) -->
    <%= ui_pagination(pagy, form_path: reading_path(fiction), html: { class: 'p-4' }) %>
  <% elsif !licensed %>
    <div class="rounded-lg border border-line bg-card p-8 text-center shadow-sm relative overflow-hidden">
      <%= render 'shared/jellyfish_ornament' %>

      <div class="mx-auto h-16 w-16 rounded-full bg-brand-subtle flex items-center justify-center mb-4 relative z-10">
        <svg class="h-8 w-8 text-fg-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <h3 class="mb-4 text-lg font-semibold text-fg relative z-10">Розділи відсутні</h3>
      <p class="mb-4 text-fg-muted relative z-10">Додайте перший розділ та почніть свою історію!</p>
      <%= ui_button(as: :link, href: new_chapter_path(fiction:), html: { data: { turbo: false }, class: 'relative z-10' }) do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 -ml-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" />
        </svg>
        Додати перший розділ
      <% end %>
    </div>
  <% end %>
</div>
