<div class="relative min-h-screen overflow-hidden">
  <div class="pointer-events-none absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url(<%= asset_path('writer.webp') %>);" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-0 bg-stone-50/92 dark:bg-gray-900/92" aria-hidden="true"></div>

  <div class="relative z-10 container mx-auto px-4 py-10 md:py-12">
    <div class="mx-auto max-w-4xl">
      <header class="mb-10 text-center">
        <h1 class="text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-100 md:text-3xl">
          Друзі Баки
        </h1>
        <p class="mt-3 text-sm leading-relaxed text-stone-600 dark:text-stone-400 md:text-base">
          Проєкти та спільноти, які розвивають українську культуру разом із нами.
        </p>
      </header>

      <% if SiteFriend.sections.any? %>
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:items-start md:gap-x-8">
          <% SiteFriend.sections.each do |group| %>
            <section aria-labelledby="friends-<%= group[:section].id %>">
              <header class="mb-3 px-1">
                <h2 id="friends-<%= group[:section].id %>" class="text-lg font-bold tracking-tight text-stone-900 dark:text-stone-100">
                  <%= group[:section].title %>
                </h2>
                <p class="mt-1 text-sm text-stone-500 dark:text-stone-400">
                  <%= group[:section].tagline %>
                </p>
              </header>

              <ul class="divide-y divide-stone-200 overflow-hidden rounded-xl border border-stone-200 bg-white/95 shadow-sm backdrop-blur-sm dark:divide-gray-700 dark:border-gray-700 dark:bg-gray-900/95">
                <% group[:friends].each do |friend| %>
                  <li>
                    <%= link_to friend.url,
                                class: 'group block px-5 py-4 transition-colors hover:bg-stone-50 dark:hover:bg-gray-800/60',
                                target: '_blank',
                                rel: 'noopener noreferrer' do %>
                      <span class="flex items-start justify-between gap-4">
                        <span class="min-w-0">
                          <span class="block font-semibold text-stone-900 group-hover:text-cyan-700 dark:text-stone-100 dark:group-hover:text-rose-400">
                            <%= friend.name %>
                          </span>
                          <% if friend.description.present? %>
                            <span class="mt-1 block text-sm leading-snug text-stone-600 dark:text-stone-400">
                              <%= friend.description %>
                            </span>
                          <% end %>
                        </span>
                        <svg class="mt-0.5 h-4 w-4 shrink-0 text-stone-400 transition-transform group-hover:translate-x-0.5 group-hover:text-cyan-700 dark:group-hover:text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                        </svg>
                      </span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </section>
          <% end %>
        </div>
      <% else %>
        <p class="rounded-xl border border-dashed border-stone-300 bg-white/95 px-5 py-8 text-center text-sm leading-relaxed text-stone-600 shadow-sm backdrop-blur-sm dark:border-gray-600 dark:bg-gray-900/95 dark:text-stone-400">
          Скоро тут зʼявляться проєкти та спільноти, з якими ми дружимо.
        </p>
      <% end %>

      <aside class="mt-10 rounded-xl border border-cyan-700/20 bg-white/95 p-5 shadow-sm backdrop-blur-sm dark:border-rose-500/25 dark:bg-gray-900/95 md:p-6"
             aria-label="Стань нашим другом">
        <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="min-w-0">
            <h2 class="text-base font-bold text-stone-900 dark:text-stone-100 md:text-lg">
              Стань нашим другом
            </h2>
            <p class="mt-1 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
              Маєш власний проєкт чи спільноту? Напиши нам до Telegram — радо додамо до списку.
            </p>
          </div>
          <%= ui_button(as: :link,
                        href: telegram_site_url,
                        size: :md,
                        html: {
                          target: '_blank',
                          rel: 'noopener noreferrer',
                          class: 'shrink-0 w-full sm:w-auto justify-center'
                        }) do %>
            <%= render 'root/prefooter/promo/telegram_button_icon' %>
            Спільнота
          <% end %>
        </div>
      </aside>
    </div>
  </div>
</div>
