<section class="mx-auto max-w-4xl px-4 py-10">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold text-fg"><%= t('admin.contests.title') %></h1>
      <p class="mt-2 text-sm/6 text-fg-muted"><%= t('admin.contests.intro') %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to t('admin.contests.from_preset.link'), new_from_preset_admin_contests_path,
                  class: 'inline-flex items-center rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-fg-on-brand' %>
      <%= link_to t('admin.contests.new'), new_admin_contest_path,
                  class: 'inline-flex items-center rounded-lg bg-main px-4 py-2 text-sm font-semibold text-fg ring-1 ring-inset ring-line' %>
    </div>
  </div>

  <% if @contests.empty? %>
    <p class="mt-8 rounded-xl border border-line bg-main px-4 py-10 text-center text-sm/5 text-fg-muted">
      <%= t('admin.contests.empty') %>
    </p>
  <% else %>
    <ul class="mt-8 divide-y divide-line overflow-hidden rounded-xl border border-line bg-main">
      <% @contests.each do |contest| %>
        <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
          <div>
            <%= link_to contest.title, admin_contest_path(contest), class: 'font-semibold text-fg hover:underline' %>
            <p class="text-sm/5 text-fg-muted">
              <%= t('admin.contests.phase', phase: t("admin.contests.phases.#{contest.phase}")) %>
              · <%= contest.slug %>
            </p>
          </div>
          <div class="flex flex-wrap gap-2">
            <%= link_to t('admin.contests.entries.link'), admin_contest_entries_path(contest),
                        class: 'rounded-lg bg-main px-3 py-1.5 text-sm font-semibold text-fg ring-1 ring-inset ring-line' %>
            <%= link_to t('admin.contests.edit'), edit_admin_contest_path(contest),
                        class: 'rounded-lg bg-main px-3 py-1.5 text-sm font-semibold text-fg ring-1 ring-inset ring-line' %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
