<section class="relative min-h-screen flex items-center justify-center py-10 px-4">
  <div class="w-full max-w-7xl bg-main/90 rounded-2xl shadow-2xl flex flex-col md:flex-row overflow-hidden border border-line">
    <!-- Left: Welcome and Form -->
    <div class="flex-1 flex flex-col justify-center p-10 md:p-14">
      <h1 class="text-3xl md:text-4xl font-extrabold text-fg mb-2 tracking-tight leading-tight">
        Вітаємо з поверненням!
      </h1>
      <p class="text-lg md:text-xl text-fg-muted font-light mb-6">
        Досі не з нами?
        <%= link_to 'Зареєструватися', register_path, class: 'font-semibold text-status-success-solid hover:underline transition' %>
      </p>
      <div class="token-raw bg-emerald-50 dark:bg-zinc-900/70 rounded-xl shadow-inner p-6 md:p-8 mb-4 border border-line">
        <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="grid grid-cols-1 gap-5">
            <div>
              <%= f.input :email,
                id: 'email',
                required: true,
                autofocus: true,
                label: "Електронна Адреса",
                placeholder: "user@baka.in.ua",
                input_html: {
                  autocomplete: "email",
                  class: "w-full py-3 px-4 rounded-lg border border-line bg-main text-base text-fg focus:ring-2 focus:ring-emerald-400 transition"
                },
                label_html: {
                  class: 'block text-sm font-medium text-fg-secondary mb-1'
                } %>
            </div>
            <div>
              <%= f.input :password,
                id: 'password',
                required: true,
                label: "Пароль",
                placeholder: "***********",
                input_html: {
                  autocomplete: "current-password",
                  class: "w-full py-3 px-4 rounded-lg border border-line bg-main text-base text-fg focus:ring-2 focus:ring-emerald-400 transition"
                },
                label_html: {
                  class: 'block text-sm font-medium text-fg-secondary mb-1'
                } %>
            </div>
          </div>
          <div class="flex items-center justify-between mt-4">
            <%= link_to 'Забули пароль?', new_user_password_path, class: 'text-sm font-medium text-status-success-solid hover:underline transition' %>
          </div>
          <%= button_tag "Увійти", form: 'new_user', class: "mt-6 w-full py-3 rounded-lg bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white font-bold text-lg tracking-wide shadow-lg transition uppercase" %>
        <% end %>
        <div class="mt-6">
          <%= render 'omniauth' %>
        </div>
      </div>
    </div>
    <!-- Right: Visual -->
    <div class="token-raw hidden md:flex flex-1 items-center justify-center bg-gradient-to-tr from-emerald-100 via-main to-emerald-50 dark:from-zinc-950 dark:to-zinc-950">
      <%= image_tag 'login.jpeg', alt: 'login', class: 'token-raw w-80 h-80 object-cover rounded-xl shadow-lg border-4 border-emerald-100 dark:border-zinc-800' %>
    </div>
  </div>
</section>
