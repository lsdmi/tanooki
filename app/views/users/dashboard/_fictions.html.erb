<div class="space-y-6">
  <% cover_quality_flags ||= {} %>
  <% listing_nudge_flags ||= {} %>
  <% fiction_open_report_counts ||= {} %>
  <% if current_user.scanlators.any? || current_user.admin? %>
    <!-- CTA Card -->
    <div class="col-span-2 rounded-lg border border-line bg-card p-6 text-center shadow-sm relative overflow-hidden">
      <%= render 'shared/decorative_ornament' %>

      <div class="mx-auto h-20 w-20 rounded-full bg-brand-subtle flex items-center justify-center mb-4 relative z-10">
        <svg class="h-10 w-10 text-fg-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
      </div>
      <h3 class="mb-2 text-lg font-semibold leading-none text-fg relative z-10">Додайте новий твір!</h3>
      <p class="mb-4 text-fg-muted relative z-10">Поділіться творчістю з читачами! Створюйте якісний контент та зрощуйте аудиторію!</p>
      <%= ui_button(as: :link, href: new_fiction_path, html: { data: { turbo: false }, class: 'relative z-10' }) do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 -ml-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" />
        </svg>
        Додати твір
      <% end %>
    </div>

    <!-- Fictions List -->
    <% if fictions.any? %>
      <div class="rounded-lg border border-line bg-card shadow-sm">
        <!-- Desktop Table View -->
        <div class="hidden sm:block rounded-lg relative overflow-x-auto overflow-y-visible">
          <%= render 'shared/jellyfish_ornament' %>
          <table class="w-full divide-y divide-line text-left text-sm text-fg">
            <thead class="bg-brand-subtle text-xs uppercase text-fg-muted">
              <tr>
                <th scope="col" class="whitespace-nowrap p-4 text-xs font-semibold uppercase text-fg-secondary">Твір</th>
                <th scope="col" class="whitespace-nowrap p-4 text-right text-xs font-semibold uppercase text-fg-secondary">Дії</th>
              </tr>
            </thead>

            <tbody class="divide-y divide-line">
              <% fictions.each do |fiction| %>
                <% open_reports = fiction_open_report_counts[fiction.id].to_i %>
                <tr class="hover:bg-brand-subtle/60 transition-colors duration-200">
                  <th scope="row" class="p-4 text-sm font-medium text-fg">
                    <div class="flex min-w-0 items-start gap-3">
                      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-subtle">
                        <svg class="h-5 w-5 text-fg-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                      </div>
                      <div class="min-w-0 space-y-2">
                        <div>
                          <a href="<%= fiction_path(fiction) %>" data-turbo-frame="_top" class="font-medium transition-colors duration-200 hover:text-fg-brand">
                            <%= fiction.title %>
                          </a>
                          <p class="mt-1 text-xs text-fg-muted">
                            Створено: <%= l(fiction.created_at, format: :short).downcase %>
                          </p>
                          <%= render 'users/dashboard/cover_quality_flag', flag: cover_quality_flags[fiction.id] %>
                          <%= render 'users/dashboard/listing_nudge_flag', flag: listing_nudge_flags[fiction.id], fiction: fiction %>
                        </div>
                        <%= render 'users/dashboard/fiction_stats', fiction:, open_reports: %>
                      </div>
                    </div>
                  </th>

                  <td class="p-4 text-right align-middle">
                    <div class="flex items-center justify-end space-x-2">
                      <% unless fiction.licensed? %>
                        <%= link_to new_chapter_path(fiction:), data: { turbo: false }, class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-fg-muted transition-colors duration-200 hover:text-fg", title: "Додати розділ" do %>
                          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                          </svg>
                        <% end %>
                      <% end %>

                      <%= link_to edit_fiction_path(fiction.slug), turbo_drive_visit_data.merge(class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-fg-muted transition-colors duration-200 hover:text-fg", title: "Редагувати") do %>
                        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                      <% end %>

                      <%= link_to reading_path(fiction.slug), turbo_drive_visit_data.merge(class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-fg-brand transition-colors duration-200 hover:text-fg-brand-hover", title: "Розділи") do %>
                        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3h14M5 3v18l7-5 7 5V3" />
                        </svg>
                      <% end %>

                      <% unless fiction.license_frozen_for?(current_user) %>
                        <%= sweet_alert_button(
                          content_tag(:svg, content_tag(:path, nil, stroke_linecap: "round", stroke_linejoin: "round", stroke_width: "2", d: "M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"), class: "h-4 w-4", xmlns: "http://www.w3.org/2000/svg", fill: "none", viewBox: "0 0 24 24", stroke: "currentColor"),
                          {
                            description: "Впевнені, що хочете видалити твір?",
                            message: "",
                            tag_id: nil,
                            url: fiction_path(fiction, page: params[:page]),
                            button_class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-status-danger-solid transition-colors duration-200 hover:text-status-danger-solid"
                          }
                        ) %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <!-- Card View (Mobile Only) -->
        <div class="sm:hidden p-4">
          <div class="grid grid-cols-1 gap-4">
            <% fictions.each do |fiction| %>
              <% open_reports = fiction_open_report_counts[fiction.id].to_i %>
              <div class="rounded-lg border border-line bg-card p-4 shadow-sm transition-shadow duration-200 hover:shadow-md">
                <div class="mb-3 flex items-start gap-3">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-subtle">
                    <svg class="h-5 w-5 text-fg-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                  </div>
                  <div class="min-w-0 flex-1 space-y-2">
                    <div>
                      <a href="<%= fiction_path(fiction) %>" data-turbo-frame="_top" class="block font-medium text-fg transition-colors duration-200 hover:text-fg-brand">
                        <%= fiction.title %>
                      </a>
                      <p class="mt-1 text-xs text-fg-muted">
                        Створено: <%= l(fiction.created_at, format: :short).downcase %>
                      </p>
                      <%= render 'users/dashboard/cover_quality_flag', flag: cover_quality_flags[fiction.id] %>
                      <%= render 'users/dashboard/listing_nudge_flag', flag: listing_nudge_flags[fiction.id], fiction: fiction %>
                    </div>
                    <%= render 'users/dashboard/fiction_stats', fiction:, open_reports: %>
                  </div>
                </div>

                <div class="flex items-center justify-end border-t border-line pt-3">
                  <div class="flex items-center space-x-2">
                    <% unless fiction.licensed? %>
                      <%= link_to new_chapter_path(fiction:), data: { turbo: false }, class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-fg-muted transition-colors duration-200 hover:text-fg", title: "Додати розділ" do %>
                        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                      <% end %>
                    <% end %>

                    <%= link_to edit_fiction_path(fiction.slug), turbo_drive_visit_data.merge(class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-fg-muted transition-colors duration-200 hover:text-fg", title: "Редагувати") do %>
                      <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                    <% end %>

                    <%= link_to reading_path(fiction.slug), turbo_drive_visit_data.merge(class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-fg-brand transition-colors duration-200 hover:text-fg-brand-hover", title: "Розділи") do %>
                      <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3h14M5 3v18l7-5 7 5V3" />
                      </svg>
                    <% end %>

                    <% unless fiction.license_frozen_for?(current_user) %>
                      <%= sweet_alert_button(
                        content_tag(:svg, content_tag(:path, nil, stroke_linecap: "round", stroke_linejoin: "round", stroke_width: "2", d: "M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"), class: "h-4 w-4", xmlns: "http://www.w3.org/2000/svg", fill: "none", viewBox: "0 0 24 24", stroke: "currentColor"),
                        {
                          description: "Впевнені, що хочете видалити твір?",
                          message: "",
                          tag_id: nil,
                          url: fiction_path(fiction, page: params[:page]),
                          button_class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-status-danger-solid transition-colors duration-200 hover:text-status-danger-solid"
                        }
                      ) %>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% else %>
      <div class="rounded-lg border border-line bg-card p-8 text-center shadow-sm relative overflow-hidden">
        <%= render 'shared/jellyfish_ornament' %>

        <div class="mx-auto h-16 w-16 rounded-full bg-brand-subtle flex items-center justify-center mb-4 relative z-10">
          <svg class="h-8 w-8 text-fg-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <h3 class="mb-2 text-lg font-semibold text-fg relative z-10">Твори відсутні</h3>
        <p class="mb-2 text-fg-muted relative z-10">Створіть перший твір та почніть ділитися своєю творчістю з читачами</p>
      </div>
    <% end %>

    <%= ui_pagination(
          pagy,
          frame_id: 'tab-content',
          form_path: studio_index_path(tab: 'writings'),
          turbo_stream: true,
          html: { class: 'p-4' }
        ) %>
  <% else %>
    <%= render 'users/dashboard/no_scanlators_screen' %>
  <% end %>
</div>
