<section class="z-10 relative py-8 antialiased md:py-8">
  <div class="mx-auto max-w-screen-xl px-4 2xl:px-0">
    <div class="space-y-6">
      <!-- Main CTA Card -->
      <div class="rounded-lg border border-line bg-card shadow-sm relative overflow-hidden">
        <!-- SVG Ornament -->
        <%= render 'shared/decorative_ornament' %>

        <div class="p-6 sm:p-8">
          <!-- Header Section -->
          <div class="text-center mb-8">
            <div class="mx-auto h-20 w-20 rounded-full bg-brand-subtle flex items-center justify-center mb-6 relative z-10">
              <svg class="h-10 w-10 text-fg-brand" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 0a10 10 0 1 0 10 10A10.011 10.011 0 0 0 10 0Zm0 5a3 3 0 1 1 0 6 3 3 0 0 1 0-6Zm0 13a8.949 8.949 0 0 1-4.951-1.488A3.987 3.987 0 0 1 9 13h2a3.987 3.987 0 0 1 3.951 3.512A8.949 8.949 0 0 1 10 18Z" />
              </svg>
            </div>
            <h2 class="text-2xl font-semibold text-fg mb-4 sm:text-3xl lg:text-4xl">
              Твори із Бакою: український аніме-хаб
            </h2>
            <p class="text-base text-fg-muted sm:text-lg lg:text-xl max-w-3xl mx-auto">
              Перш ніж завантажити роботу чи переклад, будь ласка, додайте сторінку своєї спільноти, аби встановити зв'язок із сотнями користувачів нашого сервісу.
              <span class="font-semibold text-fg">Бака</span> - це все необхідне, аби розпочати свій шлях автора чи перекладача ранобе.
            </p>
          </div>

          <!-- Features Section -->
          <div class="bg-surface-strong rounded-lg p-6 mb-8">
            <div class="text-center mb-6">
              <h3 class="text-lg font-medium text-fg mb-2">Що ви отримаєте</h3>
              <p class="text-sm text-fg-muted">Простий шлях до створення вашої перекладацької спільноти</p>
            </div>

            <div class="grid gap-4 sm:grid-cols-1 lg:grid-cols-3">
              <div class="flex items-center gap-3 p-4 bg-card rounded-lg border border-line-strong">
                <div class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-emerald-100 text-status-success-solid shrink-0 dark:bg-emerald-900/20">
                  <svg aria-hidden="true" class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                </div>
                <span class="text-sm font-medium text-fg">
                  Створи сторінку своєї команди у кілька кліків
                </span>
              </div>

              <div class="flex items-center gap-3 p-4 bg-card rounded-lg border border-line-strong">
                <div class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-emerald-100 text-status-success-solid shrink-0 dark:bg-emerald-900/20">
                  <svg aria-hidden="true" class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                </div>
                <span class="text-sm font-medium text-fg">
                  Завантаж роботу чи переклад
                </span>
              </div>

              <div class="flex items-center gap-3 p-4 bg-card rounded-lg border border-line-strong">
                <div class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-emerald-100 text-status-success-solid shrink-0 dark:bg-emerald-900/20">
                  <svg aria-hidden="true" class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                </div>
                <span class="text-sm font-medium text-fg">
                  Отримай відгук та підтримку читачів
                </span>
              </div>
            </div>
          </div>

          <!-- Call to Action -->
          <div class="text-center">
            <p class="text-base text-fg-muted mb-6">
              Приєднуйся уже зараз, аби стати частиною нашої аніме-спільноти!
            </p>
            <%= ui_button(as: :link, href: new_scanlator_path, size: :md, html: { data: { turbo: false } }) do %>
              <svg aria-hidden="true" class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
              </svg>
              Додати перекладацьку сторінку
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
