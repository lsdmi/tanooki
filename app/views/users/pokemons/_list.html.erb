<div class="rounded-lg border border-line bg-card shadow-sm">
  <div class="p-6">
    <div class="inline-flex items-center justify-between mb-4">
      <svg class="h-6 md:h-7 lg:h-8 inline-block mx-1 transform transition duration-500 hover:scale-110 text-fg" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.0001 13c0-.8883.4022-2.3826 1-3.27163M18.05 14c0 3.3137-2.6862 6-6 6-3.31366 0-5.99995-2.6863-5.99995-6S8.73634 4 12.05 4c3.3138 0 6 6.6863 6 10Z" />
      </svg>
      <h5 class="text-xl font-bold leading-none text-fg">Мої Покемони</h5>
    </div>
    <div class="grid grid-cols-4 sm:grid-cols-8 gap-4 lg:grid-cols-6 lg:gap-2 2xl:grid-cols-8 2xl:gap-4" data-controller="pokemon-image-click">
      <% pokemons.in_groups_of(8).each do |group| %>
        <% group.each do |user_pokemon| %>
          <% if user_pokemon.present? %>
            <% selected = selected_pokemon.id == user_pokemon.id %>
            <%= button_to pokemon_details_path(pokemon_id: user_pokemon), aria: { pressed: selected }, data: { turbo_stream: "", "turbo-method": :post, pokemon_image_click_target: 'button', action: 'pokemon-image-click#select' }, class: "flex items-center justify-center h-12 w-14 border-2 shadow-md rounded-full #{'border-emerald-600' if selected}" do %>
              <%= image_tag url_for(user_pokemon.pokemon.sprite), alt: user_pokemon.pokemon.name, class: 'w-auto cursor-pointer rounded-lg mb-3 transform transition duration-500 hover:scale-110' %>
            <% end %>
          <% else %>
            <%= tag.div class: "flex items-center justify-center h-12 w-14 border-2 shadow-md rounded-full" do %>
              <%= image_tag 'pokeball.webp', alt: 'pokeball', class: 'h-12 rounded-lg mb-3' %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
  <%= render 'users/pokemons/details', selected_pokemon:, descendant: %>
</div>
