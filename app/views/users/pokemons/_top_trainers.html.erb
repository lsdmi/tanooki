<%# locals: (top:, dex_leaderboard: nil) %>
<% podium, rest = top.partition { |entry| entry.rank <= 3 } %>
<% mine_below = rest.find { |entry| entry.user == current_user } %>
<% outside = dex_leaderboard && top.none? { |entry| entry.user == current_user } %>
<% my_place = dex_leaderboard.top_place_for(current_user) if outside %>
<section id="pokemon-top-trainers" class="group/fold flex min-w-0 flex-col gap-3" data-controller="panel-fold" data-panel-fold-key-value="top"
         style="view-transition-name: pokemon-top; view-transition-class: pokemon-panel">
  <% if top.empty? %>
    <p class="text-sm/5 text-fg-subtle"><%= t('pokemons.top.empty') %></p>
  <% else %>
    <ol class="flex flex-col gap-2">
      <% podium.each do |entry| %>
        <% mine = entry.user == current_user %>
        <%= tag.li class: class_names('flex items-baseline gap-3 text-sm/5', 'text-fg-brand' => mine), aria: { current: mine || nil } do %>
          <span class="w-4 shrink-0 text-right tabular-nums text-fg-subtle"><%= entry.rank %></span>
          <%= link_to entry.user.name, profile_path(entry.user.sqid), turbo_drive_visit_data.merge(class: 'min-w-0 flex-1 truncate font-medium text-fg hover:text-fg-brand') %>
          <span class="shrink-0 text-xs/4 text-fg-muted"><%= dex_title(entry.percentile) %></span>
        <% end %>
      <% end %>
    </ol>

    <% if rest.any? %>
      <%= tag.button type: 'button', title: 'Решта топу', aria: { expanded: false },
                     data: { panel_fold_target: 'toggle button', action: 'panel-fold#toggle' },
                     class: 'self-start text-xs/4 text-fg-subtle underline-offset-4 hover:text-fg hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-line-strong' do %>
        <span data-panel-fold-target="closed">ще <%= rest.size %></span>
        <span data-panel-fold-target="open" hidden>згорнути</span>
      <% end %>
      <%= tag.ol class: 'flex flex-col gap-2', hidden: true, data: Pokemons::PanelComponent.open_target do %>
        <%= render partial: 'users/pokemons/top_trainer_row', collection: rest, as: :entry %>
      <% end %>
    <% end %>

    <% if my_place || mine_below %>
      <%= tag.ol class: 'border-t border-line-muted pt-3', data: (Pokemons::PanelComponent.closed_target if mine_below) do %>
        <%= render 'users/pokemons/top_trainer_row',
                   entry: mine_below || Pokemons::DexLeaderboard::TopEntry.new(user: current_user, rank: my_place, percentile: dex_leaderboard.percentile_for(current_user)) %>
      <% end %>
    <% elsif outside %>
      <p class="text-sm/5 text-fg-subtle"><%= t('pokemons.top.join') %></p>
    <% end %>
  <% end %>
</section>
