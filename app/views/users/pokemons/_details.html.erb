<% pokemon = selected_pokemon.pokemon %>
<% info = { 'Могуть' => stat_tier_label(pokemon, :might), 'Витривалість' => stat_tier_label(pokemon, :stamina),
            'Удар' => stat_tier_label(pokemon, :strike), 'Рідкість' => t("activerecord.enum.rarity.#{pokemon.rarity}") } %>
<% record = { 'Бойовий досвід' => experience_to_sentence(selected_pokemon.battle_experience),
              'Вік' => time_ago_in_words(selected_pokemon.created_at),
              'Норов' => selected_pokemon.character_label } %>
<% open = Pokemons::PanelComponent.open_target %>
<section id="pokemon-details" class="group/fold flex min-w-0 flex-col items-center gap-3 text-center" data-controller="panel-fold"
         data-panel-fold-key-value="details" style="view-transition-name: pokemon-details; view-transition-class: pokemon-panel"
         aria-labelledby="pokemon-details-heading">
  <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2">
    <%= pokemon_sprite_tag(pokemon, loading: :eager, class: 'size-10 object-contain') %>
    <h2 id="pokemon-details-heading" class="text-base/6 font-semibold tracking-tight text-fg">
      <%= selected_pokemon.pokemon_name %>
      <span class="font-normal text-fg-muted">· р. <%= selected_pokemon.current_level %></span>
    </h2>
    <% pokemon.types.each do |type| %><%= pokemon_type_badge(type) %><% end %>
  </div>

  <div class="flex flex-wrap items-center justify-center gap-3">
    <% if training_cooldown?(current_user) %>
      <span class="text-xs/4 text-fg-muted"><%= training_cooldown_reason(current_user) %></span>
    <% else %>
      <%= form_with url: training_pokemon_path(user_pokemon_id: selected_pokemon.id), data: { turbo_stream: true } do %>
        <%= button_tag type: 'submit',
                       class: 'text-sm/5 font-medium text-fg-brand underline-offset-4 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-line-strong' do %>
          Тренувати
        <% end %>
      <% end %>
    <% end %>
    <%= tag.button type: 'button', title: 'Подробиці', aria: { expanded: false, labelledby: 'pokemon-details-heading' },
                   data: { panel_fold_target: 'toggle button', action: 'panel-fold#toggle' },
                   class: 'text-sm/5 text-fg-subtle underline-offset-4 hover:text-fg hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-line-strong' do %>
      <span data-panel-fold-target="closed">ще</span>
      <span data-panel-fold-target="open" hidden>менше</span>
    <% end %>
  </div>

  <%# Folded peek: bare might tier, then value-first stamina/strike (expanded list keeps labels). %>
  <%= tag.p class: 'text-xs/4 text-fg-muted', data: Pokemons::PanelComponent.closed_target do %>
    <%= [
      stat_tier_label(pokemon, :might),
      "#{stat_tier_label(pokemon, :stamina)} витривалість",
      "#{stat_tier_label(pokemon, :strike)} удар"
    ].join(' · ') %>
  <% end %>

  <%= tag.div class: 'flex w-full max-w-md flex-col gap-5 text-left', hidden: true, data: open do %>
    <% if evolution %>
      <% descendant = evolution.to %>
      <div class="flex items-center gap-3">
        <%= pokemon_sprite_tag(descendant, class: 'size-10 object-contain') %>
        <div class="flex min-w-0 flex-1 flex-col gap-1">
          <p class="truncate text-sm/5 text-fg">Еволюція в <%= descendant.name %></p>
          <%= render Ui::MiniProgressBarComponent.new(read: selected_pokemon.current_level, total: evolution.min_level, check: false,
                                                     html: { aria: { label: "Рівень до еволюції в #{descendant.name}" } }) %>
          <p class="text-xs/4 text-fg-muted"><%= selected_pokemon.current_level %> з <%= evolution.min_level %></p>
        </div>
      </div>
    <% end %>

    <%# One column so label + value stay on a single line (two cols were too narrow). %>
    <div class="flex flex-col gap-4">
      <% { 'Відомості' => info, 'Облік' => record }.each do |heading, rows| %>
        <div class="flex flex-col gap-1">
          <%= tag.h3 heading, class: 'text-xs/4 text-fg-subtle' %>
          <dl class="flex flex-col">
            <% rows.each do |label, value| %>
              <div class="flex items-baseline justify-between gap-4 whitespace-nowrap py-1">
                <%= tag.dt label, class: 'shrink-0 text-sm/5 text-fg-muted' %>
                <%= tag.dd value, class: 'text-right text-sm/5 text-fg' %>
              </div>
            <% end %>
          </dl>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
