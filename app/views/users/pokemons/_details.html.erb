<% pokemon = selected_pokemon.pokemon %>
<% info = { 'Могуть' => stat_tier_label(pokemon, :might), 'Витривалість' => stat_tier_label(pokemon, :stamina),
            'Удар' => stat_tier_label(pokemon, :strike), 'Рідкість' => t("activerecord.enum.rarity.#{pokemon.rarity}") } %>
<% record = { 'Бойовий досвід' => experience_to_sentence(selected_pokemon.battle_experience),
              'Вік' => time_ago_in_words(selected_pokemon.created_at),
              'Норов' => selected_pokemon.character_label } %>
<%= render Pokemons::PanelComponent.new(title: "##{pokemon.dex_id} #{selected_pokemon.pokemon_name}", id: 'pokemon-details') do |panel| %>
  <% panel.with_action do %>
    <% if training_cooldown?(current_user) %>
      <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-surface px-2.5 py-1 text-xs/4 font-medium text-fg-muted ring-1 ring-inset ring-line">
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
        <%= "Тренування через #{training_cooldown_reason(current_user)}" %>
      </span>
    <% else %>
      <%= form_with url: training_pokemon_path(user_pokemon_id: selected_pokemon.id), data: { turbo_stream: true }, class: 'shrink-0' do %>
        <%= render Ui::ButtonComponent.new(as: :submit, variant: :outline, size: :sm, label: 'Тренувати') do %>
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.596 12.768a2 2 0 1 0 2.829-2.829l-1.768-1.767a2 2 0 0 0 2.828-2.829l-2.828-2.828a2 2 0 0 0-2.829 2.828l-1.767-1.768a2 2 0 1 0-2.829 2.829z" /><path d="m2.5 21.5 1.4-1.4" /><path d="m20.1 3.9 1.4-1.4" /><path d="M5.343 21.485a2 2 0 1 0 2.829-2.828l1.767 1.768a2 2 0 1 0 2.829-2.829l-6.364-6.364a2 2 0 1 0-2.829 2.829l1.768 1.767a2 2 0 0 0-2.828 2.829z" /><path d="m9.6 14.4 4.8-4.8" /></svg>
          Тренувати
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <div class="grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-3">
    <div class="flex flex-col gap-4 sm:col-span-2 lg:col-span-1">
      <div class="flex items-center gap-4">
        <div class="flex size-20 shrink-0 items-center justify-center rounded-xl bg-surface ring-1 ring-inset ring-line">
          <%= pokemon_sprite_tag(pokemon, loading: :eager, class: 'size-18 object-contain') %>
        </div>
        <div class="flex min-w-0 flex-col gap-2">
          <div class="flex flex-wrap gap-1.5">
            <% pokemon.types.each do |type| %><%= pokemon_type_badge(type) %><% end %>
          </div>
          <p class="text-sm/5 text-fg-muted">Рівень <span class="font-semibold text-fg"><%= selected_pokemon.current_level %></span></p>
        </div>
      </div>

      <% if evolution %>
        <% descendant = evolution.to %>
        <% target = evolution.min_level %>
        <div class="flex flex-col gap-1">
          <h3 class="text-xs/4 font-semibold uppercase tracking-wide text-fg-muted">Еволюція</h3>
          <div class="flex items-center gap-3 rounded-lg bg-surface p-3 ring-1 ring-inset ring-line">
            <div class="flex size-14 shrink-0 items-center justify-center rounded-lg bg-main ring-1 ring-inset ring-line">
              <%= pokemon_sprite_tag(descendant, class: 'size-12 object-contain') %>
            </div>
            <div class="flex min-w-0 flex-1 flex-col gap-1.5">
              <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
                <%= tag.span descendant.name, class: 'truncate text-sm/5 font-semibold text-fg' %>
                <%= tag.span "Рівень #{selected_pokemon.current_level} з #{target}", class: 'text-xs/4 text-fg-muted' %>
              </div>
              <%= render Ui::MiniProgressBarComponent.new(read: selected_pokemon.current_level, total: target, check: false,
                                                         html: { aria: { label: "Рівень до еволюції в #{descendant.name}" } }) %>
              <div class="flex flex-wrap gap-1.5">
                <% descendant.types.each do |type| %><%= pokemon_type_badge(type) %><% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <% { 'Відомості' => info, 'Облік' => record }.each do |heading, rows| %>
      <div class="flex flex-col gap-1">
        <%= tag.h3 heading, class: 'text-xs/4 font-semibold uppercase tracking-wide text-fg-muted' %>
        <dl class="flex flex-col divide-y divide-line-muted">
          <% rows.each do |label, value| %>
            <div class="flex items-baseline justify-between gap-4 py-2">
              <%= tag.dt label, class: 'text-sm/5 text-fg-muted' %>
              <%= tag.dd value, class: 'text-right text-sm/5 font-medium text-fg' %>
            </div>
          <% end %>
        </dl>
      </div>
    <% end %>
  </div>
<% end %>
