<%# Pokédex opens in the strip; the frame src is set only on the first open. %>
<details class="pokemon-dex-panel group min-w-0"
         data-controller="lazy-frame-details"
         data-lazy-frame-details-src-value="<%= pokemon_dex_path %>"
         data-exclusive-details-target="panel"
         data-action="toggle->exclusive-details#sync toggle->lazy-frame-details#toggle">
  <summary class="inline-flex h-5 cursor-pointer list-none items-center gap-1 text-fg-subtle underline-offset-4 hover:text-fg hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-line-strong [&::-webkit-details-marker]:hidden"
           title="<%= t('pokemons.dex.title') %>">
    <%= pokemon_dex_icon %>
    <span class="sr-only"><%= t('pokemons.dex.title') %></span>
  </summary>
  <%= turbo_frame_tag 'pokemon-dex',
                      class: 'mt-1.5 block w-full',
                      data: { lazy_frame_details_target: 'frame' } do %>
    <p class="text-xs/4 text-fg-subtle"><%= t('pokemons.dex.loading') %></p>
  <% end %>
</details>
