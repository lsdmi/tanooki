<% attacker_won = battle.attacker == battle.winner %>
<div class="flex flex-col gap-3">
  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm/5">
    <%= link_to pokemon_battle_path(battle),
                turbo_drive_visit_data.merge(
                  class: 'inline-flex shrink-0 text-fg-subtle hover:text-fg focus:outline-none focus-visible:ring-2 focus-visible:ring-line-strong',
                  title: t('pokemons.battle.share_link'),
                  aria: { label: t('pokemons.battle.share_link') }
                ) do %>
      <%= battle_share_icon('size-3.5') %>
    <% end %>
    <%= link_to battle.attacker.name, profile_path(battle.attacker.sqid), turbo_drive_visit_data.merge(class: 'font-medium text-fg hover:text-fg-brand') %>
    <%= battle_result_badge(attacker_won) %>
    <span class="text-fg-subtle" aria-hidden="true">·</span>
    <%= link_to battle.defender.name, profile_path(battle.defender.sqid), turbo_drive_visit_data.merge(class: 'font-medium text-fg hover:text-fg-brand') %>
    <%= battle_result_badge(!attacker_won) %>
    <%= tag.button type: 'button', title: 'Раунди', aria: { expanded: false },
                   data: { panel_fold_target: 'toggle button', action: 'panel-fold#toggle' },
                   class: 'ml-auto text-xs/4 text-fg-subtle underline-offset-4 hover:text-fg hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-line-strong' do %>
      <span data-panel-fold-target="closed">раунди</span>
      <span data-panel-fold-target="open" hidden>згорнути</span>
    <% end %>
  </div>
  <% unless battle.ranked? %>
    <p class="text-xs/4 text-fg-muted"><%= t('pokemons.battle.unranked') %></p>
  <% end %>

  <%= tag.div hidden: true, data: Pokemons::PanelComponent.open_target do %>
    <%= render Pokemons::BattleReplayComponent.new(battle:) %>
  <% end %>
</div>
