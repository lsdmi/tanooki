<section class="group/fold flex min-w-0 flex-col gap-2" data-controller="panel-fold" data-panel-fold-key-value="history"
         style="view-transition-name: pokemon-history; view-transition-class: pokemon-panel">
  <%= turbo_frame_tag "pokemon-history-list" do %>
    <%= render 'users/pokemons/history_record', battle: battle_history if battle_history.present? %>
  <% end %>
  <% if battle_history.blank? %>
    <%= turbo_frame_tag "pokemon-history-call" do %>
      <p class="text-sm/5 text-fg-subtle">Ще не билися — результат з’явиться тут.</p>
    <% end %>
  <% end %>
</section>
