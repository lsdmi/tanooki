<%# locals: (entry:) %>
<% mine = entry.user == current_user %>
<%= tag.li class: class_names('flex items-baseline gap-3 text-sm/5', 'text-fg-brand' => mine), aria: { current: mine || nil } do %>
  <span class="w-4 shrink-0 text-right tabular-nums text-fg-subtle"><span class="sr-only">Місце</span><%= entry.rank %></span>
  <%= link_to entry.user.name, profile_path(entry.user.sqid), turbo_drive_visit_data.merge(class: 'min-w-0 flex-1 truncate font-medium text-fg hover:text-fg-brand') %>
  <span class="shrink-0 text-xs/4 text-fg-muted"><%= dex_title(entry.percentile) %></span>
<% end %>
