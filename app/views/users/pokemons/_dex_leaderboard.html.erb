<%= render Pokemons::PanelComponent.new(title: 'Мій виклик') do |panel| %>
  <% if can_reroll && opponent %>
    <% panel.with_action do %>
      <%= form_with url: regenerate_pokemon_opponent_path, data: { turbo_stream: true }, class: 'shrink-0' do %>
        <%= render Ui::ButtonComponent.new(as: :submit, variant: :ghost, size: :sm, icon_only: true, label: 'Обрати іншого суперника', html: { title: 'Обрати іншого суперника' }) do %>
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" /><path d="M21 3v5h-5" /><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" /><path d="M8 16H3v5" /></svg>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if dex_leaderboard.nil? %>
    <%= render 'users/pokemons/empty', message: t('pokemons.opponent.no_party') %>
  <% elsif cooldown %>
    <%= render 'users/pokemons/cooldown', dex_leaderboard: %>
  <% elsif opponent %>
    <%= render 'users/pokemons/leaderboard_record', dex_leaderboard:, opponent: %>
  <% else %>
    <%= render 'users/pokemons/empty', message: t('pokemons.opponent.empty') %>
  <% end %>
<% end %>
