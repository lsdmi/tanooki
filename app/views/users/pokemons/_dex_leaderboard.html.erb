<%# locals: (dex_leaderboard:, opponent:, cooldown:, can_reroll:, has_party: true) %>
<section class="relative flex flex-col items-center justify-center gap-4 py-2"
         aria-label="Арена" style="view-transition-name: pokemon-arena">
  <% if can_reroll && opponent %>
    <div class="absolute top-0 right-0">
      <%= form_with url: regenerate_pokemon_opponent_path, data: { turbo_stream: true } do %>
        <%= button_tag type: 'submit', title: 'Обрати іншого суперника',
                       class: 'text-xs/4 text-fg-subtle underline-offset-4 hover:text-fg hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-line-strong' do %>
          Інший
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if !has_party %>
    <%= render 'users/pokemons/empty', message: t('pokemons.opponent.no_party') %>
  <% elsif cooldown %>
    <%= render 'users/pokemons/cooldown', dex_leaderboard: %>
  <% elsif opponent %>
    <%= render 'users/pokemons/leaderboard_record', dex_leaderboard:, opponent: %>
  <% else %>
    <%= render 'users/pokemons/empty', message: t('pokemons.opponent.empty') %>
  <% end %>
</section>
