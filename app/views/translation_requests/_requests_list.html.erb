<div class="flex items-center justify-between mb-6" data-translation-requests-page-page="<%= pagy.page %>">
  <div class="flex items-center">
    <div class="h-6 w-6 rounded-lg bg-brand-subtle flex items-center justify-center mr-2">
      <svg class="h-3 w-3 text-fg-brand-hover" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
      </svg>
    </div>
    <h3 class="text-lg font-extrabold text-fg">Всі Запити</h3>
  </div>
  <span class="text-sm font-bold text-fg bg-surface-strong px-3 py-1 rounded-full"><%= total_requests_count %></span>
</div>

<div class="space-y-3">
  <% if translation_requests.any? %>
    <% translation_requests.each do |request| %>
      <%= render 'translation_requests/request_card',
                 request: request,
                 compact: true,
                 wrapper_class: 'bg-surface/50 dark:bg-surface-strong/30 border border-line-strong rounded-lg p-6 hover:border-brand/50 transition-all duration-300' %>
    <% end %>
  <% else %>
    <div class="text-center py-12">
      <div class="h-16 w-16 rounded-full bg-surface-strong flex items-center justify-center mx-auto mb-6">
        <svg class="h-8 w-8 text-fg-subtle" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
      </div>
      <p class="text-fg-muted text-lg">
        Поки що немає активних запитів на переклад.<br>
        Станьте першим, хто додасть запит!
      </p>
    </div>
  <% end %>
</div>

<%= ui_pagination(
      pagy,
      frame_id: 'requests-container',
      turbo_stream: true,
      form_path: translation_requests_path,
      html: { class: 'mt-6' }
    ) %>
