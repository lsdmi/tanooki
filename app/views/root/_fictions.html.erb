<%# locals: (fictions:, ranked: false) %>
<%# Card widths show a sliver of the next item so horizontal scroll is obvious. %>
<%# Below lg the row is fluid (~2.5 / 3.2 cards). At lg the cover is the 256×384 (2:3) mock size. %>
<%# Break out of the page gutter on the right so the trailing card bleeds off the screen edge. %>
<div
  class="flex snap-x snap-mandatory gap-3 overflow-x-auto overscroll-x-contain [-webkit-overflow-scrolling:touch] md:gap-4 lg:snap-proximity -mr-4 md:-mr-6 lg:mr-0"
  role="region"
  aria-label="Популярне ранобе">
  <% fictions.each_with_index do |fiction, index| %>
    <% card = popular_fiction_card_stats(fiction) %>
    <article class="group w-[calc((100%-24px)/2.5)] shrink-0 snap-start sm:w-[calc((100%-12px)/2.15)] md:w-[calc((100%-48px)/3.2)] lg:w-[256px]">
      <%# group/cover, not the article group: hovering the genre pills or the padding below should not light up the card. %>
      <%= link_to fiction_path(fiction), turbo_drive_visit_data.merge(class: 'group/cover relative block aspect-[2/3] overflow-hidden rounded-xl bg-stone-200 transition-[filter,transform] duration-300 ease-out focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-violet-500 hover:brightness-105 dark:bg-slate-800 dark:focus-visible:ring-violet-400') do %>
        <% if ranked %>
          <%= render Ui::GenrePageTagComponent.new(variant: :rank, label: index + 1, rank_size: :strip) %>
        <% end %>
        <%= cover_card_picture_tag(fiction.cover,
                      alt: fiction.title,
                      class: 'absolute inset-0 h-full w-full object-cover object-center transition-transform duration-300 ease-out group-hover/cover:scale-[1.03]',
                      loading: 'lazy' ) %>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 flex items-end justify-between gap-3 bg-gradient-to-t from-black/80 via-black/40 to-transparent px-2 pb-2 pt-10 md:px-3 md:pb-3">
          <%= render Ui::GenrePageTagComponent.new(variant: :stat_views, label: card[:views]) %>
          <%= render Ui::GenrePageTagComponent.new(variant: :stat_rating, label: card[:rating]) %>
        </div>
      <% end %>
      <div class="pb-2 pt-3">
        <p class="text-sm font-semibold leading-tight text-stone-900 dark:text-slate-100 lg:text-base">
          <%= link_to fiction.title,
                      fiction_path(fiction),
                      turbo_drive_visit_data.merge(class: 'line-clamp-1 rounded-lg transition-colors hover:text-cyan-700 hover:underline underline-offset-2 dark:hover:text-rose-400 group-hover/cover:text-cyan-700 dark:group-hover/cover:text-rose-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-offset-gray-900') %>
        </p>
        <% if card[:genres].present? %>
          <% genre_slugs = card[:genres].to_h { |genre| [genre[:name], genre[:slug]] } %>
          <%= render Ui::TagListComponent.new(
                labels: genre_slugs.keys,
                variant: :genre,
                size: :sm,
                max: 2,
                compact_max: 1,
                sort_adult_first: true,
                genre_slugs:,
                href_builder: ->(name) { fiction_genre_fictions_path(genre_slugs.fetch(name)) },
                tag_html: turbo_drive_visit_data,
                html: { class: 'mt-1.5 gap-1 nowrap' }
              ) %>
        <% end %>
      </div>
    </article>
  <% end %>
</div>
