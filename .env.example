# Non-secret infra defaults: config/platform_config.rb and config/initializers/adsense.rb
# Public AdSense IDs: config/initializers/adsense.rb

# --- Secrets (required in production / App Platform) ---
DB_HOST=""
DB_NAME=""
DB_PASSWORD="somepassword"
DB_PORT=""
DB_USER=""

# DO Managed OpenSearch — URL + password + CA cert (cluster-specific secrets).
# Local dev: add your IPv4 to cluster Trusted sources; set OPENSEARCH_URL to enable search.
# After first setup: rails runner "Searchkick.callbacks(:inline) { Fiction.reindex; Publication.reindex; YoutubeVideo.reindex }"
OPENSEARCH_URL="https://HOST:25060"
OPENSEARCH_PASSWORD=""
OPENSEARCH_CA_CERT=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Analytics Data API (local reporting only; not needed in production).
# bin/analytics-report
GOOGLE_ANALYTICS_PROPERTY_ID="357980018"
GOOGLE_APPLICATION_CREDENTIALS="config/google-analytics-credentials.json"

# Google Search Console API (same service-account JSON as GA; local only).
# Enable API: https://console.cloud.google.com/apis/library/searchconsole.googleapis.com
# GSC → Settings → Users → add the service-account email (Full).
# Site URL must match GSC exactly (URL-prefix or sc-domain:baka.in.ua).
# bin/search-console
GOOGLE_SEARCH_CONSOLE_SITE_URL="sc-domain:baka.in.ua"

MAILER_PASSWORD=""
OPENAI_API_KEY=""
SECRET_KEY_BASE=""

# Spaces/S3 — access keys only; bucket/region/endpoint in config/platform_config.rb
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

TELEGRAM_KEY=""
YOUTUBE_API_KEY=""

# PageSpeed Insights API (hosted Lighthouse lab + CrUX). Local-only; not needed on App Platform.
# Google Cloud → enable PageSpeed Insights API → API key restricted to that API.
# bin/pagespeed /fictions
PAGESPEED_API_KEY=""
